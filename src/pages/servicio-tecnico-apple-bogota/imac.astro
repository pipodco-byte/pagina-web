---
import Layout from '../../layouts/Layout.astro';
import ServicePageSchema from '../../components/SEO/ServicePageSchema.astro';
import FAQPageSchema from '../../components/SEO/FAQPageSchema.astro';
import PipodFAQ from '../../components/service/PipodFAQ.astro';
import PipodServicesBanner from '../../components/service/pipodServicesBanner.astro';
import PipodStats from '../../components/stats/pipodStats.astro';
import FloatingContact from '../../layouts/floatingContact';
import Footer from '../../components/pipodFooter';
import BlogSection from '../../components/reviews/blogSection';

// SEO Metas
const title = "Servicio Técnico iMac Bogotá | Pipod - Especialistas Certificados";
const description = "Reparación iMac en Chapinero, Bogotá. Mantenimiento, pantalla, disco, placa. Diagnóstico gratis, garantía 12 meses. 16 años de experiencia.";

// Schema
const schemaService = {
  name: "Servicio Técnico iMac Bogotá",
  description: "Reparación especializada iMac en Chapinero, Bogotá. Mantenimiento preventivo, pantalla, disco, memoria, placa.",
  url: "https://www.pipod.co/servicio-tecnico-apple-bogota/imac",
  areaServed: "Bogotá, Chapinero"
};

// Servicios Core
const coreServices = [
  {
    title: "MANTENIMIENTO PREVENTIVO",
    tag: "Top Prioridad",
    price: "$350.000 - $650.000",
    icon: "bi-tools",
    specs: ["3-6h según modelo", "12m garantía", "Incluye diagnóstico gratis"],
    link: "https://wa.me/573124813094?text=Hola%20Pipod%2C%20quiero%20cotizar%20mantenimiento%20de%20mi%20iMac",
    linkText: "Cotizar servicio"
  },
  {
    title: "PANTALLA / DISPLAY",
    tag: "Alta Demanda",
    price: "Consultar",
    icon: "bi-display",
    specs: ["3-5h según modelo", "12m garantía", "Incluye diagnóstico gratis"],
    link: "https://wa.me/573124813094?text=Hola%20Pipod%2C%20quiero%20cotizar%20el%20cambio%20de%20pantalla%20de%20mi%20iMac",
    linkText: "Cotizar servicio"
  }
];

// Servicios principales
const mainServices = [
  { title: "Mantenimiento", icon: "bi-tools", desc: "Limpieza, pasta térmica, optimización", price: "$350.000 - $650.000", link: "/blog/mantenimiento-imac-bogota" },
  { title: "Pantalla", icon: "bi-display", desc: "Reemplazo display completo", price: "Consultar", link: "/blog/mantenimiento-imac-bogota" },
  { title: "Disco / SSD", icon: "bi-hdd-stack", desc: "Upgrade, reemplazo, recuperación", price: "Consultar", link: "/blog/mantenimiento-imac-bogota" },
  { title: "Memoria / RAM", icon: "bi-memory", desc: "Ampliación de memoria", price: "Consultar", link: "/blog/mantenimiento-imac-bogota" },
  { title: "No Enciende", icon: "bi-power", desc: "Diagnóstico fuentes, placa", price: "Desde $80.000", link: "/blog/mantenimiento-imac-bogota" },
  { title: "Software / macOS", icon: "bi-gear", desc: "Instalación, recuperación, optimización", price: "Desde $70.000", link: "/blog/mantenimiento-imac-bogota" },
  { title: "Placa / Microsoldadura", icon: "bi-cpu", desc: "Reparación de componentes SMD", price: "Desde $200.000", link: "/blog/mantenimiento-imac-bogota" },
  { title: "Fuente de Poder", icon: "bi-lightning-charge", desc: "Reemplazo fuente interna", price: "Consultar", link: "/blog/mantenimiento-imac-bogota" },
  { title: "FaceTime Camera", icon: "bi-camera", desc: "Cámara frontal integrada", price: "Consultar", link: "/blog/mantenimiento-imac-bogota" },
  { title: "Optimización", icon: "bi-speedometer", desc: "Limpieza sistema, aceleración", price: "Desde $90.000", link: "/blog/mantenimiento-imac-bogota" }
];

// FAQs
const faqs = [
  { q: "¿Cuánto cuesta el mantenimiento de un iMac?", a: "Desde $350.000 para iMac 21.5 hasta $650.000 para iMac Pro. El precio depende del modelo exacto. Incluye limpieza completa, cambio de pasta térmica y diagnóstico." },
  { q: "¿Cada cuánto tiempo debo hacer mantenimiento al iMac?", a: "Uso normal: cada 24-36 meses. Uso profesional: cada 18-24 meses. Uso intensivo (diseño, video): cada 12-18 meses. El mantenimiento previene problemas de sobrecalentamiento." },
  { q: "¿Mis datos están seguros durante el mantenimiento?", a: "Sí. El mantenimiento es físico y no toca archivos. Siempre recomendamos hacer backup antes, pero no es obligatorio. Tu información es confidencial." },
  { q: "¿Vale la pena reparar un iMac de 5+ años?", a: "Depende del modelo y estado. Los iMac con SSD suelen durar más. Con mantenimiento adecuado pueden funcionar 8-10 años. Consulta con nosotros para evaluar tu caso específico." },
  { q: "¿Qué incluye el mantenimiento preventivo del iMac?", a: "Limpieza interna de ventiladores y disipador, cambio de pasta térmica en CPU y GPU, limpieza de pantalla con productos especializados, optimización de software macOS, diagnóstico de componentes." },
  { q: "¿Hacemos servicio a domicilio para iMac?", a: "Sí, para equipos de escritorio podemos hacer servicio a domicilio con un costo adicional de $80.000-$150.000 según la zona. Consulta disponibilidad." }
];

// Blog links internos
const blogLinks = [
  { 
    title: "Mantenimiento iMac Bogotá", 
    slug: "mantenimiento-imac-bogota",
    excerpt: "Limpieza interna, cambio de pasta térmica, optimización. Diagnóstico gratis, 12 meses de garantía.",
    category: "IMAC"
  }
];

// Blog posts for BlogSection component
const blogPosts = blogLinks.map(link => ({
  title: link.title,
  excerpt: link.excerpt,
  category: link.category,
  link: `/blog/${link.slug}`
}));

// Cross-device links
const otherDevices = [
  { name: "MacBook", href: "/servicio-tecnico-apple-bogota/macbook" },
  { name: "iPhone", href: "/servicio-tecnico-apple-bogota/iphone" },
  { name: "iPad", href: "/servicio-tecnico-apple-bogota/ipad" },
  { name: "Apple Watch", href: "/servicio-tecnico-apple-bogota/apple-watch" }
];
---

<Layout title={title}>
  <ServicePageSchema serviceData={schemaService} />
  <FAQPageSchema faqData={faqs} />
  
  <main style="padding-top: 120px;">
    
    <!-- HERO -->
    <section class="hero-iphone">
      <div class="hero-bg">
        <img 
          src="/images/servicio-tecnico-apple-pipod.webp" 
          alt="Servicio Técnico iMac Bogotá - Pipod"
          width="1920" height="1080"
          loading="eager"
        />
        <div class="hero-overlay"></div>
      </div>
      
      <div class="hero-content">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span>›</span>
          <a href="/servicio-tecnico-apple-bogota">Reparación</a>
          <span>›</span>
          <span>iMac</span>
        </nav>
        
        <h1 class="hero-title">
          Servicio técnico iMac<br/>
          <span>Chapinero, Bogotá</span>
        </h1>
        
        <div class="trust-line">
          16 años · 3,600+ equipos · Garantía 12 meses
        </div>
        
        <p class="hero-subtitle">
          Reparación iMac Express. Diagnóstico gratis. Respuesta en minutos.
        </p>
        
        <div class="hero-actions">
          <a href="https://wa.me/573124813094?text=Hola%20Pipod%2C%20tengo%20un%20iMac%20que%20necesita%20reparación" class="btn-primary-hero">
            <i class="bi bi-whatsapp"></i>
            Escribir por WhatsApp
          </a>
          <a href="#servicios" class="btn-secondary-hero">
            Ver servicios ↓
          </a>
        </div>
      </div>
    </section>

    <!-- TRUST BADGES -->
    <PipodServicesBanner />

    <!-- SERVICIOS PRINCIPALES -->
    <section id="servicios" class="section-core-services">
      <div class="container">
        <h2 class="section-title">Top Reparaciones iMac</h2>
        
        <div class="core-grid">
          {coreServices.map((service, index) => (
            <div class={`core-card ${index === 0 ? 'accent-blue' : 'accent-black'}`}>
              <div class="core-card-image">
                <img src="/images/imagenservicios.jpg" alt={service.title} />
              </div>
              <div class="core-card-content">
                <div class="core-card-header">
                  <span class="core-tag">{service.tag}</span>
                  <i class={`bi ${service.icon} core-icon`}></i>
                </div>
                <h3 class="core-title">{service.title}</h3>
                <p class="core-price">{service.price}</p>
                
                <div class="core-specs">
                  <span class="spec-text"><i class="bi bi-lightning-charge"></i> {service.specs[0]}</span>
                  <span class="spec-text"><i class="bi bi-shield-check"></i> {service.specs[1]}</span>
                  <span class="spec-text"><i class="bi bi-check-circle"></i> {service.specs[2]}</span>
                </div>

                <div class="availability-row">
                  <i class="bi bi-box"></i>
                  <span>Disponibilidad hoy</span>
                </div>
                
                <div class="button-wrapper">
                  <a href={service.link} class="btn-pipod-outline">{service.linkText}</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STATS -->
    <PipodStats />

    <!-- SERVICIOS PRINCIPALES -->
    <section id="servicios-main" class="section-services">
      <div class="container">
        <h2 class="section-title">Servicio Técnico iMac</h2>
        
        <div class="services-grid">
          {mainServices.map((service) => (
            <a href={service.link} class="service-card">
              <i class={`bi ${service.icon} service-icon`}></i>
              <div class="service-info">
                <h5 class="service-title">{service.title}</h5>
                <p class="service-desc">{service.desc}</p>
                <span class="service-price">{service.price}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-cta">
      <div class="container">
        <h2 class="cta-title">¿Tu iMac necesita reparación?</h2>
        <p class="cta-subtitle">
          3,600+ reparados · Garantía 12 meses · 16 años Chapinero<br/>
          Diagnóstico gratis · Respuesta en minutos
        </p>
        <a href="https://wa.me/573124813094?text=Hola%20Pipod%2C%20tengo%20un%20iMac%20que%20necesita%20reparación" class="btn-cta">
          <i class="bi bi-whatsapp"></i>
          Contactar por WhatsApp
        </a>
      </div>
    </section>

    <!-- CROSS-SELLING -->
    <section class="section-cross">
      <div class="container">
        <div class="cross-content">
          <span class="cross-icon"><i class="bi bi-gift"></i></span>
          <div class="cross-text">
            <strong>Combo: Teclado + Mouse Apple</strong> para tu iMac recién reparado
          </div>
          <span class="cross-price">Consultar</span>
          <a href="/contacto-pipod#ubicacion" class="btn-cross">
            Recoge en tienda
          </a>
        </div>
      </div>
    </section>

    <!-- FAQs -->
    <PipodFAQ faqs={faqs} />

    <!-- BLOG SECTION -->
    <BlogSection title="Artículos iMac" client:load posts={blogPosts} />

    <!-- TAMBIEN REPARAMOS - CARD GRID (white cards with accents) -->
    <section class="section-also">
      <div class="container">
        <h2 class="also-title">También reparamos</h2>
        <div class="also-grid">
          <!-- Card 1: MacBook (featured) -->
          <div class="also-card macbook-also">
            <div class="card-content">
              <div class="top-content">
                <div class="header-row">
                  <i class="bi bi-laptop header-icon-macbook"></i>
                  <span class="badge-pill-solid">ESPECIALIDAD</span>
                </div>
                <h3 class="highlight-title">MacBook</h3>
                <p class="legibilidad-max">Reparación: Batería, pantalla, teclado y microsoldadura.</p>
              </div>
              <div class="button-wrapper">
                <a href="/servicio-tecnico-apple-bogota/macbook" class="btn-pipod-outline">Ver servicios</a>
              </div>
            </div>
          </div>
          <!-- Card 2: MacBook -->
          <div class="also-card macbook-also">
            <div class="card-content">
              <div class="top-content">
                <div class="header-small">
                  <i class="bi bi-laptop"></i>
                  <h4>MacBook</h4>
                </div>
                <p class="legibilidad-max">Batería, pantalla, teclado y microsoldadura.</p>
              </div>
              <div class="button-wrapper">
                <a href="/servicio-tecnico-apple-bogota/macbook" class="btn-pipod-outline">Ver servicios</a>
              </div>
            </div>
          </div>
          <!-- Card 3: Apple Watch -->
          <div class="also-card watch-also">
            <div class="card-content">
              <div class="top-content">
                <div class="header-small">
                  <i class="bi bi-watch"></i>
                  <h4>Apple Watch</h4>
                </div>
                <p class="desc-small">Cambio de cristal, batería y restauración.</p>
              </div>
              <div class="bottom-content">
                <a href="/servicio-tecnico-apple-bogota/apple-watch" class="btn-small">Ver servicios</a>
              </div>
            </div>
          </div>
          <!-- Card 4: Mantenimiento -->
          <div class="also-card mantenimiento-also">
            <div class="card-content">
              <div class="top-content">
                <div class="header-small">
                  <i class="bi bi-tools"></i>
                  <h4>Mantenimiento</h4>
                </div>
                <p class="desc-small">Limpieza interna, pasta térmica y optimización.</p>
              </div>
              <div class="bottom-content">
                <a href="/servicio-tecnico-apple-bogota/mantenimiento" class="btn-small">Ver servicios</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <FloatingContact client:load />
    <Footer client:load />
  </main>
</Layout>

<style>
  /* HERO */
  .hero-iphone {
    position: relative;
    height: 80vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.3) 0%,
      transparent 20%,
      transparent 40%,
      rgba(0,0,0,0.7) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 80px;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.7);
    margin-bottom: 20px;
  }

  .breadcrumb-nav a {
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb-nav a:hover {
    color: #fff;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: #fff;
    line-height: 1;
    margin: 0 0 20px 0;
    text-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }

  .hero-title span {
    color: #4A90E2;
  }

  .trust-line {
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(12px);
    border: 0.85px solid rgba(255,255,255,0.2);
    border-radius: 50px;
    padding: 10px 20px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    display: inline-block;
    margin-bottom: 20px;
    letter-spacing: 0.5px;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: rgba(255,255,255,0.9);
    margin: 0 0 30px 0;
    max-width: 500px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-primary-hero {
    background: #4A90E2;
    color: #fff;
    padding: 16px 32px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease;
  }

  .btn-primary-hero:hover {
    background: #357ABD;
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(74,144,226,0.3);
  }

  .btn-secondary-hero {
    background: rgba(255,255,255,0.1);
    color: #fff;
    padding: 16px 32px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border: 0.85px solid rgba(255,255,255,0.3);
    transition: all 0.3s ease;
  }

  .btn-secondary-hero:hover {
    background: rgba(255,255,255,0.2);
    transform: translateY(-3px);
  }

  /* SECTION COMMON */
  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 80px;
  }

  .section-title {
    font-family: 'Inter', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: #000;
    margin: 0 0 40px 0;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  /* SERVICIOS CORE */
  .section-core-services {
    padding: 80px 0;
    background: #fff;
  }

  .core-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .core-card {
    background-color: #fff;
    border-radius: 40px;
    border: 1px solid #E8E8E8;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .core-card:hover {
    border-color: #3A506B;
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 12px 24px rgba(0,0,0,0.1);
  }

  .core-card-image {
    height: 180px;
    background-color: #000;
    overflow: hidden;
    border-radius: 40px 40px 0 0;
  }

  .core-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transition: transform 0.6s ease;
    border-radius: 40px 40px 0 0;
  }

  .core-card:hover .core-card-image img {
    transform: scale(1.05);
  }

  .core-card-content {
    padding: 24px;
  }

  .core-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .core-tag {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 6px 12px;
    border-radius: 50px;
    background: #0066CC;
    color: #fff;
  }

  .accent-blue .core-tag {
    background: linear-gradient(90deg, #3A506B, #0066CC);
  }

  .accent-black .core-tag {
    background: linear-gradient(90deg, #3A506B, #000);
  }

  .core-icon {
    font-size: 2rem;
    color: #1d1d1f;
  }

  .core-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: #000;
    margin: 0 0 6px 0;
    text-transform: uppercase;
  }

  .core-price {
    font-size: 1rem;
    font-weight: 700;
    color: #000;
    margin: 0 0 12px 0;
  }

  .core-specs {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 10px;
  }

  .spec-text {
    font-size: 0.85rem;
    color: #1F1F1F;
    font-family: 'Inter', sans-serif;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .spec-text i {
    font-size: 0.9rem;
  }

  .accent-blue .spec-text i {
    color: #0066CC;
  }

  .accent-black .spec-text i {
    color: #1F1F1F;
  }

  .availability-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: #1F1F1F;
    margin-bottom: 12px;
  }

  .availability-row i {
    color: #3A506B;
  }

.button-wrapper {
    display: flex;
    justify-content: flex-end;
  }

  .accent-blue .btn-pipod-outline {
    background: #4A90E2;
    border-color: #4A90E2;
    color: #fff;
  }

  .accent-blue .btn-pipod-outline:hover {
    background: #357ABD;
    border-color: #357ABD;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(74,144,226,0.25);
  }

  .accent-black .btn-pipod-outline {
    background: #000;
    border-color: #000;
    color: #fff;
  }

  .accent-black .btn-pipod-outline:hover {
    background: #1F1F1F;
    border-color: #1F1F1F;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
  }

  /* SERVICIOS PRINCIPALES */
  .section-services {
    padding: 80px 0;
    background: #fff;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }

  .service-card {
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    border: 1px solid #E5E5E7;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.1);
  }

  .service-icon {
    font-size: 2.5rem;
    color: #000;
    flex-shrink: 0;
  }

  .service-info {
    flex: 1;
    min-width: 0;
  }

  .service-title {
    font-size: 1rem;
    font-weight: 700;
    color: #000;
    margin: 0 0 4px 0;
  }

  .service-desc {
    font-size: 0.85rem;
    color: #6e6e73;
    margin: 0 0 8px 0;
  }

  .service-price {
    font-size: 0.9rem;
    font-weight: 600;
    color: #000;
  }

  .service-link {
    font-size: 1.2rem;
    color: #000;
    font-weight: 600;
  }

  /* CTA */
  .section-cta {
    background: #000;
    padding: 80px 0;
    text-align: center;
  }

  .cta-title {
    font-size: 2rem;

---
import Layout from '../../layouts/Layout.astro';
import ServicePageSchema from '../../components/SEO/ServicePageSchema.astro';
import FAQPageSchema from '../../components/SEO/FAQPageSchema.astro';
import PipodFAQ from '../../components/service/pipodFAQretoma.astro';
import PipodServicesBanner from '../../components/service/pipodServicesBanner.astro';
import PipodStats from '../../components/stats/pipodStats.astro';
import FloatingContact from '../../layouts/floatingContact';
import Footer from '../../components/pipodFooter';
import BlogSection from '../../components/reviews/blogSection';

// SEO Metas
const title = "Mantenimiento Apple Bogotá | Limpieza, Pasta Térmica y Optimización | Pipod";
const description = "Mantenimiento preventivo MacBook, iPhone, iMac en Chapinero, Bogotá. Limpieza interna, cambio pasta térmica, optimización. Diagnóstico gratis, garantía 12 meses.";

// Schema
const schemaService = {
  name: "Mantenimiento Apple Bogotá",
  description: "Mantenimiento preventivo para MacBook, iPhone, iMac. Limpieza, pasta térmica y optimización en Chapinero.",
  url: "https://www.pipod.co/servicio-tecnico-apple-bogota/mantenimiento",
  areaServed: "Bogotá, Chapinero"
};

// Servicios Core (3 equipos principales)
const coreServices = [
  {
    title: "CAMBIO PASTA TÉRMICA + LIMPIEZA",
    tag: "Top Prioridad",
    price: "Desde $120.000",
    icon: "bi-thermometer",
    specs: ["2-3h", "3m garantía", "MacBook / iMac"],
    link: "https://wa.me/573124813094?text=Hola%20Pipod%2C%20quiero%20cotizar%20mantenimiento%20de%20mi%20MacBook",
    linkText: "Cotizar MacBook"
  },
  {
    title: "LIMPIEZA COMPLETA + OPTIMIZACIÓN",
    tag: "Alta Demanda",
    price: "Desde $80.000",
    icon: "bi-speedometer",
    specs: ["1-2h", "3m garantía", "iPhone / iPad"],
    link: "https://wa.me/573124813094?text=Hola%20Pipod%2C%20quiero%20cotizar%20mantenimiento%20de%20mi%20iPhone",
    linkText: "Cotizar iPhone"
  },
  {
    title: "LIMPIEZA INTERNA + DIAGNÓSTICO",
    tag: "Alta Demanda",
    price: "Desde $85.000",
    icon: "bi-tools",
    specs: ["2h", "3m garantía", "iMac"],
    link: "https://wa.me/573124813094?text=Hola%20Pipod%2C%20quiero%20cotizar%20mantenimiento%20de%20mi%20iMac",
    linkText: "Cotizar iMac"
  }
];

// Servicios principales
const mainServices = [
  { title: "Cambio Pasta Térmica", icon: "bi-thermometer", desc: "MacBook, iMac — elimina throttling", price: "Desde $90.000", link: "/blog/pasta-termica-macbook-bogota" },
  { title: "Limpieza Interna", icon: "bi-droplet", desc: "Todos los equipos — polvo, bacteria", price: "Desde $80.000", link: "/blog/limpieza-macbook-bogota" },
  { title: "Optimización Sistema", icon: "bi-gear", desc: "MacOS, iOS — acelerar equipo", price: "Desde $60.000", link: "/blog/mantenimiento-macbook-bogota" },
  { title: "Diagnóstico Completo", icon: "bi-clipboard-check", desc: "Scan hardware + software", price: "Desde $50.000", link: "/blog/mantenimiento-iphone-bogota" },
  { title: "Upgrade SSD / HDD", icon: "bi-hdd", desc: "MacBook, iMac — reemplazo disco", price: "Desde $150.000", link: "/blog/mantenimiento-macbook-bogota" },
  { title: "Instalación macOS", icon: "bi-display", desc: "MacBook, iMac — reinstalación limpia", price: "Desde $45.000", link: "/blog/mantenimiento-imac-bogota" },
  { title: "Recuperación Datos", icon: "bi-database", desc: "Disco dañado, archivos perdidos", price: "Consultar", link: "/blog/mantenimiento-imac-bogota" },
  { title: "Limpieza Malware", icon: "bi-shield-virus", desc: "Virus, spyware, publicidades", price: "Desde $70.000", link: "/blog/pasta-termica-macbook-bogota" },
  { title: "Backup Manual", icon: "bi-cloud-arrow-up", desc: "Respaldo completo seguridad", price: "Desde $40.000", link: "/blog/mantenimiento-iphone-bogota" },
  { title: "Recuperación Archivo", icon: "bi-folder-check", desc: "Archivo corrupto o borrado", price: "Desde $35.000", link: "/blog/mantenimiento-iphone-bogota" }
];

// FAQs
const faqs = [
  { q: "¿Cuánto tarda una limpieza completa de MacBook o iMac?", a: "El servicio express toma 2-3 horas. Incluye diagnóstico inicial, limpieza interna, cambio de pasta térmica si es necesario, y optimización del sistema operativo. Puedes esperar mientras lo hacemos." },
  { q: "¿Qué equipos hacen mantenimiento con ustedes?", a: "Hacemos mantenimiento preventivo a MacBook (Air y Pro), iMac, iPhone e iPad. El equipo más solicitado es MacBook, seguido de iPhone e iMac." },
  { q: "¿Qué incluye el cambio de pasta térmica?", a: "El servicio incluye: limpieza interna completa (ventiladores, heatpipes, dissipadores), remoción de pasta térmica vieja, aplicación de pasta térmica premium (Thermal Grizzly o similar), y prueba de temperatura post-servicio." },
  { q: "¿Qué garantía tienen los servicios de mantenimiento?", a: "El cambio de pasta térmica tiene 3 meses de garantía. La limpieza interna tiene 3 meses de garantía. Si el equipo presenta el mismo problema, lo resolvemos sin costo adicional." },
  { q: "¿Mis datos están seguros durante el mantenimiento?", a: "Sí. No accedemos a tus datos personales salvo que sea necesario para el diagnóstico. Hacemos backup antes de cualquier intervención. Tu información es confidencial." },
  { q: "¿Cada cuánto debo hacer mantenimiento preventivo?", a: "Recomendamos limpieza interna cada 12-18 meses para MacBook y iMac. Para iPhone, la limpieza de puertos y revisión de batería puede ser cada 24 meses. El mantenimiento preventivo evita reparaciones más costosas." }
];

// Blog links internos
const blogLinks = [
  { 
    title: "Cambio Pasta Térmica MacBook Bogotá", 
    slug: "pasta-termica-macbook-bogota",
    excerpt: "Por qué tu MacBook se calienta y cómo solucionarlo con pasta térmica premium.",
    category: "REPARACIONES"
  },
  { 
    title: "Mantenimiento iPhone Bogotá", 
    slug: "mantenimiento-iphone-bogota",
    excerpt: "Cuidado preventivo para extender la vida útil de tu iPhone.",
    category: "REPARACIONES"
  },
  { 
    title: "Mantenimiento iMac Bogotá", 
    slug: "mantenimiento-imac-bogota",
    excerpt: "Limpieza interna y optimización para tu iMac.",
    category: "REPARACIONES"
  }
];

// Blog posts for BlogSection component
const blogPosts = blogLinks.map(link => ({
  title: link.title,
  excerpt: link.excerpt,
  category: link.category,
  link: `/blog/${link.slug}`
}));

// Cross-device links
const otherDevices = [
  { name: "iPhone", href: "/servicio-tecnico-apple-bogota/iphone" },
  { name: "MacBook", href: "/servicio-tecnico-apple-bogota/macbook" },
  { name: "iPad", href: "/servicio-tecnico-apple-bogota/ipad" },
  { name: "iMac", href: "/servicio-tecnico-apple-bogota/imac" },
  { name: "Apple Watch", href: "/servicio-tecnico-apple-bogota/apple-watch" }
];
---

<Layout title={title}>
  <ServicePageSchema serviceData={schemaService} pageName="mantenimiento" pageUrl={schemaService.url} />
  <FAQPageSchema faqData={faqs} />
  
  <main style="padding-top: 120px;">
    
    <!-- HERO -->
    <section class="hero-iphone">
      <div class="hero-bg">
        <img 
          src="/images/servicio-tecnico-apple-pipod.webp" 
          alt="Servicio Técnico iPhone Bogotá - Pipod"
          width="1920" height="1080"
          loading="eager"
        />
        <div class="hero-overlay"></div>
      </div>
      
      <div class="hero-content">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span>›</span>
          <a href="/servicio-tecnico-apple-bogota">Reparación</a>
          <span>›</span>
          <span>Mantenimiento</span>
        </nav>
        
        <h1 class="hero-title">
          Mantenimiento preventivo<br/>
          <span>MacBook, iPhone, iMac — Bogotá, Chapinero</span>
        </h1>
        
        <div class="trust-line">
          16 años · 3,600+ equipos · Garantía 12 meses
        </div>
        
        <p class="hero-subtitle">
          Limpieza interna, cambio pasta térmica y optimización. Diagnóstico gratis.
        </p>
        
        <div class="hero-actions">
          <a href="https://wa.me/573124813094?text=Hola%20Pipod%2C%20quiero%20cotizar%20mantenimiento%20preventivo" class="btn-primary-hero">
            <i class="bi bi-whatsapp"></i>
            Escribir por WhatsApp
          </a>
          <a href="#servicios" class="btn-secondary-hero">
            Ver servicios ↓
          </a>
        </div>
      </div>
    </section>

    <!-- TRUST BADGES -->
    <PipodServicesBanner />

    <!-- SERVICIOS PRINCIPALES -->
    <section id="servicios" class="section-core-services">
      <div class="container">
        <h2 class="section-title">Top Servicios de Mantenimiento</h2>
        
        <div class="core-grid-3">
          {coreServices.map((service, index) => (
            <div class={`core-card ${index === 0 ? 'accent-blue' : 'accent-black'}`}>
              <div class="core-card-image">
                <img src="/images/imagenservicios.jpg" alt={service.title} />
              </div>
              <div class="core-card-content">
                <div class="core-card-header">
                  <span class="core-tag">{service.tag}</span>
                  <i class={`bi ${service.icon} core-icon`}></i>
                </div>
                <h3 class="core-title">{service.title}</h3>
                <p class="core-price">{service.price}</p>
                
                <div class="core-specs">
                  <span class="spec-text"><i class="bi bi-lightning-charge"></i> {service.specs[0]}</span>
                  <span class="spec-text"><i class="bi bi-shield-check"></i> {service.specs[1]}</span>
                  <span class="spec-text"><i class="bi bi-check-circle"></i> {service.specs[2]}</span>
                </div>

                <div class="availability-row">
                  <i class="bi bi-box"></i>
                  <span>Disponibilidad hoy</span>
                </div>
                
                <div class="button-wrapper">
                  <a href={service.link} class="btn-pipod-outline">{service.linkText}</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STATS -->
    <PipodStats />

    <!-- SEO EDUCATION BLOCK -->
    <section class="section-education">
      <div class="container">
        <div class="education-content">
          <h2 class="education-title">¿Por qué el mantenimiento preventivo importa?</h2>
          <p class="education-text">
            Tu MacBook, iPhone o iMac acumula polvo en los ventiladores, pasta térmica seca en la placa, y archivos basura que ralentizan el sistema. 
            <strong>Cada día que pasa, el equipo se calienta más y rinde menos.</strong>
          </p>
          <p class="education-text">
            La limpieza interna y el cambio de pasta térmica no son lujos — son <strong>inversión que evita reparaciones costosas</strong> 
            (placa dañada, disco fallen, batería explotada). <strong>Un mantenimiento a tiempo puede extender la vida útil de tu equipo por años.</strong>
          </p>
        </div>
      </div>
    </section>

    <!-- SERVICIOS PRINCIPALES -->
    <section id="servicios" class="section-services">
      <div class="container">
        <h2 class="section-title">Servicio Técnico de Mantenimiento</h2>
        
        <div class="services-grid">
          {mainServices.map((service) => (
            <a href={service.link} class="service-card">
              <i class={`bi ${service.icon} service-icon`}></i>
              <div class="service-info">
                <h5 class="service-title">{service.title}</h5>
                <p class="service-desc">{service.desc}</p>
                <span class="service-price">{service.price}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-cta">
      <div class="container">
        <h2 class="cta-title">¿Tu equipo necesita mantenimiento?</h2>
        <p class="cta-subtitle">
          3,600+ reparados · Garantía 12 meses · 16 años Chapinero<br/>
          Diagnóstico gratis · Respuesta en minutos
        </p>
        <a href="https://wa.me/573124813094?text=Hola%20Pipod%2C%20quiero%20cotizar%20mantenimiento%20preventivo" class="btn-cta">
          <i class="bi bi-whatsapp"></i>
          Contactar por WhatsApp
        </a>
      </div>
    </section>

    <!-- CROSS-SELLING -->
    <section class="section-cross">
      <div class="container">
        <div class="cross-content">
          <i class="bi bi-tools cross-icon"></i>
          <div class="cross-text">
            <strong>¿Notas tu equipo lento o caliente?</strong> Agenda limpieza hoy
          </div>
          <a href="https://wa.me/573124813094?text=Hola%20Pipod%2C%20quiero%20agendar%20mantenimiento%20preventivo" class="btn-cross">
            Agenda
          </a>
        </div>
      </div>
    </section>

    <!-- FAQs -->
    <PipodFAQ faqs={faqs} />

    <!-- BLOG SECTION -->
    <BlogSection title="Artículos de Mantenimiento" client:load posts={blogPosts} />

    <!-- TAMBIEN REPARAMOS - CARD GRID (white cards with accents) -->
    <section class="section-also">
      <div class="container">
        <h2 class="also-title">También reparamos</h2>
        <div class="also-grid">
          <!-- Card 1: iPhone (featured) -->
          <div class="also-card iphone-also">
            <div class="card-content">
              <div class="top-content">
                <div class="header-row">
                  <i class="bi bi-phone header-icon-iphone"></i>
                  <span class="badge-pill-solid">ESPECIALIDAD</span>
                </div>
                <h3 class="highlight-title">iPhone</h3>
                <p class="legibilidad-max">Reparación: Batería, pantalla, placa y daño por agua.</p>
              </div>
              <div class="button-wrapper">
                <a href="/servicio-tecnico-apple-bogota/iphone" class="btn-pipod-outline">Ver servicios</a>
              </div>
            </div>
          </div>
          <!-- Card 2: MacBook (featured) -->
          <div class="also-card macbook-also">
            <div class="card-content">
              <div class="top-content">
                <div class="header-row">
                  <i class="bi bi-laptop header-icon-mac"></i>
                  <span class="badge-pill-solid">ESPECIALIDAD</span>
                </div>
                <h3 class="highlight-title">MacBook</h3>
                <p class="legibilidad-max">Reparación: Batería, pantalla, teclado y microsoldadura.</p>
              </div>
              <div class="button-wrapper">
                <a href="/servicio-tecnico-apple-bogota/macbook" class="btn-pipod-outline">Ver servicios</a>
              </div>
            </div>
          </div>
          <!-- Card 3: iMac -->
          <div class="also-card imac-also">
            <div class="card-content">
              <div class="top-content">
                <div class="header-small">
                  <i class="bi bi-display"></i>
                  <h4>iMac</h4>
                </div>
                <p class="desc-small">Pantalla, disco, memoria y optimización.</p>
              </div>
              <div class="bottom-content">
                <a href="/servicio-tecnico-apple-bogota/imac" class="btn-small">Ver servicios</a>
              </div>
            </div>
          </div>
          <!-- Card 4: iPad -->
          <div class="also-card ipad-also">
            <div class="card-content">
              <div class="top-content">
                <div class="header-small">
                  <i class="bi bi-tablet"></i>
                  <h4>iPad</h4>
                </div>
                <p class="desc-small">Pantalla, batería, puerto de carga y placa.</p>
              </div>
              <div class="bottom-content">
                <a href="/servicio-tecnico-apple-bogota/ipad" class="btn-small">Ver servicios</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <FloatingContact client:load />
    <Footer client:load />
  </main>
</Layout>

<style>
  /* HERO */
  .hero-iphone {
    position: relative;
    height: 80vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.3) 0%,
      transparent 20%,
      transparent 40%,
      rgba(0,0,0,0.7) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 80px;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.7);
    margin-bottom: 20px;
  }

  .breadcrumb-nav a {
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb-nav a:hover {
    color: #fff;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: #fff;
    line-height: 1;
    margin: 0 0 20px 0;
    text-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }

  .hero-title span {
    color: #4A90E2;
  }

  .trust-line {
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(12px);
    border: 0.85px solid rgba(255,255,255,0.2);
    border-radius: 50px;
    padding: 10px 20px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    display: inline-block;
    margin-bottom: 20px;
    letter-spacing: 0.5px;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: rgba(255,255,255,0.9);
    margin: 0 0 30px 0;
    max-width: 500px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-primary-hero {
    background: #4A90E2;
    color: #fff;
    padding: 16px 32px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease;
  }

  .btn-primary-hero:hover {
    background: #357ABD;
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(74,144,226,0.3);
  }

  .btn-secondary-hero {
    background: rgba(255,255,255,0.1);
    color: #fff;
    padding: 16px 32px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border: 0.85px solid rgba(255,255,255,0.3);
    transition: all 0.3s ease;
  }

  .btn-secondary-hero:hover {
    background: rgba(255,255,255,0.2);
    transform: translateY(-3px);
  }

  /* SECTION COMMON */
  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 80px;
  }

  .section-title {
    font-family: 'Inter', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: #000;
    margin: 0 0 40px 0;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  /* SERVICIOS CORE */
  .section-core-services {
    padding: 80px 0;
    background: #fff;
  }

  .core-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .core-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .core-card {
    background-color: #fff;
    border-radius: 40px;
    border: 1px solid #E8E8E8;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .core-card:hover {
    border-color: #3A506B;
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 12px 24px rgba(0,0,0,0.1);
  }

  .core-card-image {
    height: 180px;
    background-color: #000;
    overflow: hidden;
    border-radius: 40px 40px 0 0;
  }

  .core-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transition: transform 0.6s ease;
    border-radius: 40px 40px 0 0;
  }

  .core-card:hover .core-card-image img {
    transform: scale(1.05);
  }

  .core-card-content {
    padding: 24px;
  }

  .core-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .core-tag {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 6px 12px;
    border-radius: 50px;
    background: #0066CC;
    color: #fff;
  }

  .accent-blue .core-tag {
    background: linear-gradient(90deg, #3A506B, #0066CC);
  }

  .accent-black .core-tag {
    background: linear-gradient(90deg, #3A506B, #000);
  }

  .core-icon {
    font-size: 2rem;
    color: #1d1d1f;
  }

  .core-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: #000;
    margin: 0 0 6px 0;
    text-transform: uppercase;
  }

  .core-price {
    font-size: 1rem;
    font-weight: 700;
    color: #000;
    margin: 0 0 12px 0;
  }

  .core-specs {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 10px;
  }

  .spec-text {
    font-size: 0.85rem;
    color: #1F1F1F;
    font-family: 'Inter', sans-serif;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .spec-text i {
    font-size: 0.9rem;
  }

  .accent-blue .spec-text i {
    color: #0066CC;
  }

  .accent-black .spec-text i {
    color: #1F1F1F;
  }

  .availability-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: #1F1F1F;
    margin-bottom: 12px;
  }

  .availability-row i {
    color: #3A506B;
  }

.button-wrapper {
    display: flex;
    justify-content: flex-end;
  }

  .accent-blue .btn-pipod-outline {
    background: #4A90E2;
    border-color: #4A90E2;

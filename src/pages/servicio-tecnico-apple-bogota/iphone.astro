---
import Layout from '../../layouts/Layout.astro';
import ServicePageSchema from '../../components/SEO/ServicePageSchema.astro';
import FAQPageSchema from '../../components/SEO/FAQPageSchema.astro';
import PipodServicesBanner from '../../components/service/pipodServicesBanner.astro';
import PipodStats from '../../components/stats/pipodStats.astro';
import FloatingContact from '../../layouts/floatingContact';
import Footer from '../../components/pipodFooter';
import BlogSection from '../../components/reviews/blogSection';

// SEO Metas
const title = "Servicio Técnico iPhone Bogotá | Pipod - Especialistas Certificados";
const description = "Reparación iPhone en Chapinero, Bogotá. Batería, pantalla, placa, daño por agua. Diagnóstico gratis, garantía 12 meses. 16 años de experiencia.";

// Schema
const schemaService = {
  name: "Servicio Técnico iPhone Bogotá",
  description: "Reparación especializada iPhone en Chapinero, Bogotá. Batería, pantalla, placa, daño por agua.",
  url: "https://www.pipod.co/servicio-tecnico-apple-bogota/iphone",
  areaServed: "Bogotá, Chapinero"
};

// Servicios Core (54.3% del negocio)
const coreServices = [
  {
    title: "CAMBIO DE BATERÍA",
    tag: "Top Prioridad",
    price: "Desde $80.000",
    icon: "bi-battery-full",
    color: "blue",
    specs: ["1.5h express", "12m garantía", "Orig. certificada"],
    link: "/blog/cambio-bateria-iphone-chapinero",
    linkText: "Guía de Baterías en Chapinero"
  },
  {
    title: "CAMBIO DE PANTALLA",
    tag: "Alta Demanda",
    price: "Desde $150.000",
    icon: "bi-display",
    color: "gray",
    specs: ["1 hr express", "Pantalla AAA/Orig", "Calibración Color"],
    link: "/blog/cambio-pantalla-iphone-bogota",
    linkText: "Guía de Pantallas en Bogotá"
  }
];

// Servicios principales
const mainServices = [
  { title: "Cambio Batería", icon: "bi-battery-full", desc: "Express 2h, original 12m", price: "Desde $80.000", link: "/blog/cambio-bateria-iphone-chapinero" },
  { title: "Cambio Pantalla", icon: "bi-display", desc: "AAA / Original, 1h", price: "Desde $150.000", link: "/blog/cambio-pantalla-iphone-bogota" },
  { title: "Placa / Microsoldadura", icon: "bi-cpu", desc: "Cotización express", price: "Desde $120.000", link: "/blog/microsoldadura-iphone-bogota" },
  { title: "Recuperación Agua", icon: "bi-droplet", desc: "Protocolo especializado", price: "Consultar", link: "/blog/iphone-mojado-bogota" },
  { title: "Face ID", icon: "bi-scan-face", desc: "Sin borrar datos", price: "Desde $110.000", link: "/blog/face-id-no-funciona-iphone" },
  { title: "Cámara", icon: "bi-camera", desc: "OIS, lente, flash", price: "Desde $90.000", link: "/blog/camara-iphone-vibra-ois-bogota" },
  { title: "Puerto de Carga", icon: "bi-lightning-charge", desc: "Lightning/USB-C", price: "Desde $70.000", link: "/blog/iphone-no-carga-bogota" },
  { title: "No Enciende", icon: "bi-power", desc: "Diagnóstico causas", price: "Desde $55.000", link: "/blog/iphone-no-enciende-bogota" },
  { title: "Software", icon: "bi-gear", desc: "Reinstalación, recuperación", price: "Desde $45.000", link: "/blog/iphone-lento-bogota" },
  { title: "Bocina", icon: "bi-speaker", desc: "Sonido, micrófono", price: "Desde $50.000", link: "/blog/iphone-sin-sonido-bogota" },
  { title: "Botón Home", icon: "bi-house", desc: "Touch ID, home button", price: "Desde $60.000", link: "/blog/iphone-boton-home-bogota" },
  { title: "Antena WiFi", icon: "bi-wifi", desc: "Conexión redes", price: "Desde $65.000", link: "/blog/iphone-wifi-no-conecta-bogota" },
  { title: "Cristal Trasero", icon: "bi-square", desc: "Vidrio posterior", price: "Desde $85.000", link: "/blog/iphone-cristal-trasero-bogota" }
];

// FAQs
const faqs = [
  { q: "¿Cuánto tarda un cambio de batería iPhone?", a: "2 horas o menos con servicio Express. Diagnóstico gratis en 30 min. Baterías originales certificadas con 12 meses de garantía." },
  { q: "¿Cuánto cuesta cambiar la batería de un iPhone?", a: "Desde $80.000 dependiendo del modelo. Incluye diagnóstico gratis y garantía de 12 meses. Contáctanos por WhatsApp para cotización exacta." },
  { q: "¿Mi iPhone mojado se puede reparar?", a: "Sí, tenemos protocolo especializado para recuperación de equipos con daño por líquido. Importante: no conectes el equipo. Traémelo lo antes posible." },
  { q: "¿Face ID se puede reparar sin perder datos?", a: "Sí, en la mayoría de los casos podemos reparar Face ID sin afectar tus datos. El éxito depende del daño en el sensor TrueDepth." },
  { q: "¿Qué cubre la garantía de 12 meses?", a: "La garantía cubre defectos técnicos en partes y mano de obra. Si tu iPhone presenta el mismo problema dentro de los 12 meses, lo reparamos sin costo adicional." },
  { q: "¿Mis datos están seguros durante la reparación?", a: "Sí. Nunca borramos datos a menos que sea absolutamente necesario. Hacemos backup antes de cualquier intervención. Tu información es confidencial." },
  { q: "¿Si mi iPhone no enciende tiene solución?", a: "La mayoría de los casos sí tienen solución. Las causas más comunes son batería agotada, problema de software o daño en la placa. El diagnóstico es gratis." },
  { q: "¿Hacen reparación express el mismo día?", a: "Sí. Para cambio de batería y pantalla, el servicio express es de 2 horas. Reparaciones más complejas (placa, microsoldadura) pueden tomar 24-48h." }
];

// Blog links internos - only 3 for BlogSection
const blogLinks = [
  { 
    title: "Cambio batería iPhone Chapinero", 
    slug: "cambio-bateria-iphone-chapinero",
    excerpt: "Diagnóstico gratis, reparación en 2-3 horas. Baterías originales certificadas con 12 meses de garantía.",
    category: "IPHONE"
  },
  { 
    title: "Cambio pantalla iPhone Bogotá", 
    slug: "cambio-pantalla-iphone-bogota",
    excerpt: "Pantallas AAA y originales. Calibración de color incluida. Express 1 hora con garantía.",
    category: "IPHONE"
  },
  { 
    title: "iPhone mojado Bogotá", 
    slug: "iphone-mojado-bogota",
    excerpt: "Protocolo especializado para recuperación de equipos con daño por líquido. No conectes el equipo.",
    category: "IPHONE"
  }
];

// Blog posts for BlogSection component
const blogPosts = blogLinks.map(link => ({
  title: link.title,
  excerpt: link.excerpt,
  category: link.category,
  link: `/blog/${link.slug}`
}));

// Cross-device links
const otherDevices = [
  { name: "MacBook", href: "/servicio-tecnico-apple-bogota/macbook" },
  { name: "iPad", href: "/servicio-tecnico-apple-bogota/ipad" },
  { name: "iMac", href: "/servicio-tecnico-apple-bogota/imac" },
  { name: "Apple Watch", href: "/servicio-tecnico-apple-bogota/apple-watch" }
];
---

<Layout title={title}>
  <ServicePageSchema serviceData={schemaService} />
  <FAQPageSchema faqData={faqs} />
  
  <main style="padding-top: 120px;">
    
    <!-- HERO -->
    <section class="hero-iphone">
      <div class="hero-bg">
        <img 
          src="/images/servicio-tecnico-apple-pipod.webp" 
          alt="Servicio Técnico iPhone Bogotá - Pipod"
          width="1920" height="1080"
          loading="eager"
        />
        <div class="hero-overlay"></div>
      </div>
      
      <div class="hero-content">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span>›</span>
          <a href="/servicio-tecnico-apple-bogota">Reparación</a>
          <span>›</span>
          <span>iPhone</span>
        </nav>
        
        <h1 class="hero-title">
          Servicio técnico iPhone<br/>
          <span>Chapinero, Bogotá</span>
        </h1>
        
        <div class="trust-line">
          16 años · 3,600+ equipos · Garantía 12 meses
        </div>
        
        <p class="hero-subtitle">
          Reparación iPhone Express. Diagnóstico gratis. Respuesta en minutos.
        </p>
        
        <div class="hero-actions">
          <a href="https://wa.me/573124813094?text=Hola%20Pipod%2C%20tengo%20un%20iPhone%20que%20necesita%20reparación" class="btn-primary-hero">
            <i class="bi bi-whatsapp"></i>
            Escribir por WhatsApp
          </a>
          <a href="#servicios" class="btn-secondary-hero">
            Ver servicios ↓
          </a>
        </div>
      </div>
    </section>

    <!-- STATS - REUSADO -->
    <PipodStats />

    <!-- TRUST BADGES - REUSADO -->
    <PipodServicesBanner />

    <!-- SERVICIOS CORE -->
    <section id="servicios" class="section-core-services">
      <div class="container">
        <h2 class="section-title">Servicios Principales</h2>
        
        <div class="core-grid">
          {coreServices.map((service) => (
            <div class={`core-card core-card-${service.color}`}>
              <div class="core-card-header">
                <span class="core-tag">{service.tag}</span>
                <i class={`bi ${service.icon} core-icon`}></i>
              </div>
              <h3 class="core-title">{service.title}</h3>
              <p class="core-price">{service.price}</p>
              
              <div class="core-specs">
                {service.specs.map((spec) => (
                  <span class="spec-item">{spec}</span>
                ))}
              </div>
              
              <a href={service.link} class="core-link">
                → {service.linkText}
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SERVICIOS PRINCIPALES -->
    <section id="servicios" class="section-services">
      <div class="container">
        <h2 class="section-title">Servicios técnicos iPhone</h2>
        
        <div class="services-grid">
          {mainServices.map((service) => (
            <a href={service.link} class="service-card">
              <i class={`bi ${service.icon} service-icon`}></i>
              <div class="service-info">
                <h5 class="service-title">{service.title}</h5>
                <p class="service-desc">{service.desc}</p>
                <span class="service-price">{service.price}</span>
              </div>
              <span class="service-link">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-cta">
      <div class="container">
        <h2 class="cta-title">¿Tu iPhone necesita reparación?</h2>
        <p class="cta-subtitle">
          3,600+ reparados · Garantía 12 meses · 16 años Chapinero<br/>
          Diagnóstico gratis · Respuesta en minutos
        </p>
        <a href="https://wa.me/573124813094?text=Hola%20Pipod%2C%20tengo%20un%20iPhone%20que%20necesita%20reparación" class="btn-cta">
          <i class="bi bi-whatsapp"></i>
          Contactar por WhatsApp
        </a>
      </div>
    </section>

    <!-- CROSS-SELLING -->
    <section class="section-cross">
      <div class="container">
        <div class="cross-content">
          <span class="cross-icon">🎁</span>
          <div class="cross-text">
            <strong>Combo: Funda + Protector</strong> para tu iPhone recién reparado
          </div>
          <span class="cross-price">$50.000 COP</span>
          <a href="/tienda-pipod?filter=fundas" class="btn-cross">
            Ver combo →
          </a>
        </div>
      </div>
    </section>

    <!-- FAQs -->
    <section class="section-faqs">
      <div class="container">
        <h2 class="section-title">Preguntas Frecuentes</h2>
        
        <div class="faqs-list">
          {faqs.map((faq, index) => (
            <details class="faq-item">
              <summary class="faq-question">
                {faq.q}
                <i class="bi bi-chevron-down"></i>
              </summary>
              <div class="faq-answer">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- BLOG SECTION -->
    <BlogSection title="Artículos relacionados" client:load posts={blogPosts} />

    <!-- TAMBIEN REPARAMOS -->
    <section class="section-also">
      <div class="container">
        <p class="also-text">También reparamos otros dispositivos Apple:</p>
        <div class="also-links">
          {otherDevices.map((device) => (
            <a href={device.href} class="also-link">
              {device.name}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <FloatingContact client:load />
    <Footer client:load />
  </main>
</Layout>

<style>
  /* HERO */
  .hero-iphone {
    position: relative;
    height: 80vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.3) 0%,
      transparent 20%,
      transparent 40%,
      rgba(0,0,0,0.7) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 80px;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.7);
    margin-bottom: 20px;
  }

  .breadcrumb-nav a {
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb-nav a:hover {
    color: #fff;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: #fff;
    line-height: 1;
    margin: 0 0 20px 0;
    text-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }

  .hero-title span {
    color: #4A90E2;
  }

  .trust-line {
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(12px);
    border: 0.85px solid rgba(255,255,255,0.2);
    border-radius: 50px;
    padding: 10px 20px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    display: inline-block;
    margin-bottom: 20px;
    letter-spacing: 0.5px;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: rgba(255,255,255,0.9);
    margin: 0 0 30px 0;
    max-width: 500px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-primary-hero {
    background: #4A90E2;
    color: #fff;
    padding: 16px 32px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease;
  }

  .btn-primary-hero:hover {
    background: #357ABD;
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(74,144,226,0.3);
  }

  .btn-secondary-hero {
    background: rgba(255,255,255,0.1);
    color: #fff;
    padding: 16px 32px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border: 0.85px solid rgba(255,255,255,0.3);
    transition: all 0.3s ease;
  }

  .btn-secondary-hero:hover {
    background: rgba(255,255,255,0.2);
    transform: translateY(-3px);
  }

  /* SECTION COMMON */
  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 80px;
  }

  .section-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: #000;
    margin: 0 0 40px 0;
    text-align: center;
  }

  /* SERVICIOS CORE */
  .section-core-services {
    padding: 80px 0;
    background: #fff;
  }

  .core-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .core-card {
    padding: 40px;
    border-radius: 20px;
    position: relative;
  }

  .core-card-blue {
    background: #E6F1FB;
    border: 2px solid #4A90E2;
  }

  .core-card-gray {
    background: #F4F4F5;
    border: 1px solid #E5E5E7;
  }

  .core-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
  }

  .core-tag {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 6px 12px;
    border-radius: 50px;
    background: #4A90E2;
    color: #fff;
  }

  .core-card-gray .core-tag {
    background: #6e6e73;
  }

  .core-icon {
    font-size: 2.5rem;
    color: #1d1d1f;
  }

  .core-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #000;
    margin: 0 0 8px 0;
  }

  .core-price {
    font-size: 1.1rem;
    font-weight: 600;
    color: #4A90E2;
    margin: 0 0 20px 0;
  }

  .core-specs {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .spec-item {
    font-size: 0.8rem;
    padding: 6px 12px;
    background: rgba(74,144,226,0.1);
    border-radius: 8px;
    color: #4A90E2;
    font-weight: 500;
  }

  .core-card-gray .spec-item {
    background: rgba(0,0,0,0.05);
    color: #6e6e73;
  }

  .core-link {
    font-size: 0.85rem;
    color: #4A90E2;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: gap 0.2s;
  }

  .core-link:hover {
    gap: 10px;
  }

  /* SERVICIOS PRINCIPALES */
  .section-services {
    padding: 80px 0;
    background: #F5F5F7;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }

  .service-card {
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    border: 1px solid #E5E5E7;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.1);
  }

  .service-icon {
    font-size: 2.5rem;
    color: #3A506B;
    flex-shrink: 0;
  }

  .service-info {
    flex: 1;
    min-width: 0;
  }

  .service-title {
    font-size: 1rem;
    font-weight: 700;
    color: #000;
    margin: 0 0 4px 0;
  }

  .service-desc {
    font-size: 0.85rem;
    color: #6e6e73;
    margin: 0 0 8px 0;
  }

  .service-price {
    font-size: 0.9rem;
    font-weight: 600;
    color: #4A90E2;
  }

  .service-link {
    font-size: 1.2rem;
    color: #4A90E2;
    font-weight: 600;
  }

  /* CTA */
  .section-cta {
    background: #000;
    padding: 80px 0;
    text-align: center;
  }

  .cta-title {
    font-size: 2rem;
    font-weight: 800;
    color: #fff;
    margin: 0 0 16px 0;
  }

  .cta-subtitle {
    font-size: 1rem;
    color: rgba(255,255,255,0.7);
    margin: 0 0 32px 0;
    line-height: 1.6;
  }

  .btn-cta {
    background: #4A90E2;
    color: #fff;
    padding: 18px 40px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    transition: all 0.3s ease;
  }

  .btn-cta:hover {
    background: #357ABD;
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(74,144,226,0.3);
  }

  /* CROSS */
  .section-cross {
    padding: 40px 0;
    background: #fff;
    border-top: 1px solid #E5E5E7;
  }

  .cross-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .cross-icon {
    font-size: 1.5rem;
  }

  .cross-text {
    font-size: 1rem;
    color: #444;
  }

  .cross-price {
    font-weight: 700;
    color: #000;
  }

  .btn-cross {
    background: #000;
    color: #fff;
    padding: 10px 20px;
    border-radius: 50px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .btn-cross:hover {
    background: #4A90E2;
  }

  /* FAQs */
  .section-faqs {
    padding: 80px 0;
    background: #F5F5F7;
  }

  .faqs-list {
    max-width: 800px;
    margin: 0 auto;
  }

  .faq-item {
    background: #fff;
    border-radius: 12px;
    margin-bottom: 12px;
    overflow: hidden;
    border: 1px solid #E5E5E7;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    font-size: 1rem;
    font-weight: 600;
    color: #000;
    cursor: pointer;
    list-style: none;
    gap: 16px;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question i {
    flex-shrink: 0;
    color: #6e6e73;
    transition: transform 0.3s ease;
  }

  details[open] .faq-question i {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 24px 20px;
    font-size: 0.95rem;
    color: #555;
    line-height: 1.7;
  }

  /* BLOG */
  .section-blog {
    padding: 80px 0;
    background: #fff;
  }


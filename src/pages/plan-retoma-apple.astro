---
import Layout from '../layouts/Layout.astro';
import RetomaPageSchema from '../components/SEO/RetomaPageSchema.astro';
import Footer from '../components/pipodFooter';
import PipodNavbar from '../components/pipodNavbar';
import RetomaStats from '../components/retoma/RetomaStats.astro';
import GoogleMaps from '../components/maps/pipodGooglemaps.astro';
import RetomaTrustBadgesBlackAstro from '../components/retoma/RetomaTrustBadgesBlackAstro.astro';
import RetomaComparison from '../components/retoma/RetomaComparison.astro';
import RetomaHero from '../components/retoma/RetomaHero.astro';
import RetomaBenefits from '../components/retoma/RetomaBenefits.astro';
import RetomaSteps from '../components/retoma/RetomaSteps.astro';
import RetomaChecklist from '../components/retoma/RetomaChecklist.astro';
import RetomaFAQ from '../components/retoma/RetomaFAQ.astro';
import RetomaProductsWhite from '../components/retoma/RetomaProductsWhite.astro';
import NewsletterRetoma from '../components/retoma/NewsletterRetoma.astro';
import FloatingContact from '../layouts/floatingContact';
import PaymentBanner from '../components/payment/PaymentBanner.astro';
---

<Layout title="Pipod - Plan Retoma de Dispositivos Apple" description="Entrega tu dispositivo Apple usado (iPhone, MacBook, iMac, Apple Watch) y recibe crédito para comprar equipo nuevo o reacondicionado.">

  <RetomaPageSchema />
  <PipodNavbar client:load />

  <main style="padding-top: 120px;">
    <RetomaHero />
    <RetomaProductsWhite />
    <RetomaBenefits />
    <RetomaTrustBadgesBlackAstro />
    <RetomaSteps />
    <RetomaStats />
    <RetomaComparison />
    <RetomaChecklist />
    <RetomaFAQ />
    
    <PaymentBanner />

    <GoogleMaps />

    <NewsletterRetoma />
  
    <FloatingContact client:load />
    <Footer client:load />
  </main>

</Layout>

<style is:global>
  body {
    font-family: 'Inter', sans-serif;
    background-color: #FFFFFF;
    overflow-x: hidden;
  }

  main .footer-pipod {
    padding-left: 15px;
    padding-right: 15px;
  }

  .tracking-wide {
    letter-spacing: 0.2em;
  }

  @media (max-width: 768px) {
    .payment-section {
      height: auto;
      padding: 40px 0;
    }

    .payment-grid {
      flex-wrap: wrap;
      justify-content: center;
      gap: 30px;
    }

    .payment-wrapper {
      padding: 0 20px;
    }
  }
</style>

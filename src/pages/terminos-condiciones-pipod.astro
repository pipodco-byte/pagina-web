---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/pipodFooter';
import FloatingContact from '../layouts/floatingContact';
import TermsPageSchema from '../components/SEO/TermsPageSchema.astro';
import TermsPage from '../components/terms/TermsPage.astro';
import { termsData } from '../data/terminos-condiciones';
import '../../assets/scss/astro-ecommerce.scss';

const title = "Términos y Condiciones - Pipod";
const description = "Términos y condiciones generales de Pipod. Lee nuestras políticas de venta, servicio técnico y plan retoma.";
---

<Layout title={title} description={description}>
  <TermsPageSchema />
  
  <main>
    <TermsPage data={termsData} />
    <FloatingContact client:load />
    <Footer client:load />
  </main>
</Layout>

<style is:global>
  body {
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
  }

  main .terms-widgets {
    padding: 0 15px;
  }

  main .footer-pipod {
    padding-left: 15px;
    padding-right: 15px;
  }
</style>

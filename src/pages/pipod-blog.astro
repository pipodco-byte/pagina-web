---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/pipodFooter';
import BlogFilter from '../components/blog/BlogFilter';
import BlogHeroFeatured from '../components/blog/BlogHeroFeatured.astro';
import BlogCtaSection from '../components/blog/BlogCtaSection.astro';
import FloatingContact from '../layouts/floatingContact';
import BlogPostingSchema from '../components/SEO/BlogPostingSchema.astro';
import { getCollection } from 'astro:content';
import '../styles/_blog-editorial.scss';
import '../../assets/scss/astro-ecommerce.scss';

// Enable static prerendering
export const prerender = true;

// Fetch all blog posts from Content Collections
const allPosts = await getCollection('blog');

// Transform posts to the format expected by BlogFilter and BlogHeroFeatured
const posts = allPosts
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .map(post => ({
    id: post.id,
    slug: post.data.slug,
    title: post.data.title,
    description: post.data.description,
    category: post.data.category,
    tags: post.data.tags,
    ogImage: post.data.ogImage,
    publishDate: post.data.publishDate.toISOString(),
    author: post.data.author,
    readingTime: '5 min de lectura'
  }));

const title = "Blog Pipod - Expertos en Apple";
const description = "Artículos, tips y guías sobre reparación, mantenimiento y optimización de equipos Apple.";
const siteUrl = 'https://www.pipod.co';
const blogUrl = `${siteUrl}/pipod-blog`;
const today = new Date().toISOString().split('T')[0];
---

<Layout title={title} description={description}>
  <script define:vars={{ posts }}>
    window.__BLOG_POSTS__ = posts;
  </script>
  <BlogPostingSchema
    title={title}
    description={description}
    author="Pipod"
    datePublished={today}
    url={blogUrl}
  />
  
  <main style="padding-top: 120px;">
    {posts.length > 0 && <BlogHeroFeatured post={posts[0]} />}
    <BlogFilter client:load posts={posts} />
    <BlogCtaSection />
  </main>

  <FloatingContact client:load />
  <Footer client:load />
</Layout>

<style is:global>
  body {
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
  }

  .container {
    padding: 0 24px !important;
  }
</style>

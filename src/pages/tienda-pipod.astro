---
import Layout from '../layouts/Layout.astro';
import '../../assets/scss/astro-ecommerce.scss';
import PipodNavbar from '../components/pipodNavbar';
import Footer from '../components/pipodFooter';
import StoreHero from '../components/store/StoreHero.astro';
import StoreWithFilters from '../components/store/StoreWithFilters.astro';
import StoreEmptyState from '../components/store/StoreEmptyState.astro';
import { getProductos } from '../lib/contentful';

const productos = await getProductos();

const title = "Tienda Pipod - Productos Apple Certificados";
const description = "Descubre nuestra selección de productos Apple nuevos, seminuevos y repotenciados con garantía técnica en Bogotá.";
---

<Layout title={title} description={description}>
  <PipodNavbar client:load />
  
  <main class="store-main">
    <StoreHero 
      title="Tienda Pipod"
      subtitle="Especialistas en ecosistema Apple"
      description="Descubre nuestra selección de productos nuevos, seminuevos y repotenciados certificados por Pipod."
      ctaText="Catálogo"
      ctaLink="#productos"
    />

    <div class="container" id="productos">
      {/* PRODUCTOS CON FILTROS */}
      {productos.length > 0 ? (
        <StoreWithFilters productos={productos} />
      ) : (
        <StoreEmptyState 
          title="Estamos preparando nuevos equipos"
          subtitle="Nuestro stock se actualiza diariamente"
          description="Si buscas un modelo específico, escríbenos por WhatsApp y te ayudaremos a encontrarlo."
        />
      )}
    </div>
  </main>

  <Footer client:load />
</Layout>

<style is:global>
  .store-main {
    padding-top: 140px;
    padding-bottom: 100px;
    background: #FFFFFF;
  }

  main .footer-pipod {
    padding-left: 15px;
    padding-right: 15px;
  }

  @media (max-width: 768px) {
    .store-main {
      padding-top: 100px;
      padding-bottom: 60px;
    }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import ServicePageSchema from '../components/SEO/ServicePageSchema.astro';
import FAQPageSchema from '../components/SEO/FAQPageSchema.astro';
import ServiceHero from '../components/service/ServiceHero.astro';
import DeviceBento from '../components/service/DeviceBento.astro';
import PantallasCatalog from '../components/service/PantallasCatalog.astro';
import MantenimientoCatalog from '../components/service/MantenimientoCatalog.astro';
import OtrasReparaciones from '../components/service/OtrasReparaciones.astro';
import BateriasBanner from '../components/service/pipodBateriasBanner.astro';
import Bateria2 from '../components/service/Baterias2.astro';
import PantallasBanner from '../components/service/pipodPantallasBanner.astro';
import HardwareBanner from '../components/service/pipodHardwareBanner.astro';
import ProtocoloPipod from '../components/service/ProtocoloPipod.astro';
import FloatingContact from '../layouts/floatingContact';
import PipoData from '../components/service/PidoDataCTA.astro';
import PipodFAQ from '../components/service/pipodFAQretoma.astro';
import ServicesBanner from '../components/service/pipodServicesBanner.astro';
import ReviewWall from '../components/promo/pipodGoogleReviews.jsx';
import Footer from '../components/pipodFooter';
import Stats from '../components/stats/pipodStats.astro';
import PaymentBanner from '../components/payment/PaymentBanner.astro';
import '../../assets/scss/astro-ecommerce.scss';

// SEO Metas
const title = "Servicio Técnico Apple Bogotá | PIPOD - Baterías y Pantallas";
const description = "Especialistas en baterías y pantallas Apple. 2,000+ baterías reemplazadas. Express 2h para iPhone. Garantía 12 meses. Bogotá.";

const serviceFAQs = [
  { q: '¿Cuánto tiempo tarda la reparación de un iPhone?', a: '2 horas o menos con servicio Express. Reparaciones complejas como microsoldadura: 24-48h.' },
  { q: '¿Qué garantía ofrecen?', a: '12 meses en todas las reparaciones. La garantía cubre partes y mano de obra.' },
  { q: '¿Los repuestos son originales?', a: 'Usamos repuestos de alta calidad certificados. Para equipos Apple, recomendamos repuestos originales o calidad OEM.' },
  { q: '¿Puedo dejar mi equipo sin cita?', a: 'Sí, puedes traer tu equipo sin cita para diagnóstico gratis (30-60 min). Para reparaciones, agendar asegura disponibilidad.' },
  { q: '¿Ofrecen servicio a domicilio?', a: 'Sí, ofrecemos servicio de recogida y entrega a domicilio en toda Bogotá.' },
  { q: '¿Qué dispositivos Apple reparan?', a: 'iPhone, iPad, MacBook, iMac, Apple Watch y AirPods. También hacemos microsoldadura para reparaciones de placa.' },
  { q: '¿Cómo funciona el diagnóstico gratis?', a: 'Traes tu equipo, lo revisamos en 30-60 minutos y te informamos el problema y costo exactos. Sin compromiso.' },
  { q: '¿Pueden recuperar datos de un iPhone mojado?', a: 'Sí, tenemos equipo especializado para recuperación de datos en equipos con daño por líquido. El éxito depende del estado.' }
];
---

<Layout title={title}>
  <ServicePageSchema />
  <FAQPageSchema faqData={serviceFAQs} />
  
  <main style="padding-top: 120px;">
 <ServiceHero />
    <Stats />
    <DeviceBento />
    <BateriasBanner />
    <Bateria2 />
    <PantallasBanner />
    <PantallasCatalog />
    <ServicesBanner />
    <MantenimientoCatalog />
    <PaymentBanner />
    <OtrasReparaciones />
    <HardwareBanner />
    <ProtocoloPipod />
    <ReviewWall />    
    <PipoData />
    <PipodFAQ />
    <FloatingContact client:load />
    <Footer client:load />
  </main>
</Layout>

<style is:global>
  /* Reset y tipografía global */
  body { 
    font-family: 'Inter', sans-serif; 
    overflow-x: hidden; 
  }
  
  main .footer-pipod {
    padding-left: 15px;
    padding-right: 15px;
  }
  
  .text-gradient { 
    background: linear-gradient(90deg, #3A506B, #000); 
    -webkit-background-clip: text; 
    -webkit-text-fill-color: transparent; 
  }

  .mono {
    font-family: 'PT Mono', monospace;
  }

  .bg-light {
    background-color: #F5F5F5 !important;
  }

  .rounded-4 {
    border-radius: 20px;
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/pipodFooter';
import FloatingContact from '../layouts/floatingContact';
import ContactPageSchema from '../components/SEO/ContactPageSchema.astro';
import FAQPageSchema from '../components/SEO/FAQPageSchema.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import PipodStats from '../components/stats/pipodStats.astro';
import ContactHistory from '../components/contact/ContactHistory.astro';
import ContactPhilosophy from '../components/contact/ContactPhilosophy.astro';
import ContactFormSection from '../components/contact/ContactFormSection.astro';
import ContactLocation from '../components/contact/ContactLocation.astro';
import ContactChecklist from '../components/contact/ContactChecklist.astro';
import ContactFAQ from '../components/contact/ContactFAQ.astro';
import ContactCTA from '../components/contact/ContactCTA.astro';
import ValoresContact from '../components/contact/ValoresContact';
import '../../assets/scss/astro-ecommerce.scss';

const title = "Servicio Técnico Apple Chapinero | PIPOD";
const description = "Reparación MacBook, iPhone, iPad en Bogotá. Microsoldadura, garantía real y plan retoma. Desde 2009 rescatando tecnología.";

const contactFAQs = [
  { q: '¿Cuánto tiempo tarda una reparación?', a: 'Depende del diagnóstico. Desde 1 hora (cambio de pantalla) hasta 3-5 días (reparaciones complejas). Diagnóstico gratuito en 30 minutos.' },
  { q: '¿Qué pasa si mi equipo tiene iCloud bloqueado?', a: 'Podemos ayudarte con el desbloqueo si eres el propietario. Trae identificación y comprobante de compra.' },
  { q: '¿Ofrecen servicio a domicilio?', a: 'Sí, en Zona Metropolitana. Consulta disponibilidad y costo según tu ubicación.' },
  { q: '¿Qué métodos de pago aceptan?', a: 'Efectivo, transferencia bancaria, tarjeta de crédito/débito y financiación con Crédito Fácil.' }
];
---

<Layout title={title} description={description}>
  <ContactPageSchema />
  <FAQPageSchema faqData={contactFAQs} />
  
    <main>
    <ContactHero />
    <PipodStats />
    <ContactHistory />
    <ContactPhilosophy />
    <ValoresContact client:load />
    <ContactFormSection />

    {/* UBICACIÓN Y LOGÍSTICA */}
    <ContactLocation />

    {/* CHECKLIST */}
    <ContactChecklist />

    {/* FAQ */}
    <ContactFAQ />

    {/* CTA FINAL */}
    <ContactCTA />

  </main>

  <FloatingContact client:load />
  <Footer client:load />
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans:wght@400;500&family=PT+Mono&display=swap');

  body {
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
  }



  @media (max-width: 1024px) {
    .pipod-history-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .pipod-history-col.pipod-separator {
      padding-left: 0;
      padding-top: 60px;
      border-left: none;
      border-top: 0.85px solid #000;
    }
  }



  @media (max-width: 768px) {
    .pipod-history-section {
      padding: 50px 0;
    }

    .pipod-container {
      padding: 0 25px;
    }

    .pipod-history-title {
      font-size: 2rem;
    }

    .pipod-history-content p {
      font-size: 1rem;
    }
  }
</style>

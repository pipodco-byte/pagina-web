---
import Layout from '../layouts/Layout.astro';
import PipodNavbar from '../components/pipodNavbar';
import Footer from '../components/pipodFooter';
import FloatingContact from '../layouts/floatingContact';
import ContactPageSchema from '../components/SEO/ContactPageSchema.astro';
import ContactLocation from '../components/contact/ContactLocation.astro';
import ContactChecklist from '../components/contact/ContactChecklist.astro';
import ContactFAQ from '../components/contact/ContactFAQ.astro';
import ContactCTA from '../components/contact/ContactCTA.astro';
import '../../assets/scss/astro-ecommerce.scss';

const title = "Servicio Técnico Apple Chapinero | PIPOD";
const description = "Reparación MacBook, iPhone, iPad en Bogotá. Microsoldadura, garantía real y plan retoma. Desde 2009 rescatando tecnología.";
---

<Layout title={title} description={description}>
  <ContactPageSchema />
  <PipodNavbar client:load />
  
  <main style="padding-top: 120px; background: #FFFFFF;">

    {/* HERO */}
    <section style="height: 90vh; display: flex; align-items: center; border-bottom: 0.85px solid #000; position: relative; overflow: hidden;">
      <div style="max-width: 1440px; margin: 0 auto; padding: 0 80px; width: 100%;">
        <div style="display: inline-block; background: rgba(74, 144, 226, 0.1); border: 0.85px solid #4A90E2; padding: 4px 12px; border-radius: 50px; margin-bottom: 24px;">
           <span style="font-family: 'PT Mono', monospace; font-size: 0.7rem; color: #4A90E2; font-weight: 700; letter-spacing: 2px;">SERVICIO TÉCNICO APPLE CHAPINERO</span>
        </div>
        <h1 style="font-family: 'Inter', sans-serif; font-size: 4.5rem; font-weight: 800; color: #000; letter-spacing: -0.05em; line-height: 1.1; margin-bottom: 30px;">
          Reparamos donde otros<br/><span style="color: #4A90E2;">reemplazan.</span>
        </h1>
        <p style="font-family: 'Inter', sans-serif; font-size: 1.2rem; color: #444; max-width: 600px; line-height: 1.7; margin-bottom: 45px;">
          Más de 15 años de experiencia brindando soluciones reales en Bogotá. Ofrecemos un soporte técnico premium con atención profesional, cercana y transparente. No solo arreglamos equipos, cuidamos tu herramienta de trabajo.
        </p>
        <div style="display: flex; gap: 16px;">
          <a href="https://wa.me/573124813094" style="background: #000; color: #FFF; padding: 18px 40px; border-radius: 50px; text-decoration: none; font-weight: 600; font-family: 'Inter', sans-serif; transition: 0.3s;">Agendar Diagnóstico Gratis</a>
          <a href="#contacto" style="border: 1.5px solid #000; color: #000; padding: 18px 40px; border-radius: 50px; text-decoration: none; font-weight: 600; font-family: 'Inter', sans-serif; transition: 0.3s;">Ver canales de contacto</a>
        </div>
      </div>
    </section>

    {/* HISTORIA */}
    <section style="padding: 100px 0; border-bottom: 0.85px solid #000;">
      <div style="max-width: 1440px; margin: 0 auto; padding: 0 80px; display: grid; grid-template-columns: 1fr 1fr; gap: 100px;">
        <div>
          <span style="font-family: 'PT Mono', monospace; font-size: 0.7rem; color: #888; letter-spacing: 2px; text-transform: uppercase;">NUESTRA HISTORIA</span>
          <h2 style="font-family: 'Inter', sans-serif; font-size: 3rem; font-weight: 800; color: #000; margin-top: 20px; line-height: 1.1;">Honestidad desde el Origen</h2>
        </div>
        <div style="border-left: 0.85px solid #000; padding-left: 60px;">
          <p style="font-family: 'Inter', sans-serif; font-size: 1rem; color: #444; line-height: 1.8; margin-bottom: 20px;">Presencia en Bogotá desde 2009. Pipod.co nació con una premisa clara: hacer las cosas bien. Creemos que la honestidad es la base de la confianza, por eso mostramos todo el proceso de diagnóstico sin sorpresas ni letra pequeña.</p>
          <p style="font-family: 'Inter', sans-serif; font-size: 1rem; color: #444; line-height: 1.8; margin-bottom: 20px;">Nos dimos cuenta de que los usuarios Apple necesitaban un aliado tecnológico que hablara con lenguaje claro, sin exagerar diagnósticos. Hoy, somos el centro de servicio especializado que combina precisión técnica con un trato humano y empático.</p>
        </div>
      </div>
    </section>

    {/* FILOSOFÍA */}
    <section style="padding: 100px 0; background: #F5F5F7;">
      <div style="max-width: 1440px; margin: 0 auto; padding: 0 80px;">
        <span style="font-family: 'PT Mono', monospace; font-size: 0.7rem; color: #888; letter-spacing: 2px; text-transform: uppercase;">NUESTRA FILOSOFÍA</span>
        <h2 style="font-family: 'Inter', sans-serif; font-size: 2.8rem; font-weight: 800; margin: 20px 0 40px;">Reparar es Cuidar</h2>
        <p style="font-family: 'Inter', sans-serif; font-size: 1rem; color: #444; line-height: 1.8; margin-bottom: 60px; max-width: 800px;">En Pipod creemos que la tecnología no debe ser desechable. Buscamos siempre la solución más eficiente y sostenible.</p>
        <div style="background: #FFFFFF; border: 0.85px solid #000; border-radius: 24px; padding: 60px; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 40px;">
          <div>
            <div style="font-size: 2.5rem; margin-bottom: 20px;">🌱</div>
            <span style="font-family: 'PT Mono', monospace; font-size: 0.7rem; color: #888; font-weight: 700; letter-spacing: 2px;">SOSTENIBLE</span>
            <p style="font-family: 'Inter', sans-serif; font-size: 0.95rem; color: #444; line-height: 1.7; margin-top: 15px;">Reducimos el desperdicio electrónico mediante soluciones reales, no reemplazos innecesarios.</p>
          </div>
          <div style="border-left: 0.85px solid #F0F0F0; padding-left: 40px;">
            <div style="font-size: 2.5rem; margin-bottom: 20px;">💰</div>
            <span style="font-family: 'PT Mono', monospace; font-size: 0.7rem; color: #888; font-weight: 700; letter-spacing: 2px;">TRANSPARENTE</span>
            <p style="font-family: 'Inter', sans-serif; font-size: 0.95rem; color: #444; line-height: 1.7; margin-top: 15px;">Pagas por la reparación real. Decimos las cosas como son, con ética y claridad.</p>
          </div>
          <div style="border-left: 0.85px solid #F0F0F0; padding-left: 40px;">
            <div style="font-size: 2.5rem; margin-bottom: 20px;">⚙️</div>
            <span style="font-family: 'PT Mono', monospace; font-size: 0.7rem; color: #888; font-weight: 700; letter-spacing: 2px;">PRECISIÓN TÉCNICA</span>
            <p style="font-family: 'Inter', sans-serif; font-size: 0.95rem; color: #444; line-height: 1.7; margin-top: 15px;">Somos especialistas. Cada reparación se realiza con conocimiento profundo y herramientas adecuadas.</p>
          </div>
        </div>
      </div>
    </section>

    {/* VALORES */}
    <section style="padding: 100px 0; border-bottom: 0.85px solid #000;">
      <div style="max-width: 1440px; margin: 0 auto; padding: 0 80px;">
        <span style="font-family: 'PT Mono', monospace; font-size: 0.7rem; color: #888; letter-spacing: 2px; text-transform: uppercase;">NUESTROS VALORES FUNDAMENTALES</span>
        <h2 style="font-family: 'Inter', sans-serif; font-size: 3rem; font-weight: 800; color: #000; margin: 20px 0 60px;">Lo que nos define</h2>
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px;">
          {[
            { emoji: "🔍", label: "Transparencia", d: "Sin sorpresas. Mostramos cada etapa del proceso de reparación." },
            { emoji: "⚙️", label: "Precisión Técnica", d: "Especialistas en Apple que cuidan cada detalle técnico con estándares premium." },
            { emoji: "🤝", label: "Cercanía Humana", d: "No tratamos con clientes, sino con personas. Escuchamos y acompañamos con empatía." },
            { emoji: "⚡", label: "Agilidad y Eficiencia", d: "Optimizamos procesos para respetar tu tiempo sin sacrificar la calidad." }
          ].map(val => (
            <div style="border: 0.85px solid #000; border-radius: 24px; padding: 40px; transition: 0.3s;" class="hover-card">
              <div style="font-size: 2rem; margin-bottom: 15px;">{val.emoji}</div>
              <h3 style="font-family: 'Inter', sans-serif; font-weight: 800; font-size: 1.4rem; margin-bottom: 15px;">{val.label}</h3>
              <p style="color: #444; line-height: 1.7;">{val.d}</p>
            </div>
          ))}
          <div style="grid-column: 1 / -1; border: 0.85px solid #000; border-radius: 24px; padding: 40px; background: #F5F5F7;">
            <div style="font-size: 2rem; margin-bottom: 15px;">🔧</div>
            <h3 style="font-family: 'Inter', sans-serif; font-weight: 800; font-size: 1.4rem; margin-bottom: 15px;">Solución Real</h3>
            <p style="color: #444; line-height: 1.7;">Vamos al punto y resolvemos rápido, priorizando la reparación sobre el cambio de piezas.</p>
          </div>
        </div>
      </div>
    </section>

    {/* B2B SECTION */}
    <section style="padding: 100px 0; background: #F5F5F7; border-bottom: 0.85px solid #000;">
      <div style="max-width: 1440px; margin: 0 auto; padding: 0 80px;">
        <span style="font-family: 'PT Mono', monospace; font-size: 0.7rem; color: #888; letter-spacing: 2px; text-transform: uppercase;">PRÓXIMO PASO</span>
        <h2 style="font-family: 'Inter', sans-serif; font-size: 3rem; font-weight: 800; color: #000; margin: 20px 0 40px;">El Salto al Sector B2B</h2>
        <p style="font-family: 'Inter', sans-serif; font-size: 1.1rem; color: #444; line-height: 1.8; max-width: 900px;">Aliado tecnológico para tu empresa. Estamos escalando nuestros servicios para ofrecer soluciones confiables a empresas y profesionales independientes que dependen del ecosistema Apple. Llevamos nuestro estándar de excelencia al entorno corporativo con soporte preferencial y mantenimiento preventivo.</p>
      </div>
    </section>

    {/* CONTACTO */}
    <section id="contacto" style="padding: 100px 0; background: #1a1a1a; color: #FFFFFF;">
      <div style="max-width: 1440px; margin: 0 auto; padding: 0 80px; display: grid; grid-template-columns: 1fr 1fr; gap: 80px;">
        <div>
          <span style="font-family: 'PT Mono', monospace; font-size: 0.7rem; color: #4A90E2; letter-spacing: 2px; text-transform: uppercase;">CANALES DE CONTACTO Y UBICACIÓN</span>
          <h2 style="font-family: 'Inter', sans-serif; font-size: 3.5rem; font-weight: 800; margin: 20px 0 40px; line-height: 1.1;">Hablemos con claridad.</h2>
          
          <div style="margin-bottom: 40px;">
            <h3 style="font-family: 'PT Mono', monospace; font-size: 0.8rem; color: #888; margin-bottom: 15px; letter-spacing: 1px;">UBICACIÓN</h3>
            <p style="margin-bottom: 20px; font-size: 1rem; line-height: 1.6;">Cra. 13a #79-52, Chapinero, Bogotá.</p>
          </div>
          
          <div style="margin-bottom: 40px;">
            <h3 style="font-family: 'PT Mono', monospace; font-size: 0.8rem; color: #888; margin-bottom: 15px; letter-spacing: 1px;">HORARIO</h3>
            <p style="font-size: 1rem; line-height: 1.6;">Lunes a Sábado, 10:00 AM - 7:00 PM.</p>
          </div>
          
          <div>
            <h3 style="font-family: 'PT Mono', monospace; font-size: 0.8rem; color: #888; margin-bottom: 15px; letter-spacing: 1px;">COMPROMISO</h3>
            <p style="font-size: 1rem; line-height: 1.6;">Respuesta garantizada en máximo 2 horas para que tu operación no se detenga.</p>
          </div>
        </div>

        <div style="background: rgba(255,255,255,0.05); border: 0.85px solid rgba(255,255,255,0.25); border-radius: 24px; padding: 50px; backdrop-filter: blur(14px);">
          <form style="display: grid; gap: 24px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
              <input type="text" placeholder="NOMBRE" style="background: transparent; border: 0.85px solid rgba(255,255,255,0.2); padding: 15px; border-radius: 12px; color: #FFF; font-family: 'PT Mono', monospace; font-size: 0.8rem;" />
              <input type="email" placeholder="EMAIL" style="background: transparent; border: 0.85px solid rgba(255,255,255,0.2); padding: 15px; border-radius: 12px; color: #FFF; font-family: 'PT Mono', monospace; font-size: 0.8rem;" />
            </div>
            <select style="background: #1a1a1a; border: 0.85px solid rgba(255,255,255,0.2); padding: 15px; border-radius: 12px; color: #FFF; font-family: 'PT Mono', monospace; font-size: 0.8rem;">
              <option value="">TIPO DE CONSULTA</option>
              <option value="reparacion">REPARACIÓN</option>
              <option value="retoma">PLAN RETOMA</option>
              <option value="garantia">GARANTÍA</option>
            </select>
            <textarea placeholder="CUÉNTANOS QUÉ NECESITAS..." rows="4" style="background: transparent; border: 0.85px solid rgba(255,255,255,0.2); padding: 15px; border-radius: 12px; color: #FFF; font-family: 'Inter', sans-serif;"></textarea>
            <button style="background: #4A90E2; color: #FFF; border: none; padding: 18px; border-radius: 50px; font-weight: 700; cursor: pointer; font-family: 'Inter', sans-serif; letter-spacing: 1px;">ENVIAR MENSAJE</button>
          </form>
        </div>
      </div>
    </section>

    {/* UBICACIÓN Y LOGÍSTICA */}
    <ContactLocation />

    {/* CHECKLIST */}
    <ContactChecklist />

    {/* FAQ */}
    <ContactFAQ />

    {/* CTA FINAL */}
    <ContactCTA />

  </main>

  <FloatingContact client:load />
  <Footer client:load />
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=PT+Mono&display=swap');

  body {
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .hover-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
    border-color: #4A90E2 !important;
  }

  input:focus, textarea:focus, select:focus {
    outline: none;
    border-color: #4A90E2 !important;
  }

  @media (max-width: 1100px) {
    div[style*="grid-template-columns"] {
      grid-template-columns: 1fr !important;
      gap: 40px !important;
    }
    div[style*="padding: 0 80px"] {
      padding: 0 25px !important;
    }
    h1 {
      font-size: 3rem !important;
    }
  }
</style>

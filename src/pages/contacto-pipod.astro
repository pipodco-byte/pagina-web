---
import Layout from '../layouts/Layout.astro';
import PipodNavbar from '../components/pipodNavbar';
import Footer from '../components/pipodFooter';
import FloatingContact from '../layouts/floatingContact';
import ContactoBanner from '../components/contacto/ContactoBanner.astro';
import ContactoHero from '../components/contacto/ContactoHero.astro';
import ContactoHistory from '../components/contacto/ContactoHistory.astro';
import ContactoPhilosophy from '../components/contacto/ContactoPhilosophy.astro';
import ContactoValues from '../components/contacto/ContactoValues.astro';
import ContactoB2B from '../components/contacto/ContactoB2B.astro';
import ContactoForm from '../components/contacto/ContactoForm.astro';
import ContactLocation from '../components/contact/ContactLocation.astro';
import ContactChecklist from '../components/contact/ContactChecklist.astro';
import ContactFAQ from '../components/contact/ContactFAQ.astro';
import ContactCTA from '../components/contact/ContactCTA.astro';
import '../../assets/scss/astro-ecommerce.scss';

const title = "Servicio Técnico Apple Chapinero | PIPOD";
const description = "Reparación MacBook, iPhone, iPad en Bogotá. Microsoldadura, garantía real y plan retoma. Desde 2009 rescatando tecnología.";
---

<Layout title={title} description={description}>
  <PipodNavbar client:load />
  
  <main style="padding-top: 120px; background: #FFFFFF;">
    <ContactoBanner />
    <ContactoHero />
    <ContactoHistory />
    <ContactoPhilosophy />
    <ContactoValues />
    <ContactoB2B />
    <ContactoForm />
    <ContactLocation />
    <ContactChecklist />
    <ContactFAQ />
    <ContactCTA />
  </main>

  <FloatingContact client:load />
  <Footer client:load />
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=PT+Mono&display=swap');

  body {
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .hover-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
    border-color: #4A90E2 !important;
  }

  input:focus, textarea:focus, select:focus {
    outline: none;
    border-color: #4A90E2 !important;
  }

  @media (max-width: 1100px) {
    div[style*="grid-template-columns"] {
      grid-template-columns: 1fr !important;
      gap: 40px !important;
    }
    div[style*="padding: 0 80px"] {
      padding: 0 25px !important;
    }
    h1 {
      font-size: 3rem !important;
    }
  }
</style>

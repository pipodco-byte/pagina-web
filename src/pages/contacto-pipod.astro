---
import Layout from '../layouts/Layout.astro';
import PipodNavbar from '../components/pipodNavbar';
import Footer from '../components/pipodFooter';
import FloatingContact from '../layouts/floatingContact';
import ContactPageSchema from '../components/SEO/ContactPageSchema.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import ContactHistory from '../components/contact/ContactHistory.astro';
import ContactPhilosophy from '../components/contact/ContactPhilosophy.astro';
import ContactValues from '../components/contact/ContactValues.astro';
import ContactB2B from '../components/contact/ContactB2B.astro';
import ContactFormSection from '../components/contact/ContactFormSection.astro';
import ContactLocation from '../components/contact/ContactLocation.astro';
import ContactChecklist from '../components/contact/ContactChecklist.astro';
import ContactFAQ from '../components/contact/ContactFAQ.astro';
import ContactCTA from '../components/contact/ContactCTA.astro';
import '../../assets/scss/astro-ecommerce.scss';

const title = "Servicio Técnico Apple Chapinero | PIPOD";
const description = "Reparación MacBook, iPhone, iPad en Bogotá. Microsoldadura, garantía real y plan retoma. Desde 2009 rescatando tecnología.";
---

<Layout title={title} description={description}>
  <ContactPageSchema />
  <PipodNavbar client:load />
  
    <main style="background: #FFFFFF;">
    <ContactHero />
    <ContactHistory />
    <ContactPhilosophy />
    <ContactValues />
    <ContactB2B />
    <ContactFormSection />

    {/* UBICACIÓN Y LOGÍSTICA */}
    <ContactLocation />

    {/* CHECKLIST */}
    <ContactChecklist />

    {/* FAQ */}
    <ContactFAQ />

    {/* CTA FINAL */}
    <ContactCTA />

  </main>

  <FloatingContact client:load />
  <Footer client:load />
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans:wght@400;500&family=PT+Mono&display=swap');

  body {
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
  }



  @media (max-width: 1024px) {
    .pipod-history-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .pipod-history-col.pipod-separator {
      padding-left: 0;
      padding-top: 60px;
      border-left: none;
      border-top: 0.85px solid #000;
    }
  }



  @media (max-width: 768px) {
    .pipod-history-section {
      padding: 50px 0;
    }

    .pipod-container {
      padding: 0 25px;
    }

    .pipod-history-title {
      font-size: 2rem;
    }

    .pipod-history-content p {
      font-size: 1rem;
    }
  }
</style>

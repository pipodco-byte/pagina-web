---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/pipodFooter';
import FloatingContact from '../../layouts/floatingContact';
import ProductOverviewGrid from '../../components/products/productOverviewGrid';
import CardProduct from '../../components/products/cardProduct';
import ProductSchema from '../../components/SEO/ProductSchema.astro';
import { getWebProductos, getWebProductoPorSlug, getImageUrl, getStockBadge } from '../../lib/supabase/products';
import reviewsData from '../../../public/data/reviews.json';
import type { Producto } from '../../lib/contentful';

// Re-export for backwards compatibility
export async function getStaticPaths() {
  const productos = await getWebProductos();
  return productos.map(producto => ({
    params: { slug: producto.slug },
    props: { producto }
  }));
}

const { slug } = Astro.params;
const producto = await getWebProductoPorSlug(slug);
const todosProductos = await getWebProductos();
const productosRelacionados = todosProductos.filter(p => p.slug !== slug).slice(0, 4);

if (!producto) {
  return Astro.redirect('/tienda-pipod');
}

const productoAdapter: Producto = {
  id: producto.id,
  slug: producto.slug || '',
  nombre: producto.nombre,
  descripcion: producto.descripcion || '',
  precio: producto.precio_base,
  precioAnterior: producto.precio_anterior || undefined,
  condicion: producto.condicion,
  sku: producto.sku,
  tipo: producto.tipo,
  thumb_src: producto.imagen_principal,
  thumb_alt: producto.nombre,
  enStock: producto.cantidad > 0,
  colors: producto.variantes?.map(v => v.atributos.color || 'default') || []
};

const stockBadge = getStockBadge(producto);
const imageUrl = getImageUrl(producto);

const images = [
  { src: imageUrl, alt: producto.nombre }
];
---

<Layout title={`${producto.nombre} - Pipod`} description={producto.descripcion}>
  <ProductSchema product={{
    id: producto.id,
    name: producto.nombre,
    description: producto.descripcion,
    price: producto.precio_base,
    currency: "COP",
    image: imageUrl,
    condition: producto.condicion as 'new' | 'used' | 'refurbished',
    availability: producto.cantidad > 0 ? 'InStock' : 'PreOrder',
    brand: "Apple",
    sku: producto.sku,
    rating: parseFloat(reviewsData.rating),
    reviewCount: reviewsData.totalReviews
  }} />
  
  <main style="padding-top: 120px; background: #ffffff;">
    <div class="container mt-4">
      <nav aria-label="breadcrumb" style={{ fontFamily: "'Inter', sans-serif", fontSize: '0.85rem' }}>
        <ol style={{ 
          listStyle: 'none', 
          padding: 0, 
          margin: 0, 
          display: 'flex', 
          gap: '8px',
          alignItems: 'center'
        }}>
          <li><a href="/" style={{ color: '#86868B', textDecoration: 'none' }}>Inicio</a></li>
          <li style={{ color: '#86868B' }}>/</li>
          <li><a href="/tienda-pipod" style={{ color: '#86868B', textDecoration: 'none' }}>Tienda</a></li>
          <li style={{ color: '#86868B' }}>/</li>
          <li style={{ color: '#1F1F1F', fontWeight: 500 }}>{producto.nombre}</li>
        </ol>
      </nav>
    </div>
    
    <div class="container mt-4">
      <ProductOverviewGrid 
        client:load
        title={producto.nombre}
        colors={productoAdapter.colors || ['blue', 'gray', 'black']}
        images={images}
        full_description={producto.descripcion}
        price={producto.precio_base}
        oldPrice={producto.precio_anterior || undefined}
        highlights={[
          `SKU: ${producto.sku}`,
          `Stock: ${stockBadge.text}`
        ]}
        details={`Producto ${producto.condicion === 'usado' ? 'Seminuevo' : producto.condicion} de alta calidad. Garantía Pipod incluida.`}
        rating={parseFloat(reviewsData.rating)}
        reviews={reviewsData.totalReviews}
        sizes={{}}
        tipo={producto.tipo}
        condition={producto.condicion}
        categoria={producto.categoria || undefined}
        marca={producto.marca || 'Apple'}
        id={producto.id}
        slug={producto.slug}
      />

      <hr class="dark horizontal my-5" />

      <div class="row">
        <h5 class="mb-4">Productos Relacionados</h5>
        {productosRelacionados.map(prod => (
          <div class="col-12 col-md-6 col-lg-3 mb-4">
            <CardProduct
              thumb_src={prod.imagen_principal}
              thumb_alt={prod.nombre}
              color={prod.variantes?.[0]?.atributos?.color}
              colors={prod.variantes?.map(v => v.atributos.color || 'default')}
              title={prod.nombre}
              description={prod.descripcion}
              price={prod.precio_base}
              oldPrice={prod.precio_anterior}
              condition={prod.condicion}
              rating={4}
              batteryHealth={undefined}
              slug={prod.slug}
              tipo={prod.tipo}
            />
          </div>
        ))}
      </div>
    </div>

    <FloatingContact client:load />
    <Footer client:load />
  </main>
</Layout>

<style is:global>
  body {
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
    background: #ffffff;
    color: #1F1F1F;
  }

  main .footer-pipod {
    padding-left: 15px;
    padding-right: 15px;
  }
  
  .btn-dark {
    background-color: #000000;
    border: none;
    border-radius: 50px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    padding: 14px 28px;
    transition: background-color 0.2s ease;
  }
  
  .btn-dark:hover {
    background-color: #1F1F1F;
  }
</style>

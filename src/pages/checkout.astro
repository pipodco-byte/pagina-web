---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/pipodFooter';
import CheckoutForm from '../components/checkout/CheckoutForm';
---

<Layout title="Checkout - Pipod" description="Completa tu compra en Pipod">
  
  <main style="padding-top: 120px; padding-bottom: 60px;">
    <div class="container">
      <div style="max-width: 1200px; margin: 0 auto;">
        <h1 style="margin-bottom: 40px; font-size: 32px; font-weight: 700;">Finalizar Compra</h1>
        
        <CheckoutForm client:load />
      </div>
    </div>
  </main>

  <Footer client:load />
</Layout>

<style>
  main {
    background: #FFFFFF;
    min-height: calc(100vh - 200px);
  }
</style>

{/* CONTACTO */}
<section id="contacto" style="padding: 100px 0; background: #1a1a1a; color: #FFFFFF; border-bottom: 0.85px solid #000;">
  <div style="max-width: 1440px; margin: 0 auto; padding: 0 80px; display: grid; grid-template-columns: 1fr 1fr; gap: 80px;">
    <div>
      <span style="font-family: 'PT Mono', monospace; font-size: 0.7rem; color: #4A90E2; letter-spacing: 2px; text-transform: uppercase;">CANALES DE CONTACTO Y UBICACIÓN</span>
      <h2 style="font-family: 'Inter', sans-serif; font-size: 3.5rem; font-weight: 800; margin: 20px 0 40px; line-height: 1.1;">Hablemos con claridad.</h2>
      
      <div style="margin-bottom: 40px;">
        <h3 style="font-family: 'PT Mono', monospace; font-size: 0.8rem; color: #888; margin-bottom: 15px; letter-spacing: 1px;">UBICACIÓN</h3>
        <p style="margin-bottom: 20px; font-size: 1rem; line-height: 1.6;">Cra. 13a #79-52, Chapinero, Bogotá.</p>
      </div>
      
      <div style="margin-bottom: 40px;">
        <h3 style="font-family: 'PT Mono', monospace; font-size: 0.8rem; color: #888; margin-bottom: 15px; letter-spacing: 1px;">HORARIO</h3>
        <p style="font-size: 1rem; line-height: 1.6;">Lunes a Sábado, 10:00 AM - 7:00 PM.</p>
      </div>
      
      <div>
        <h3 style="font-family: 'PT Mono', monospace; font-size: 0.8rem; color: #888; margin-bottom: 15px; letter-spacing: 1px;">COMPROMISO</h3>
        <p style="font-size: 1rem; line-height: 1.6;">Respuesta garantizada en máximo 2 horas para que tu operación no se detenga.</p>
      </div>
    </div>

    <div style="background: rgba(255,255,255,0.05); border: 0.85px solid rgba(255,255,255,0.25); border-radius: 24px; padding: 50px; backdrop-filter: blur(14px);">
      <form style="display: grid; gap: 24px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
          <input type="text" placeholder="NOMBRE" style="background: transparent; border: 0.85px solid rgba(255,255,255,0.2); padding: 15px; border-radius: 12px; color: #FFF; font-family: 'PT Mono', monospace; font-size: 0.8rem;" />
          <input type="email" placeholder="EMAIL" style="background: transparent; border: 0.85px solid rgba(255,255,255,0.2); padding: 15px; border-radius: 12px; color: #FFF; font-family: 'PT Mono', monospace; font-size: 0.8rem;" />
        </div>
        <select style="background: #1a1a1a; border: 0.85px solid rgba(255,255,255,0.2); padding: 15px; border-radius: 12px; color: #FFF; font-family: 'PT Mono', monospace; font-size: 0.8rem;">
          <option value="">TIPO DE CONSULTA</option>
          <option value="reparacion">REPARACIÓN</option>
          <option value="retoma">PLAN RETOMA</option>
          <option value="garantia">GARANTÍA</option>
        </select>
        <textarea placeholder="CUÉNTANOS QUÉ NECESITAS..." rows="4" style="background: transparent; border: 0.85px solid rgba(255,255,255,0.2); padding: 15px; border-radius: 12px; color: #FFF; font-family: 'Inter', sans-serif;"></textarea>
        <button style="background: #4A90E2; color: #FFF; border: none; padding: 18px; border-radius: 50px; font-weight: 700; cursor: pointer; font-family: 'Inter', sans-serif; letter-spacing: 1px;">ENVIAR MENSAJE</button>
      </form>
    </div>
  </div>
</section>

<style>
  input:focus, textarea:focus, select:focus {
    outline: none;
    border-color: #4A90E2 !important;
  }
</style>

---
---

<section id="contacto" style="padding: 60px 0; background: #1a1a1a; color: #FFFFFF;">
  <div style="max-width: 1440px; margin: 0 auto; padding: 0 80px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px;">
    <div style="display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <h3 style="font-family: 'Inter', sans-serif; font-size: clamp(1.5rem, 5vw, 2.5rem); font-weight: 900; letter-spacing: -1px; text-transform: uppercase; margin: 0 0 40px 0; color: #FFFFFF;">Síguenos</h3>
        <div style="display: flex; gap: 50px; align-items: center; flex-wrap: wrap;">
          <a href="https://wa.me/573124813094" target="_blank" style="color: #FFFFFF; font-size: 60px; text-decoration: none; transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1); display: inline-block;" class="social-icon-large"><i class="bi bi-whatsapp"></i></a>
          <a href="https://www.instagram.com/pipod.co" target="_blank" style="color: #FFFFFF; font-size: 60px; text-decoration: none; transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1); display: inline-block;" class="social-icon-large"><i class="bi bi-instagram"></i></a>
          <a href="https://www.tiktok.com/@pipodstore" target="_blank" style="color: #FFFFFF; font-size: 60px; text-decoration: none; transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1); display: inline-block;" class="social-icon-large"><i class="bi bi-tiktok"></i></a>
          <a href="https://www.facebook.com/pipod.co" target="_blank" style="color: #FFFFFF; font-size: 60px; text-decoration: none; transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1); display: inline-block;" class="social-icon-large"><i class="bi bi-facebook"></i></a>
        </div>
      </div>
      <div style="margin-top: 40px;"></div>
    </div>

    <form id="contactForm" style="display: grid; gap: 0;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <input type="text" id="nombre" placeholder="NOMBRE" style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.1); padding: 12px 20px; border-radius: 10px; color: #D0D0D0; font-family: 'PT Mono', monospace; font-size: 0.8rem; transition: all 0.3s;" required />
          <input type="email" id="email" placeholder="EMAIL" style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.1); padding: 12px 20px; border-radius: 10px; color: #D0D0D0; font-family: 'PT Mono', monospace; font-size: 0.8rem; transition: all 0.3s;" required />
        </div>
        <select id="tipoConsulta" style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.1); padding: 12px 20px; border-radius: 10px; color: #D0D0D0; font-family: 'PT Mono', monospace; font-size: 0.8rem; transition: all 0.3s; margin-top: 16px;" required>
          <option value="">TIPO DE CONSULTA</option>
          <option value="reparacion">REPARACIÓN</option>
          <option value="retoma">PLAN RETOMA</option>
          <option value="garantia">GARANTÍA</option>
        </select>
        <textarea id="mensaje" placeholder="CUÉNTANOS QUÉ NECESITAS..." rows="3" style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.1); padding: 12px 20px; border-radius: 10px; color: #D0D0D0; font-family: 'PT Mono', monospace; font-size: 0.8rem; transition: all 0.3s; resize: none; margin-top: 16px;" required></textarea>
        <div style="display: flex; justify-content: flex-end; margin-top: 16px;">
          <button type="button" onclick="enviarWhatsApp()" style="background: #FFFFFF; color: #1a1a1a; border: none; padding: 10px 32px; border-radius: 50px; font-weight: 700; cursor: pointer; font-family: 'Inter', sans-serif; letter-spacing: 1px; font-size: 0.8rem; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: 0 10px 30px rgba(0,0,0,0.2);" class="btn-enviar">ENVIAR</button>
        </div>
    </form>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@700;900&family=PT+Mono&display=swap');

  input:focus, textarea:focus, select:focus {
    outline: none;
    border-color: #4A90E2 !important;
    background: rgba(255,255,255,0.05) !important;
  }

  .social-icon-large:hover {
    transform: scale(1.15) translateY(-8px);
    opacity: 0.8;
  }

  .btn-enviar:hover {
    transform: scale(1.05) translateY(-3px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    background: #f8f9fa;
  }

  @media (max-width: 768px) {
    #contacto {
      padding: 40px 0 !important;
    }

    #contacto > div {
      padding: 0 24px !important;
      grid-template-columns: 1fr !important;
      gap: 32px !important;
    }

    #contacto h3 {
      font-size: 1.5rem !important;
      margin-bottom: 24px !important;
    }

    #contacto > div > div:first-child {
      justify-content: flex-start !important;
    }

    #contacto > div > div:first-child > div:first-child {
      width: 100%;
    }

    #contacto > div > div:first-child div[style*="display: flex; gap: 50px"] {
      gap: 24px !important;
      justify-content: flex-start !important;
      flex-wrap: wrap !important;
    }

    #contacto > div > div:first-child a {
      font-size: 40px !important;
    }

    #contactForm {
      width: 100%;
    }

    #contactForm > div:first-child {
      grid-template-columns: 1fr !important;
      gap: 12px !important;
    }

    #contactForm input,
    #contactForm select,
    #contactForm textarea {
      font-size: 0.9rem !important;
      padding: 10px 16px !important;
    }

    #contactForm > div:last-child {
      justify-content: center !important;
    }

    .btn-enviar {
      padding: 10px 24px !important;
      font-size: 0.85rem !important;
    }
  }
</style>

<script is:inline>
  function enviarWhatsApp() {
    const nombre = document.getElementById('nombre').value.trim();
    const email = document.getElementById('email').value.trim();
    const tipoConsulta = document.getElementById('tipoConsulta').value;
    const mensaje = document.getElementById('mensaje').value.trim();

    if (!nombre || !email || !mensaje) {
      alert('Por favor, completa todos los campos. \uD83C\uDF4E');
      return;
    }

    // Definimos los emojis por su código Unicode para evitar errores de símbolos 
    const apple = '\uD83C\uDF4E'; // 🍎
    const user = '\uD83D\uDC64';  // 👤
    const mail = '\uD83D\uDCE7';  // 📧
    const tag = '\uD83C\uDFF7';   // 🏷️
    const chat = '\uD83D\uDCAC';  // 💬

    const tipoEmoji = {
      'reparacion': '\uD83D\uDD27', // 🔧
      'retoma': '\uD83D\uDD04',     // 🔄
      'garantia': '\u2705'          // ✅
    };

    const emojiDinamico = tipoEmoji[tipoConsulta] || mail;
    const tipoLabel = tipoConsulta.charAt(0).toUpperCase() + tipoConsulta.slice(1);

    // Construimos el mensaje usando los códigos seguros
    const mensaje_completo = 
      `${apple} *NUEVO CONTACTO | Pipod.co*\n` +
      `----------------------------------\n` +
      `${user} *Nombre:* ${nombre}\n` +
      `${mail} *Email:* ${email}\n` +
      `${tag} *Asunto:* ${tipoLabel} ${emojiDinamico}\n\n` +
      `${chat} *Consulta:*\n"${mensaje}"\n` +
      `----------------------------------\n` +
      `_Enviado desde el formulario web_`;

    const textoWhatsApp = encodeURIComponent(mensaje_completo);
    const numeroWhatsApp = '573124813094';
    
    window.open(`https://wa.me/${numeroWhatsApp}?text=${textoWhatsApp}`, '_blank');
  }
</script>


---
---

<section style="padding: 80px 0; background: #1a1a1a;">
  <div style="max-width: 1440px; margin: 0 auto; padding: 0 80px;">
    <div style="text-align: left; margin-bottom: 50px;">
      <h2 style="font-family: 'Inter', sans-serif; font-size: clamp(1.5rem, 5vw, 2.5rem); font-weight: 900; letter-spacing: -1px; text-transform: uppercase; margin: 0; color: #FFFFFF;">Antes de Visitarnos</h2>
    </div>
    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 40px;">
      <div class="checklist-card">
        <div class="checklist-icon-wrapper">
          <i class="bi bi-cloud-check checklist-icon"></i>
        </div>
        <h5 class="checklist-title">Realiza un backup</h5>
        <p class="checklist-desc">Sincroniza con iCloud o Time Machine</p>
      </div>

      <div class="checklist-card">
        <div class="checklist-icon-wrapper">
          <i class="bi bi-shield-lock checklist-icon"></i>
        </div>
        <h5 class="checklist-title">Desactiva Find My</h5>
        <p class="checklist-desc">Buscar mi iPhone/Mac, evita bloqueos</p>
      </div>

      <div class="checklist-card">
        <div class="checklist-icon-wrapper">
          <i class="bi bi-lightning-charge checklist-icon"></i>
        </div>
        <h5 class="checklist-title">Trae tu cargador</h5>
        <p class="checklist-desc">Especialmente importante para fallos de encendido en Mac</p>
      </div>
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@800;900&display=swap');

  .checklist-card {
    text-align: center;
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    padding: 20px;
  }

  .checklist-card:hover {
    transform: translateY(-8px);
  }

  .checklist-icon-wrapper {
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .checklist-icon {
    font-size: 50px;
    color: #FFFFFF;
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .checklist-card:hover .checklist-icon {
    transform: scale(1.1);
  }

  .checklist-title {
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 1rem;
    color: #FFFFFF;
    letter-spacing: -0.5px;
    margin: 0 0 12px 0;
    text-transform: uppercase;
  }

  .checklist-desc {
    color: #FFFFFF;
    font-size: 0.9375rem;
    line-height: 1.7;
    max-width: 260px;
    font-weight: 400;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    div[style*="grid-template-columns: 1fr 1fr 1fr"] {
      grid-template-columns: 1fr 1fr !important;
      gap: 30px !important;
    }
  }

  @media (max-width: 768px) {
    div[style*="grid-template-columns: 1fr 1fr 1fr"] {
      grid-template-columns: 1fr !important;
      gap: 30px !important;
    }
  }
</style>

---
// PalafitDonation.astro
---

<section id="donar" class="content-section">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card-highlight">
          <h2 class="fw-bold mb-4 text-center">Elige tu forma de donar</h2>
          
          <div class="row g-3 mb-5">
            <div class="col-md-6">
              <a href="https://wa.me/573124813094?text=Quiero%20donar%20a%20El%20Palafito%20de%20Don%20Gu" class="donation-link">
                <i class="bi bi-whatsapp"></i>
                <h5>WhatsApp</h5>
                <p>Contacta directamente</p>
              </a>
            </div>
            <div class="col-md-6">
              <a href="mailto:elpalafitodedongu@gmail.com" class="donation-link">
                <i class="bi bi-envelope"></i>
                <h5>Email</h5>
                <p>Envía tu consulta</p>
              </a>
            </div>
          </div>

          <div class="info-box">
            <h5 class="fw-bold mb-3">Información de Contacto</h5>
            <ul class="contact-list">
              <li><strong>TikTok:</strong> @elpalafitodedongu</li>
              <li><strong>Email:</strong> elpalafitodedongu@gmail.com</li>
              <li><strong>YouTube:</strong> El Palafito de Don Gu</li>
              <li><strong>Facebook:</strong> El Palafito de Don Gu</li>
            </ul>
            <p class="text-muted small mt-3">Todas las donaciones son deducibles de impuestos. Solicita tu certificado de donación.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .content-section {
    padding: 80px 0;
  }

  .card-highlight {
    background: #F9F9F9;
    padding: 40px;
    border-radius: 20px;
    border: 1px solid #E0E0E0;
  }

  .donation-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 30px;
    background: white;
    border: 2px solid #E0E0E0;
    border-radius: 15px;
    text-decoration: none;
    color: #000;
    transition: all 0.3s ease;
  }

  .donation-link:hover {
    border-color: #3A506B;
    box-shadow: 0 8px 20px rgba(58, 80, 107, 0.1);
  }

  .donation-link i {
    font-size: 2.5rem;
    color: #3A506B;
    margin-bottom: 15px;
  }

  .donation-link h5 {
    margin: 0 0 5px 0;
    font-weight: 700;
  }

  .donation-link p {
    margin: 0;
    font-size: 0.9rem;
    color: #999;
  }

  .info-box {
    background: white;
    padding: 20px;
    border-radius: 10px;
    border-left: 4px solid #3A506B;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .contact-list li {
    margin-bottom: 10px;
    font-size: 0.95rem;
  }
</style>

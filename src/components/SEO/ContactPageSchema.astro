---
import JsonLdSchema from './JsonLdSchema.astro';
import reviewsData from '../../data/reviews.json';

const today = new Date().toISOString().split('T')[0];
const publishDate = "2026-02-12";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "https://www.pipod.co/contacto-pipod",
  "mainEntityOfPage": "https://www.pipod.co/contacto-pipod",
  "name": "Contacto - Servicio Técnico Apple Pipod",
  "description": "Ponte en contacto con Pipod, tu aliado técnico especializado en Apple. Ubicados en Chapinero, Bogotá. Respuesta garantizada en máximo 2 horas.",
  "url": "https://www.pipod.co/contacto-pipod",
  "image": "https://www.pipod.co/images/servicio-tecnico-apple-pipod.webp",
  
  "mainEntity": {
    "@type": "LocalBusiness",
    "@id": "https://www.pipod.co/#business",
    "name": "Pipod - Servicio Técnico Apple",
    "url": "https://www.pipod.co",
    "logo": "https://www.pipod.co/images/logo.jpg",
    "telephone": "+573124813094",
    "email": "hola@pipod.co",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Cra. 13a #79-52",
      "addressLocality": "Chapinero",
      "addressRegion": "Bogotá D.C.",
      "postalCode": "110221",
      "addressCountry": "CO"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 4.6658,
      "longitude": -74.0578
    },
    // REINCORPORADO: Ahora Google sí lo aceptará aquí
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "contactType": "Technical Support",
        "telephone": "+573124813094",
        "email": "soporte@pipod.co",
        "name": "Soporte Técnico Pipod"
      },
      {
        "@type": "ContactPoint",
        "contactType": "Sales",
        "email": "ventas@pipod.co",
        "name": "Ventas Pipod"
      }
    ],
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "10:00",
        "closes": "19:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": "Saturday",
        "opens": "10:00",
        "closes": "18:00"
      }
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": reviewsData.rating,
      "reviewCount": reviewsData.totalReviews.toString(),
      "bestRating": "5",
      "worstRating": "1"
    },
    "hasMap": "https://maps.app.goo.gl/vVsKwJXwAza4Tppg6"
  },

  "copyrightHolder": { "@id": "https://www.pipod.co/#business" },
  "hasMap": "https://maps.app.goo.gl/vVsKwJXwAza4Tppg6",
  "datePublished": publishDate,
  "dateModified": today,

  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Inicio",
        "item": "https://www.pipod.co"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Contacto",
        "item": "https://www.pipod.co/contacto-pipod"
      }
    ]
  }
};
---

<JsonLdSchema schema={contactPageSchema} type="ContactPage" />
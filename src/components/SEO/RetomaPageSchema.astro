---
import JsonLdSchema from './JsonLdSchema.astro';

const today = new Date().toISOString().split('T')[0];
const publishDate = "2026-02-12";
const reviewsData = await fetch('http://localhost:3000/data/reviews.json').then(r => r.json()).catch(() => ({ rating: "5.0", totalReviews: 63 }));

const retomaPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.pipod.co/plan-retoma-apple",
  "mainEntityOfPage": "https://www.pipod.co/plan-retoma-apple",
  "name": "Plan Retoma Apple Pipod - Cambia tu iPhone, MacBook o iPad",
  "description": "Recibimos tu equipo Apple usado como parte de pago. Valoración inmediata y segura en Bogotá. Renueva tu iPhone o Mac en Chapinero y Usaquén.",
  "url": "https://www.pipod.co/plan-retoma-apple",
  "image": "https://www.pipod.co/images/logo.jpg",
  
  "mainEntity": {
    "@type": "LocalBusiness",
    "@id": "https://www.pipod.co/#business",
    "name": "Pipod",
    "telephone": "+573124813094",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Cra. 13a #79-52",
      "addressLocality": "Chapinero",
      "addressRegion": "Bogotá D.C.",
      "addressCountry": "CO"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": reviewsData.rating,
      "reviewCount": reviewsData.totalReviews.toString(),
      "bestRating": "5",
      "worstRating": "1"
    },
    "areaServed": [
      { "@type": "City", "name": "Bogotá" },
      { "@type": "AdministrativeArea", "name": "Chapinero" },
      { "@type": "AdministrativeArea", "name": "Usaquén" }
    ],
    "hasMap": "https://maps.app.goo.gl/vVsKwJXwAza4Tppg6",
    "hasMap": "https://maps.app.goo.gl/vVsKwJXwAza4Tppg6",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Catálogo Plan Retoma",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Retoma de iPhone",
            "description": "Valoración de modelos iPhone 11 en adelante para renovación."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Retoma de MacBook",
            "description": "Cambio de MacBook Air o Pro por modelos nuevos o superiores."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Valoración Técnica de Usados",
            "description": "Evaluación funcional y cosmética inmediata para toma como parte de pago."
          }
        }
      ]
    }
  },

  "publisher": { "@id": "https://www.pipod.co/#business" },
  "datePublished": publishDate,
  "dateModified": today,

  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.pipod.co" },
      { "@type": "ListItem", "position": 2, "name": "Plan Retoma", "item": "https://www.pipod.co/plan-retoma-apple" }
    ]
  }
};
---

<JsonLdSchema schema={retomaPageSchema} type="WebPage" />
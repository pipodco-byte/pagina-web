          "@type": "Offer",
          "itemOffered": {
            "@type": "Product",
            "name": "Cables y Adaptadores",
            "description": "Cables Lightning, USB-C y adaptadores"
          }
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": servicePageId,
      "name": "Servicio Técnico Apple Bogotá | PIPOD - Baterías y Pantallas",
      "description": "Especialistas en baterías y pantallas Apple. 2,000+ baterías reemplazadas. Express 2h para iPhone. Garantía 6 meses. Bogotá.",
      "url": servicePageUrl,
      "mainEntity": { "@id": "https://www.pipod.co/#business" },
      "publisher": { "@id": "https://www.pipod.co/#business" },
      "datePublished": publishDate,
      "dateModified": today,
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbDevice 
          ? [
              { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.pipod.co" },
              { "@type": "ListItem", "position": 2, "name": "Servicio Técnico", "item": "https://www.pipod.co/servicio-tecnico-apple-bogota" },
              breadcrumbDevice
            ]
          : [
              { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.pipod.co" },
              { "@type": "ListItem", "position": 2, "name": "Servicio Técnico", "item": "https://www.pipod.co/servicio-tecnico-apple-bogota" }

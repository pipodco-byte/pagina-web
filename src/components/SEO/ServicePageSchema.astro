---
import JsonLdSchema from './JsonLdSchema.astro';
import reviewsData from '../../../public/data/reviews.json';

interface Props {
  pageName?: string;
  pageUrl?: string;
}

const { pageName = '', pageUrl = '' } = Astro.props;

const today = new Date().toISOString().split('T')[0];
const publishDate = "2026-02-12";

const baseUrl = 'https://www.pipod.co';
const servicePageUrl = pageUrl || `${baseUrl}/servicio-tecnico-apple-bogota`;
const servicePageId = pageName ? `${baseUrl}/servicio-tecnico-apple-bogota/${pageName}` : servicePageUrl;

const displayNames: Record<string, string> = {
  'iphone': 'iPhone',
  'macbook': 'MacBook',
  'ipad': 'iPad',
  'imac': 'iMac',
  'apple-watch': 'Apple Watch',
  'mantenimiento': 'Mantenimiento'
};

const breadcrumbDevice = pageName 
  ? { 
      "@type": "ListItem", 
      "position": 3, 
      "name": displayNames[pageName] || pageName.charAt(0).toUpperCase() + pageName.slice(1), 
      "item": servicePageId 
    }
  : null;

const hubSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": "https://www.pipod.co/#business",
      "name": "Pipod - Servicio Técnico Apple",
      "alternateName": "Pipod",
      "url": "https://www.pipod.co",
      "logo": "https://www.pipod.co/images/logo.jpg",
      "description": "Expertos en venta y reparación de productos Apple en Bogotá. Servicio técnico especializado, diagnóstico gratis y garantía en todas nuestras reparaciones.",
      "email": "info@pipod.co",
      "telephone": "+573124813094",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Cra. 13a #79-52",
        "addressLocality": "Chapinero",
        "addressRegion": "Bogotá D.C.",
        "postalCode": "110221",
        "addressCountry": "CO"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 4.6658,
        "longitude": -74.0578
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": reviewsData.rating,
        "reviewCount": reviewsData.totalReviews.toString(),
        "bestRating": "5",
        "worstRating": "1"
      },
      "areaServed": [
        { "@type": "City", "name": "Bogotá" },
        { "@type": "AdministrativeArea", "name": "Chapinero" },
        { "@type": "AdministrativeArea", "name": "Usaquén" },
        { "@type": "AdministrativeArea", "name": "Zona Norte de Bogotá" }

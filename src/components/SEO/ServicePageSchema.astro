      "description": "Reparación experta de iPhone, MacBook, iPad y Apple Watch en Bogotá. Especialistas en microsoldadura, pantallas y baterías con garantía de 6 meses en reparación general.",
      "provider": { "@id": "https://www.pipod.co/#business" },
      "areaServed": {
        "@type": "City",
        "name": "Bogotá"
      },
      "hasOfferCatalog": {

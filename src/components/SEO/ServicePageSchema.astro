      "hasMap": "https://maps.app.goo.gl/vVsKwJXwAza4Tppg6",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "10:00",
          "closes": "19:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "10:00",
          "closes": "18:00"
        }
      ],
      "sameAs": [
        "https://www.instagram.com/pipod.co",
        "https://www.facebook.com/pipod.co",
        "https://www.tiktok.com/@pipodstore",
        "https://wa.me/573124813094",
        "https://g.page/r/CRgj2kSrZTO4EBM/review"
      ]
    },
    {
      "@type": "Service",
      "@id": "https://www.pipod.co/#service-repair",

---
// src/components/SEO/TermsPageSchema.astro
import JsonLdSchema from './JsonLdSchema.astro';

// Usamos fechas dinámicas para que Google vea que el sitio está vivo
const today = new Date().toISOString().split('T')[0];
const publishDate = "2026-02-12"; 

const termsPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.pipod.co/terminos-condiciones-pipod",
  "mainEntityOfPage": "https://www.pipod.co/terminos-condiciones-pipod",
  "name": "Términos y Condiciones - PIPOD",
  "description": "Términos y condiciones de uso del sitio web y servicios de PIPOD, servicio técnico especializado en Apple.",
  "about": {"@type": "Thing", "name": "Términos de Servicio"},
  "url": "https://www.pipod.co/terminos-condiciones-pipod",
  "image": "https://www.pipod.co/images/logo.jpg",
  
  "isPartOf": {
    "@type": "WebSite",
    "@id": "https://www.pipod.co/#website",
    "name": "PIPOD - Servicio Técnico Apple",
    "url": "https://www.pipod.co"
  },
  
  "publisher": {
    "@type": "LocalBusiness", 
    "@id": "https://www.pipod.co/#business",
    "name": "PIPOD",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.pipod.co/images/logo.jpg"
    }
  },

  "author": {
    "@id": "https://www.pipod.co/#business"
  },

  "datePublished": publishDate,
  "dateModified": today,

  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Inicio",
        "item": "https://www.pipod.co"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Términos y Condiciones",
        "item": "https://www.pipod.co/terminos-condiciones-pipod"
      }
    ]
  },

  "inLanguage": "es-CO"
};
---

<JsonLdSchema schema={termsPageSchema} type="WebPage" />
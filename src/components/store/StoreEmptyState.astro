---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  backgroundImage?: string;
}

const { title, subtitle, description, backgroundImage } = Astro.props;
---

<section class="store-empty-state" style={backgroundImage ? `background-image: url('${backgroundImage}')` : ''}>
  <div class="empty-overlay"></div>
  <div class="empty-content">
    <div class="empty-icon">📦</div>
    <h2 class="empty-title">{title}</h2>
    <p class="empty-subtitle">{subtitle}</p>
    <p class="empty-description">{description}</p>
    <a href="https://wa.me/573124813094" class="empty-cta">
      Consultar por WhatsApp
    </a>
  </div>
</section>

<style>
  .store-empty-state {
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 24px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    margin: 60px 0;
  }

  .empty-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(245, 245, 247, 0.9) 100%);
    z-index: 1;
  }

  .empty-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 60px 40px;
    max-width: 500px;
  }

  .empty-icon {
    font-size: 4rem;
    margin-bottom: 24px;
    animation: bounce 2s infinite;
  }

  .empty-title {
    font-family: 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #1D1D1F;
    margin: 0 0 12px 0;
    letter-spacing: -0.02em;
  }

  .empty-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    color: #555;
    margin: 0 0 16px 0;
    font-weight: 500;
  }

  .empty-description {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: #86868B;
    margin: 0 0 32px 0;
    line-height: 1.6;
  }

  .empty-cta {
    display: inline-block;
    background: #000;
    color: #fff;
    padding: 14px 40px;
    border-radius: 50px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .empty-cta:hover {
    background: #0066cc;
    transform: translateY(-2px);
    box-shadow: 0 15px 40px rgba(0, 102, 204, 0.2);
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @media (max-width: 768px) {
    .store-empty-state {
      min-height: 400px;
      margin: 40px 0;
    }

    .empty-content {
      padding: 40px 24px;
    }

    .empty-icon {
      font-size: 3rem;
    }

    .empty-title {
      font-size: 1.5rem;
    }

    .empty-subtitle {
      font-size: 1rem;
    }
  }
</style>

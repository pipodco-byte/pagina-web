---
// NoResults.astro
interface Props {
  title?: string;
  message?: string;
  buttonText?: string;
}

const { 
  title = "No encontramos lo que buscas", 
  message = "Intenta ajustando los filtros o el rango de precio para encontrar el equipo ideal.",
  buttonText = "Limpiar filtros"
} = Astro.props;
---

<div class="no-results-container">
  <div class="icon-wrapper">
    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
  </div>
  
  <h3 class="no-results-title">{title}</h3>
  <p class="no-results-message">{message}</p>
  
  <button class="reset-btn" onclick="window.location.reload()">
    {buttonText}
  </button>
</div>

<style>
  .no-results-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 80px 40px;
    width: 100%;
    text-align: center;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .icon-wrapper {
    color: #1D1D1F;
    margin-bottom: 32px;
    display: inline-flex;
  }

  .no-results-title {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 1.75rem;
    font-weight: 600;
    color: #1D1D1F;
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }

  .no-results-message {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: #555555;
    margin: 0 0 40px 0;
    max-width: 420px;
    margin-left: auto;
    margin-right: auto;
  }

  .reset-btn {
    appearance: none;
    border: none;
    background: #4A90E2;
    color: #FFFFFF;
    padding: 12px 40px;
    border-radius: 100px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reset-btn:hover {
    background: #3A506B;
    transform: translateY(-2px);
  }

  .reset-btn:active {
    transform: translateY(0);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 480px) {
    .no-results-container {
      padding: 60px 24px;
    }
    
    .no-results-title {
      font-size: 1.5rem;
    }

    .no-results-message {
      font-size: 0.95rem;
    }
  }
</style>

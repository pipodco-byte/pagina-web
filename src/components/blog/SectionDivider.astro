---
/**
 * SectionDivider.astro - Fade pattern divider component
 *
 * Phanatik-style section divider with fade pattern:
 * - 24px height container
 * - 2px solid line in center (70% width)
 * - Fade to transparent on both ends
 * - Uses Pipod's border gray color (#E5E5E7)
 */

interface Props {
  class?: string;
  id?: string;
}

const { class: className = '', id } = Astro.props;
---

<div class={`section-divider ${className}`.trim()} id={id} aria-hidden="true">
  <div class="section-divider__line"></div>
</div>

<style>
  .section-divider {
    width: 100%;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .section-divider__line {
    width: 70%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--pipod-border-gray, #E5E5E7) 15%,
      var(--pipod-border-gray, #E5E5E7) 85%,
      transparent 100%
    );
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .section-divider__line {
      width: 85%;
    }
  }
</style>

---
/**
 * BlogCardCompact.astro — Horizontal compact card (Phanatik BlogCard1 pattern)
 *
 * Flex row: optional 80px image left + text right.
 * Title, category, date. Compact size.
 *
 * Props:
 *   slug: string       — Article URL path
 *   title: string      — Article title
 *   category: string   — Category badge text
 *   publishDate: string — ISO date string
 *   ogImage?: string   — Optional image path
 */

interface Props {
  slug: string;
  title: string;
  category: string;
  publishDate: string;
  ogImage?: string;
}

const { slug, title, category, publishDate, ogImage } = Astro.props;

const hasImage = !!ogImage;
const cardHref = slug ? `/blog/${slug}` : '#';

// Spanish locale date formatting: "12 may 2026"
const formattedDate = new Date(publishDate).toLocaleDateString('es-CO', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="blog-card-compact">
  <a href={cardHref} class="blog-card-compact__link" aria-label={`Leer: ${title}`}>
    {hasImage && (
      <div class="blog-card-compact__image">
        <img
          src={ogImage}
          alt={title}
          loading="lazy"
          decoding="async"
          onerror="this.style.display='none'; this.parentElement.style.background='var(--pipod-gradient-blue)'"
        />
      </div>
    )}
    <div class="blog-card-compact__content">
      <span class="blog-card-compact__category">{category}</span>
      <h3 class="blog-card-compact__title">{title}</h3>
      <time class="blog-card-compact__date" datetime={publishDate}>{formattedDate}</time>
    </div>
  </a>
</article>

<style>
  .blog-card-compact {
    display: flex;
    gap: var(--pipod-space-md, 16px);

    &__link {
      text-decoration: none;
      color: inherit;
      display: flex;
      gap: var(--pipod-space-md, 16px);
      flex: 1;
      align-items: flex-start;
    }

    &__image {
      width: 80px;
      height: 80px;
      flex-shrink: 0;
      border-radius: var(--pipod-radius-subtle, 8px);
      overflow: hidden;
      background: var(--pipod-gradient-blue, linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%));

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
    }

    &__content {
      display: flex;
      flex-direction: column;
      gap: var(--pipod-space-xs, 4px);
      flex: 1;
      min-width: 0;
    }

    &__category {
      font-family: var(--pipod-font-pt-mono, 'PT Mono', monospace);
      font-size: var(--pipod-size-label, 0.7rem);
      font-weight: var(--pipod-weight-extrabold, 800);
      color: var(--pipod-color-deep-blue, #3A506B);
      text-transform: uppercase;
      letter-spacing: var(--pipod-tracking-wider, 0.05em);
    }

    &__title {
      font-family: var(--pipod-font-noto-sans, 'Noto Sans', sans-serif);
      font-size: var(--pipod-size-body, 0.95rem);
      font-weight: var(--pipod-weight-semibold, 600);
      color: var(--pipod-color-near-black, #1F1F1F);
      line-height: var(--pipod-leading-snug, 1.25);
      margin: 0;
      transition: color var(--pipod-transition-fast, 150ms ease);

      .blog-card-compact__link:hover & {
        color: var(--pipod-color-deep-blue, #3A506B);
        text-decoration: underline;
      }
    }

    &__date {
      font-family: var(--pipod-font-inter, 'Inter', sans-serif);
      font-size: var(--pipod-size-label, 0.7rem);
      color: var(--pipod-color-disabled, rgba(0, 0, 0, 0.24));
    }
  }
</style>
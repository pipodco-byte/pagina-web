---
import { PRODUCTS } from '../../data/constants';
---

<section class="products-section">
  <div class="products-container">
    <div class="products-grid">
      {PRODUCTS.map((product, i) => (
        <div class="product-card" style={`--delay: ${i * 0.4}s`}>
          <h3 class="shimmer-word">{product.label}</h3>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .products-section {
    background-color: #FFFFFF;
    border: none;
    height: 119px;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .products-container {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 80px;
  }

  .products-grid {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .product-card:hover {
    transform: translateY(-5px);
  }

  .product-card h3 {
    font-family: 'Inter', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: #000000;
    margin: 0;
  }

  @keyframes shimmerWord {
    0%, 100% { color: #1D1D1F; }
    20%, 50% { color: #0066CC; }
  }

  .shimmer-word {
    animation: shimmerWord 5s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }

  @media (max-width: 991px) {
    .products-section {
      height: auto;
      padding: 40px 0;
    }

    .products-container {
      padding: 0 25px;
    }

    .products-grid {
      flex-direction: column;
      gap: 30px;
    }

    .product-card {
      width: 100%;
    }
  }
</style>

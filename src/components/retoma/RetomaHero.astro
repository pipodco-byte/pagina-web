---
// PlanRetomaHero.astro
---

<section class="pipod-hero-immersive">
  <div class="hero-video-bg">
    <iframe
      id="hero-vimeo-player"
      src="https://player.vimeo.com/video/732211917?background=1&autoplay=1&loop=1&muted=1&api=1"
      loading="lazy"
      allow="autoplay; fullscreen"
      allowfullscreen
      title="Pipod Plan Retoma Video">
    </iframe>
    <div class="video-overlay-pro"></div>
  </div>

  <button class="sound-toggle-btn" id="soundToggle" aria-label="Activar sonido" aria-pressed="false">
    <svg class="sound-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
      <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
      <path d="M15.54 3.54a9 9 0 0 1 0 12.73M18.91 7.09a15 15 0 0 1 0 9.82" stroke-linecap="round"></path>
    </svg>
    <svg class="mute-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
      <line x1="23" y1="9" x2="17" y2="15"></line>
      <line x1="17" y1="9" x2="23" y2="15"></line>
    </svg>
  </button>

  <div class="pipod-hud-top">
    <div class="glass-tag-impact">
      PLAN RETOMA PIPOD
    </div>
    <div class="title-glass-area">
      <h1 class="hero-title-impact">
        Renueva tu<br/><span>equipo</span>
      </h1>
    </div>
  </div>

  <div class="pipod-hud-bottom">
    <p class="hero-subtitle">
      Entrega tu <strong>iPhone, MacBook o Apple Watch</strong> usado y recíbelo como parte de pago para tu próximo gran salto tecnológico.
    </p>
    <div class="hero-actions-grid">
       <a href="https://wa.me/573124813094?text=Hola%20Pipod..." class="btn-pipod-glass-primary">
        Agendar Cita
      </a>
      <a href="#como-funciona" class="btn-pipod-glass-secondary">
        Ver proceso
      </a>
    </div>
  </div>
</section>

<style>
  .pipod-hero-immersive {
    position: relative;
    width: 100%;
    height: 90vh;
    overflow: hidden;
    background: #000;
    z-index: 1;
  }

  /* --- Video Core --- */
  .hero-video-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hero-video-bg iframe {
    width: 100vw;
    height: 56.25vw;
    min-height: 100vh;
    min-width: 177.77vh;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
  }

  .video-ready { opacity: 1 !important; }

  .video-overlay-pro {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, transparent 20%),
                linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 40%),
                radial-gradient(circle at 20% 30%, rgba(0,0,0,0.4) 0%, transparent 70%);
    z-index: 2;
  }

  /* --- HUD Superior --- */
  .pipod-hud-top {
    position: absolute;
    top: 60px;
    left: 80px;
    z-index: 10;
  }

  .glass-tag-impact {
    font-family: 'PT Mono', monospace;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 0.85px solid rgba(255, 255, 255, 0.25);
    border-radius: 50px;
    padding: 12px 24px;
    font-size: 0.7rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.8);
    letter-spacing: 0.4em;
    display: inline-block;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .hero-title-impact {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 900;
    line-height: 0.9;
    color: #FFF;
    margin: 0;
    text-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  .hero-title-impact span { color: #4A90E2; }

  /* --- HUD Inferior --- */
  .pipod-hud-bottom {
    position: absolute;
    bottom: 60px;
    right: 80px;
    z-index: 10;
    max-width: 520px;
    text-align: right;
  }

  .hero-subtitle {
    font-family: 'Noto Sans', sans-serif;
    color: rgba(255,255,255,0.9);
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 32px;
    text-shadow: 0 2px 10px rgba(0,0,0,0.3);
  }

  .hero-subtitle strong { color: #FFF; font-weight: 700; }

  .hero-actions-grid {
    display: flex;
    gap: 16px;
    justify-content: flex-end;
  }

  /* --- Buttons Premium --- */
  .btn-pipod-glass-primary, .btn-pipod-glass-secondary {
    font-family: 'Inter', sans-serif;
    padding: 14px 32px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    gap: 12px;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 0.85px solid rgba(255,255,255,0.25);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-pipod-glass-primary {
    background: #4A90E2;
    color: #FFF;
    border: none;
  }

  .btn-pipod-glass-primary:hover {
    background: #357ABD;
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(74, 144, 226, 0.3);
  }

  .btn-pipod-glass-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #FFF;
  }

  .btn-pipod-glass-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-5px);
  }

  /* --- Sound Toggle --- */
  .sound-toggle-btn {
    position: absolute;
    top: 60px;
    right: 80px;
    z-index: 15;
    width: 54px;
    height: 54px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(14px);
    border: 0.85px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    cursor: pointer;
    color: #FFF;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .sound-toggle-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.05);
  }

  /* --- Media Queries --- */
  @media (max-width: 1024px) {
    .pipod-hud-top { top: 40px; left: 40px; }
    .pipod-hud-bottom { bottom: 50px; right: 40px; }
    .sound-toggle-btn { top: 40px; right: 40px; }
  }

  @media (max-width: 768px) {
    .pipod-hud-top { top: 40px; left: 20px; }
    .pipod-hud-bottom { bottom: 40px; right: 20px; left: 20px; text-align: left; }
    .hero-actions-grid { justify-content: flex-start; flex-direction: column; }
    .sound-toggle-btn { top: 40px; right: 20px; }
    .hero-title-impact { font-size: 2.8rem; }
  }

  @media (max-width: 480px) {
    .pipod-hud-top { top: 30px; left: 16px; }
    .pipod-hud-bottom { bottom: 30px; right: 16px; left: 16px; }
    .sound-toggle-btn { top: 30px; right: 16px; width: 48px; height: 48px; }
    .btn-pipod-glass-primary, .btn-pipod-glass-secondary { padding: 16px 28px; font-size: 0.85rem; }
  }
</style>

<script>
  function initVimeoControl() {
    const iframe = document.getElementById('hero-vimeo-player') as HTMLIFrameElement;
    const soundToggle = document.getElementById('soundToggle');
    if (!iframe || !soundToggle) return;

    const soundIcon = soundToggle.querySelector('.sound-icon') as HTMLElement;
    const muteIcon = soundToggle.querySelector('.mute-icon') as HTMLElement;
    let isMuted = true;

    iframe.onload = () => { iframe.classList.add('video-ready'); };

    soundToggle.addEventListener('click', () => {
      isMuted = !isMuted;
      iframe.contentWindow?.postMessage(JSON.stringify({
        method: 'setVolume',
        value: isMuted ? 0 : 1
      }), '*');

      soundIcon.style.display = isMuted ? 'none' : 'block';
      muteIcon.style.display = isMuted ? 'block' : 'none';
      soundToggle.setAttribute('aria-pressed', (!isMuted).toString());
    });
  }

  document.addEventListener('astro:page-load', initVimeoControl);
  if (!(window as any).vimeoInit) {
    initVimeoControl();
    (window as any).vimeoInit = true;
  }
</script>
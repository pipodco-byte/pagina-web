---
// PlanRetomaHero.astro
---

<section class="pipod-hero-immersive">
  <div class="hero-video-bg">
    <iframe 
      id="hero-vimeo-player"
      src="https://player.vimeo.com/video/732211917?background=1&autoplay=1&loop=1&muted=1&api=1" 
      allow="autoplay; fullscreen" 
      allowfullscreen
      title="Pipod Plan Retoma Video">
    </iframe>
    <div class="video-overlay-pro"></div>
  </div>

  <button class="sound-toggle-btn" id="soundToggle" aria-label="Activar sonido" aria-pressed="false">
    <svg class="sound-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
      <path class="sound-wave" d="M15.54 3.54a9 9 0 0 1 0 12.73M18.91 7.09a15 15 0 0 1 0 9.82" stroke-linecap="round"></path>
    </svg>
    <svg class="mute-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
      <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
      <line x1="23" y1="9" x2="17" y2="15"></line>
      <line x1="17" y1="9" x2="23" y2="15"></line>
    </svg>
  </button>

  <div class="pipod-hud-top">
    <div class="glass-tag-impact">
      <span class="pulse-dot"></span> [ PLAN RETOMA 2026 ]
    </div>
    <div class="title-glass-area">
      <h1 class="hero-title-impact">
        Renueva tu<br/><span>equipo</span>
      </h1>
    </div>
  </div>

  <div class="pipod-hud-bottom">
    <p class="hero-subtitle">
      Entrega tu <strong>iPhone, MacBook o Apple Watch</strong> usado y recíbelo como parte de pago para tu próximo gran salto tecnológico.
    </p>
    <div class="hero-actions-grid">
       <a href="https://wa.me/573124813094?text=Hola%20Pipod..." class="btn-pipod-glass-primary">
        Agendar Cita
      </a>
      <a href="#como-funciona" class="btn-pipod-glass-secondary">
        Ver proceso
      </a>
    </div>
  </div>
</section>

<style>
  .pipod-hero-immersive {
    position: relative;
    width: 100%;
    height: 90vh;
    overflow: hidden;
    background: #000;
  }

  /* --- Video Background --- */
  .hero-video-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-video-bg iframe {
    width: 100vw;
    height: 56.25vw;
    min-height: 100vh;
    min-width: 177.77vh;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    opacity: 0;
    animation: fadeInVideo 1.2s ease-out 0.3s forwards;
  }

  @keyframes fadeInVideo { to { opacity: 1; } }

  .video-overlay-pro {
    position: absolute;
    inset: 0;
    /* Gradiente mejorado para legibilidad en HUD superior e inferior */
    background: linear-gradient(to bottom, 
      rgba(0,0,0,0.5) 0%, 
      transparent 30%, 
      transparent 70%, 
      rgba(0,0,0,0.7) 100%);
    z-index: 2;
  }

  /* --- HUD Elements --- */
  .pipod-hud-top {
    position: absolute;
    top: 140px;
    left: 80px;
    z-index: 10;
  }

  .glass-tag-impact {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    padding: 10px 20px;
    font-size: 0.75rem;
    font-weight: 800;
    color: #FFF;
    letter-spacing: 2px;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #4A90E2;
    border-radius: 50%;
    box-shadow: 0 0 10px #4A90E2;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.5); opacity: 0.5; }
    100% { transform: scale(1); opacity: 1; }
  }

  .hero-title-impact {
    font-size: clamp(3rem, 8vw, 5.5rem); /* Tamaño fluido */
    font-weight: 900;
    line-height: 0.85;
    color: #FFF;
    margin: 0;
    text-shadow: 0 10px 40px rgba(0,0,0,0.5);
  }

  .hero-title-impact span { color: #4A90E2; }

  .pipod-hud-bottom {
    position: absolute;
    bottom: 60px;
    right: 80px;
    z-index: 10;
    max-width: 500px;
    text-align: right;
  }

  .hero-subtitle {
    color: rgba(255,255,255,0.9);
    font-size: 1.2rem;
    line-height: 1.5;
    margin-bottom: 32px;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }

  .hero-subtitle strong { color: #FFF; font-weight: 700; }

  .hero-actions-grid {
    display: flex;
    gap: 16px;
    justify-content: flex-end;
  }

  /* --- Buttons --- */
  .btn-pipod-glass-primary, .btn-pipod-glass-secondary {
    padding: 18px 34px;
    border-radius: 12px; /* Menos redondeado para look más tech */
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 10px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-pipod-glass-primary {
    background: #4A90E2;
    color: #FFF;
    border: 1px solid rgba(255,255,255,0.2);
  }

  .btn-pipod-glass-secondary {
    background: rgba(255,255,255,0.05);
    color: #FFF;
    border: 1px solid rgba(255,255,255,0.2);
  }

  .btn-pipod-glass-primary:hover {
    background: #357ABD;
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(74, 144, 226, 0.3);
  }

  /* --- Sound Toggle --- */
  .sound-toggle-btn {
    position: absolute;
    top: 140px;
    right: 80px;
    z-index: 15;
    width: 48px;
    height: 48px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border-radius: 50%;
    cursor: pointer;
    color: #FFF;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* --- Responsive --- */
  @media (max-width: 768px) {
    .pipod-hud-top { top: 120px; left: 20px; }
    .pipod-hud-bottom { bottom: 40px; right: 20px; left: 20px; text-align: left; }
    .hero-actions-grid { justify-content: flex-start; flex-direction: column; }
    .sound-toggle-btn { top: 120px; right: 20px; }
  }
</style>

<script>
  // Usamos postMessage para comunicarnos con el Iframe de Vimeo sin recargar
  const iframe = document.getElementById('hero-vimeo-player');
  const soundToggle = document.getElementById('soundToggle');
  const soundIcon = soundToggle.querySelector('.sound-icon');
  const muteIcon = soundToggle.querySelector('.mute-icon');
  let isMuted = true;

  soundToggle.addEventListener('click', () => {
    isMuted = !isMuted;
    
    // El comando "setVolume" de la API de Vimeo permite mutear/desmutear
    const volume = isMuted ? 0 : 1;
    iframe.contentWindow.postMessage({
      method: 'setVolume',
      value: volume
    }, '*');

    // Actualizar UI
    soundIcon.style.display = isMuted ? 'block' : 'none';
    muteIcon.style.display = isMuted ? 'none' : 'block';
    soundToggle.setAttribute('aria-pressed', !isMuted);
  });
</script>
      margin-bottom: 56px;
    }

    .pipod-newsletter-title {
      font-size: 2.25rem;
    }

    .pipod-newsletter-subtitle {
      font-size: 1rem;
    }

    .pipod-newsletter-button:hover {
      transform: translateY(-3px);
    }
  }
</style>

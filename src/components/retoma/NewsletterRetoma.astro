<section class="pipod-newsletter-section">
  <div class="pipod-newsletter-container">
    <header class="pipod-newsletter-header">
      <h2 style="font-family: 'Inter', sans-serif; font-size: 2.8rem; font-weight: 800; margin: 0 0 40px; text-align: center; color: #FFFFFF;">MANTENTE INFORMADO</h2>
      <p class="pipod-newsletter-subtitle">Recibe nuestro blog, ofertas y descuentos a tu correo electrónico. Vive Pipod</p>
    </header>

    <div class="pipod-newsletter-form-wrapper">
      <form id="newsletter-form" class="pipod-newsletter-form">
        <div class="pipod-newsletter-input-container">
          <input 
            type="email" 
            id="email-input"
            placeholder="Email" 
            required 
            class="pipod-newsletter-input"
          />
          <span class="pipod-newsletter-validation-icon hidden">✓</span>
          <button type="submit" id="submit-btn" class="pipod-newsletter-button" aria-label="Suscribirse al newsletter">
            <span class="pipod-newsletter-btn-text">Unirme</span>
            <span class="pipod-newsletter-loader hidden"></span>
          </button>
        </div>
        <p id="message" class="pipod-newsletter-message hidden"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('newsletter-form');
  const btn = document.getElementById('submit-btn');
  const btnText = btn.querySelector('.pipod-newsletter-btn-text');
  const loader = btn.querySelector('.pipod-newsletter-loader');
  const input = document.getElementById('email-input');
  const validationIcon = document.querySelector('.pipod-newsletter-validation-icon');

  // Validación en tiempo real
  input.addEventListener('input', (e) => {
    const isValid = e.target.validity.valid;
    if (isValid && e.target.value.length > 0) {
      validationIcon.classList.remove('hidden');
      input.classList.add('pipod-newsletter-input-valid');
    } else {
      validationIcon.classList.add('hidden');
      input.classList.remove('pipod-newsletter-input-valid');
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    btn.disabled = true;
    btnText.classList.add('hidden');
    loader.classList.remove('hidden');

    setTimeout(() => {
      form.innerHTML = `
        <div class="pipod-newsletter-success-state">
          <span class="pipod-newsletter-success-icon">✓</span>
          <span>¡Suscrito con éxito!</span>
        </div>
      `;
    }, 1500);
  });
  
  input.addEventListener('invalid', (e) => {
    e.preventDefault();
    input.setAttribute('aria-invalid', 'true');
  });
</script>

<style>

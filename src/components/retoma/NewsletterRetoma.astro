    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    backdrop-filter: blur(20px);
  }

  .pipod-newsletter-input-container:focus-within {
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.06), inset 0 0 20px rgba(58, 80, 107, 0.1);
    background: #252527;
  }

  .pipod-newsletter-input {

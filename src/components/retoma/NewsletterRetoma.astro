    border-radius: 50%;
    color: #FFFFFF;
    font-weight: 700;
    animation: popIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes popIn {
    0% {
      opacity: 0;
      transform: scale(0);
    }
    50% {
      transform: scale(1.1);

      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes slideUp {
    from { 
      opacity: 0; 
      transform: translateY(10px); 
    }
    to { 
      opacity: 1; 
      transform: translateY(0); 
    }
  }

  .hidden { display: none; }

  @media (min-width: 1024px) {

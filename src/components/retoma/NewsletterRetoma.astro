  }

  .pipod-newsletter-title {
    display: none;
  }

  .pipod-newsletter-subtitle {
    font-family: 'Noto Sans', sans-serif;
    font-size: 0.875rem;
    color: #6E6E6E;
    margin: 4px 0 0 0;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .pipod-newsletter-form-wrapper {
    display: flex;
    justify-content: center;
  }

  .pipod-newsletter-form {
    width: 100%;
    max-width: 450px;
  }

  /* Estructura Pill (Apple Style) */
  .pipod-newsletter-input-container {
    display: flex;
    align-items: center;
    background: #1c1c1e;
    padding: 6px;
    border-radius: 50px;

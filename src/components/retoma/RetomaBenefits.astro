---
/**
 * DATA: Recuperada íntegra de tu lógica original
 */
const BENEFITS = [
  {
    title: 'Ahorro inmediato',
    desc: 'Tu dispositivo usado se valora y ese monto se convierte en crédito o descuento para el nuevo. Esto permite reducir el costo al momento de la compra.',
    icon: 'lightbulb',
  },
  {
    title: 'Sostenible',
    desc: 'Al dar tu equipo usado, se promueve su reutilización o reciclaje. Esto reduce residuos electrónicos y beneficia al medio ambiente.',
    icon: 'leaf',
  },
  {
    title: 'Proceso transparente',
    desc: 'Revisamos tu equipo, te mostramos cómo llegamos al valor. Sabes lo que estás entregando, lo que vale y lo que recibirás.',
    icon: 'heart',
  },
  {
    title: 'Decisión flexible',
    desc: 'El crédito que obtienes puede aplicarse a productos nuevos o reacondicionados (según tus reglas). Puedes elegir qué equipo comprar.',
    icon: 'send',
  }
];

// HOJA DE ICONOS (Paths originales rescatados)
const iconPaths = {
  lightbulb: '<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
  heart: '<path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/>',
  send: '<path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/>'
};

const col1 = [BENEFITS[0], BENEFITS[1]];
const col2 = [BENEFITS[2], BENEFITS[3]];
---

<section id="beneficios" class="benefits-section">
  <div class="container main-layout">
    
    <header class="header-content">
      <span class="eyebrow">APROVECHA TU EQUIPO USADO</span>
      <h2 class="main-title shimmer-beneficios">Beneficios</h2>
      <p class="main-description">
        El Plan Retoma de Pipod te permite renovar tu equipo con beneficios económicos y ambientales. 
        Obtén el mejor valor por tu dispositivo usado y contribuye a un futuro más sostenible.
      </p>
    </header>

    <div class="benefits-grid-container">
      
      <div class="cards-column">
        {col1.map((item) => (
          <article class="benefit-card group">
            <div class="icon-container">
              <svg 
                xmlns="http://www.w3.org/2000/svg" 
                width="42" height="42" viewBox="0 0 24 24" fill="none" 
                stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" 
                class="icon-svg icon-shimmer"
                set:html={iconPaths[item.icon]}
              />
            </div>
            <div class="card-text">
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="cards-column staggered">
        {col2.map((item) => (
          <article class="benefit-card group">
            <div class="icon-container">
              <svg 
                xmlns="http://www.w3.org/2000/svg" 
                width="42" height="42" viewBox="0 0 24 24" fill="none" 
                stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" 
                class="icon-svg icon-shimmer"
                set:html={iconPaths[item.icon]}
              />
            </div>
            <div class="card-text">
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </article>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=PT+Mono:wght@400;700&family=Noto+Sans:wght@400;500;600&display=swap');

  /* CONFIGURACIÓN ESTILO CONTACT */
  .benefits-section {
    background-color: #FFFFFF;
    color: #000000;
    padding: 50px 0;
    overflow: hidden;
    font-family: 'Inter', sans-serif;
  }

  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 25px;
  }

  @media (min-width: 1024px) {
    .benefits-section {
      padding: 80px 0;
    }

    .container {
      padding: 0 80px;
    }
  }

  /* ESTRUCTURA DE DOS BLOQUES */
  .main-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 80px;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .main-layout {
      grid-template-columns: 1fr 1.5fr;
      gap: 100px;
    }
    .header-content {
      position: sticky;
      top: 100px;
    }
  }

  /* SHIMMER AZUL SOBRE TEXTO BLANCO */
  /* .shimmer-beneficios {
    background: linear-gradient(
      90deg, 
      #FFFFFF 0%, 
      #3B82F6 25%, 
      #0066CC 50%, 
      #3B82F6 75%, 
      #FFFFFF 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmerEffect 5s linear infinite;
  }

  @keyframes shimmerEffect {
    to { background-position: 200% center; }
  }

  /* ESTILOS DE TEXTO */
  .eyebrow {
    font-family: 'PT Mono', monospace;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.4em;
    color: #000000;
    margin-bottom: 24px;
    display: block;
  }

  .main-title {
    font-family: 'Inter', sans-serif;
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin: 0;
    color: #000000;
  }

  .main-description {
    font-family: 'Noto Sans', sans-serif;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #6E6E6E;
    margin-top: 40px;
    max-width: 440px;
  }

  /* GRID DE CARDS */
  .benefits-grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 40px;
  }

  .cards-column {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  @media (min-width: 1024px) {
    .staggered {
      margin-top: 120px;
    }
  }

  /* CARD INTEGRADA */
  .benefit-card {
    background: transparent;
    border: none;
    text-align: center;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.4s ease;
  }

  .benefit-card:hover {
    transform: translateY(-10px);
  }

  .icon-container {
    margin-bottom: 32px;
  }

  /* ICONO NEGRO */
  .icon-shimmer {
    color: #000000;
    transition: all 0.4s ease;
  }

  .benefit-card:hover .icon-shimmer {
    transform: scale(1.1);
  }

  /* TÍTULOS Y PÁRRAFOS DE CARD */
  .benefit-card h3 {
    font-family: 'Inter', sans-serif;
    font-size: 1.8rem;
    font-weight: 800;
    color: #000000;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .benefit-card p {
    font-family: 'Noto Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: #6E6E6E;
    margin: 0;
  }
</style>

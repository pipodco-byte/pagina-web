---
/**
 * DATA: Comparativa Plan Retoma
 */
import FloatingContact from '../../layouts/floatingContact';

const comparisons = [
  {
    criteria: 'Tiempo de venta',
    pipod: '30 minutos',
    particular: '2-4 semanas',
    mercadolibre: '1-3 semanas'
  },
  {
    criteria: 'Seguridad',
    pipod: 'Garantizada',
    particular: 'Riesgo alto',
    mercadolibre: 'Riesgo medio'
  },
  {
    criteria: 'Valoración',
    pipod: 'Profesional',
    particular: 'Negociable',
    mercadolibre: 'Variable'
  },
  {
    criteria: 'Garantía en compra',
    pipod: '12 meses',
    particular: 'Sin garantía',
    mercadolibre: 'Limitada'
  },
  {
    criteria: 'Proceso',
    pipod: 'Sin complicaciones',
    particular: 'Complejo',
    mercadolibre: 'Moderado'
  }
];

// Icono Check Blue
const checkIcon = '<path d="M20 6L9 17l-5-5"></path>';
---

<section class="comparison-section">
  <div class="container">
    
    <header class="header-center">
      <h2 style="font-family: 'Inter', sans-serif; font-size: 2.8rem; font-weight: 800; margin: 0 0 40px; text-align: left;">¿POR QUÉ ELEGIR PLAN RETOMA?</h2>
    </header>

    <div class="table-container">
      <table class="comparison-table">
        <thead>
          <tr>
            <th class="col-criteria">Criterio</th>
            <th class="col-pipod highlight">Plan Retoma Pipod</th>
            <th class="col-others">Venta Particular</th>
            <th class="col-others">Mercado Libre</th>
          </tr>
        </thead>
        <tbody>
          {comparisons.map((row) => (
            <tr>
              <td class="criteria-cell">{row.criteria}</td>
              <td class="pipod-cell highlight">
                <div class="pipod-content">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0066CC" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" set:html={checkIcon} />
                  <span>{row.pipod}</span>
                </div>
              </td>
              <td class="other-cell">{row.particular}</td>
              <td class="other-cell">{row.mercadolibre}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="cta-container">
      <FloatingContact client:load />
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=PT+Mono:wght@400;700&family=Noto+Sans:wght@400;500;600&display=swap');

  /* CONFIGURACIÓN ESTILO PIPOD (Blanco Perfecto) */
  .comparison-section {
    background-color: #FFFFFF;
    padding: 50px 0;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 25px;
  }

  @media (min-width: 1024px) {
    .comparison-section {
      padding: 80px 0;
    }

    .container {
      padding: 0 80px;
    }
  }

  /* HEADER CENTRADO */
  .header-center {
    text-align: center;
    margin-bottom: 60px;
  }

  .eyebrow {
    display: none;
  }

  .main-title {
    display: none;
  }

  .main-description {
    display: none;
  }

  /* TABLA PREMIUM (Sin bordes pesados) */
  .table-container {
    overflow-x: auto;
    margin: 40px 0;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  th {
    font-family: 'Inter', sans-serif;
    padding: 24px 20px;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #1d1d1f;
    border-bottom: 1px solid #f5f5f7;
  }

  th.col-pipod {
    background-color: #F5F5F7;
    color: #1d1d1f;
    box-shadow: 0 8px 8px rgba(0, 0, 0, 0.08);
  }

  /* Celdas */
  td {
    font-family: 'Noto Sans', sans-serif;
    padding: 24px 20px;
    font-size: 1rem;
    border-bottom: 1px solid #f5f5f7;
    color: #424245;
  }

  .criteria-cell {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    color: #1d1d1f;
    width: 25%;
  }

  td.pipod-cell {
    background-color: #F5F5F7;
    color: #1d1d1f;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  td.pipod-cell svg {
    stroke: #000000;
  }

  .other-cell {
    font-family: 'Noto Sans', sans-serif;
    color: #86868b; /* Gris para lo que no es Pipod */
  }

  /* BOTÓN PREMIUM (Estilo Apple) */
  .cta-container {
    text-align: center;
    margin-top: 60px;
  }

  @media (max-width: 768px) {
    .main-title { font-size: 2.2rem; }
    th, td { padding: 16px 10px; font-size: 0.9rem; }
    .col-others { display: none; } /* En móvil simplificamos la tabla */
    .other-cell { display: none; }
  }
</style>
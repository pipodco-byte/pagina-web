---
/**
 * DATA: Comparativa Plan Retoma
 */
const comparisons = [
  {
    criteria: 'Tiempo de venta',
    pipod: '30 minutos',
    particular: '2-4 semanas',
    mercadolibre: '1-3 semanas'
  },
  {
    criteria: 'Seguridad',
    pipod: 'Garantizada',
    particular: 'Riesgo alto',
    mercadolibre: 'Riesgo medio'
  },
  {
    criteria: 'Valoración',
    pipod: 'Profesional',
    particular: 'Negociable',
    mercadolibre: 'Variable'
  },
  {
    criteria: 'Garantía en compra',
    pipod: '12 meses',
    particular: 'Sin garantía',
    mercadolibre: 'Limitada'
  },
  {
    criteria: 'Proceso',
    pipod: 'Sin complicaciones',
    particular: 'Complejo',
    mercadolibre: 'Moderado'
  }
];

// Icono Check Blue
const checkIcon = '<path d="M20 6L9 17l-5-5"></path>';
---

<section class="comparison-section">
  <div class="container">
    
    <header class="header-center">
      <span class="eyebrow">COMPARACIÓN</span>
      <h2 class="main-title shimmer-text">¿Por qué elegir Plan Retoma?</h2>
      <p class="main-description">COMPARA Y DECIDE CON INFORMACIÓN CLARA</p>
    </header>

    <div class="table-container">
      <table class="comparison-table">
        <thead>
          <tr>
            <th class="col-criteria">Criterio</th>
            <th class="col-pipod highlight">Plan Retoma Pipod</th>
            <th class="col-others">Venta Particular</th>
            <th class="col-others">Mercado Libre</th>
          </tr>
        </thead>
        <tbody>
          {comparisons.map((row) => (
            <tr>
              <td class="criteria-cell">{row.criteria}</td>
              <td class="pipod-cell highlight">
                <div class="pipod-content">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0066CC" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" set:html={checkIcon} />
                  <span>{row.pipod}</span>
                </div>
              </td>
              <td class="other-cell">{row.particular}</td>
              <td class="other-cell">{row.mercadolibre}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="cta-container">
      <a href="/comenzar" class="btn-premium">
        Comenzar ahora
      </a>
    </div>
  </div>
</section>

<style>
  /* CONFIGURACIÓN ESTILO PIPOD (Blanco Perfecto) */
  .comparison-section {
    background-color: #FFFFFF;
    padding: 50px 0;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 25px;
  }

  @media (min-width: 1024px) {
    .comparison-section {
      padding: 80px 0;
    }

    .container {
      padding: 0 80px;
    }
  }

  /* HEADER CENTRADO */
  .header-center {
    text-align: center;
    margin-bottom: 60px;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #86868b;
    margin-bottom: 12px;
    display: block;
  }

  /* SHIMMER AZUL SOBRE TÍTULO NEGRO */
  .shimmer-text {
    background: linear-gradient(
      90deg, 
      #1d1d1f 0%, 
      #0066CC 50%, 
      #1d1d1f 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmerEffect 5s linear infinite;
  }

  @keyframes shimmerEffect {
    to { background-position: 200% center; }
  }

  .main-title {
    font-size: clamp(2.5rem, 6vw, 3.8rem);
    font-weight: 800;
    color: #1d1d1f;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .main-description {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #86868b;
  }

  /* TABLA PREMIUM (Sin bordes pesados) */
  .table-container {
    overflow-x: auto;
    margin: 40px 0;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  /* Headers */
  th {
    padding: 24px 20px;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #1d1d1f;
    border-bottom: 1px solid #f5f5f7;
  }

  .col-pipod {
    color: #0066CC;
    font-weight: 800;
  }

  /* Celdas */
  td {
    padding: 24px 20px;
    font-size: 1rem;
    border-bottom: 1px solid #f5f5f7;
    color: #424245;
  }

  .criteria-cell {
    font-weight: 600;
    color: #1d1d1f;
    width: 25%;
  }

  /* Resaltado de la columna Pipod (Sutil) */
  .highlight {
    background-color: rgba(0, 102, 204, 0.03); /* Un toque de azul casi invisible */
  }

  .pipod-cell {
    color: #0066CC;
    font-weight: 700;
  }

  .pipod-content {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .other-cell {
    color: #86868b; /* Gris para lo que no es Pipod */
  }

  /* BOTÓN PREMIUM (Estilo Apple) */
  .cta-container {
    text-align: center;
    margin-top: 60px;
  }

  .btn-premium {
    display: inline-block;
    background-color: #0066CC;
    color: #FFFFFF;
    padding: 16px 40px;
    border-radius: 99px;
    font-weight: 600;
    font-size: 1.1rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-premium:hover {
    background-color: #0077ED;
    transform: scale(1.03);
    box-shadow: 0 10px 20px rgba(0, 102, 204, 0.15);
  }

  @media (max-width: 768px) {
    .main-title { font-size: 2.2rem; }
    th, td { padding: 16px 10px; font-size: 0.9rem; }
    .col-others { display: none; } /* En móvil simplificamos la tabla */
    .other-cell { display: none; }
  }
</style>
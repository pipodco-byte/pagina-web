---
/**
 * DATA: Preguntas Frecuentes extraídas de tu código
 */
const FAQS = [
  { q: '¿Cuánto tarda el proceso de valoración?', a: 'El diagnóstico inicial toma entre 30-60 minutos. La evaluación completa y oferta final se entrega el mismo día.' },
  { q: '¿Qué tipos de equipos reciben?', a: 'Aceptamos iPhone, MacBook, iMac, Apple Watch y otros dispositivos Apple.' },
  { q: '¿Aceptan equipos rotos o con pantalla partida?', a: 'Sí, evaluamos equipos con daños menores. El valor se ajusta según el estado real.' },
  { q: '¿Puedo vender mi equipo en efectivo sin hacer retoma?', a: 'Sí, ofrecemos opciones de compra directa en efectivo.' },
  { q: '¿Qué garantía tiene el equipo reacondicionado?', a: 'Los equipos reacondicionados incluyen garantía de 12 meses.' },
  { q: '¿Puedo pedir valoración sin llevar el equipo?', a: 'Puedes solicitar una valoración inicial por fotos o video.' },
  { q: '¿Puedo usar el crédito en cualquier producto?', a: 'El crédito se puede aplicar a productos nuevos o reacondicionados.' },
  { q: '¿Qué pasa si mi dispositivo tiene datos?', a: 'Recomendamos respaldar y borrar tus datos. Nosotros hacemos un borrado seguro.' },
  { q: '¿Qué pasa si no acepto la oferta?', a: 'Sin problema. Puedes rechazar la oferta sin compromiso.' },
  { q: '¿El crédito se puede transferir a otra persona?', a: 'El crédito es personal y no transferable.' },
  { q: '¿Puedo entregar más de un equipo?', a: 'Sí, puedes entregar múltiples equipos y los créditos se suman.' },
  { q: '¿Cómo funciona el domicilio?', a: 'Ofrecemos servicio de recogida a domicilio en Bogotá.' }
];

const leftFAQs = FAQS.slice(0, 6);
const rightFAQs = FAQS.slice(6, 12);

// Icono HelpCircle (Azul de la imagen)
const helpCircleIcon = '<circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line>';
---

<section id="faq" class="faq-section">
  <div class="container">
    
    <header class="header-center">
      <h2 style="font-family: 'Inter', sans-serif; font-size: 2.8rem; font-weight: 800; margin: 0 0 40px; text-align: left;">PREGUNTAS FRECUENTES</h2>
    </header>

    <div class="faq-grid">
      
      <div class="faq-column">
        {leftFAQs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-header">
              <div class="icon-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0066CC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={helpCircleIcon}></svg>
              </div>
              <span class="question-text">{faq.q}</span>
            </summary>
            <div class="faq-content">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="faq-column">
        {rightFAQs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-header">
              <div class="icon-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0066CC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={helpCircleIcon}></svg>
              </div>
              <span class="question-text">{faq.q}</span>
            </summary>
            <div class="faq-content">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=PT+Mono:wght@400;700&family=Noto+Sans:wght@400;500;600&display=swap');

  /* ESTILOS DE LA SECCIÓN (Minimalismo total) */
  .faq-section {
    background-color: #FFFFFF; /* Blanco Puro */
    padding: 50px 0;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 25px;
  }

  @media (min-width: 1024px) {
    .faq-section {
      padding: 80px 0;
    }

    .container {
      padding: 0 80px;
    }
  }

  /* HEADER CENTRADO */
  .header-center {
    text-align: center;
    margin-bottom: 80px;
  }

  .eyebrow {
    display: none;
  }

  .main-title {
    display: none;
  }

  .main-description {
    display: none;
  }

  /* GRID DE DOS COLUMNAS */
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 1024px) {
    .faq-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 60px;
    }
  }

  @media (max-width: 768px) {
    .header-center {
      margin-bottom: 40px;
    }
  }

  .faq-column {
    display: flex;
    flex-direction: column;
  }

  /* ITEM INTEGRADO (Sin cajas, sin bordes) */
  .faq-item {
    border-bottom: 1px solid #f5f5f7; /* Línea separadora muy sutil */
  }

  .faq-header {
    list-style: none;
    padding: 24px 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 16px;
    transition: opacity 0.2s ease;
  }

  .faq-header:hover {
    opacity: 0.7;
  }

  .faq-header::-webkit-details-marker {
    display: none;
  }

  .icon-box {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .question-text {
    font-family: 'Inter', sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: #1d1d1f;
    line-height: 1.3;
  }

  /* RESPUESTA */
  .faq-content {
    font-family: 'Noto Sans', sans-serif;
    padding: 0 0 24px 36px;
    font-size: 1rem;
    line-height: 1.5;
    color: #434345;
  }

  .faq-content p {
    font-family: 'Noto Sans', sans-serif;
  }

  /* Animación simple para el despliegue */
  .faq-item[open] .question-text {
    color: #0066CC;
  }
</style>
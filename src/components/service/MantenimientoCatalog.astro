---
// Mantenimiento Preventivo - Promocionado
---

<section class="pipod-mantenimiento-section">
  <div class="pipod-container">
    <div class="pipod-section-header">
      <h2 class="pipod-section-title">PREVENIR ES MEJOR QUE REPARAR</h2>
    </div>
    
    <div class="pipod-mantenimiento-grid">
      <!-- Mantenimiento Simple -->
      <div class="pipod-maintenance-card">
        <div class="pipod-card-content">
          <div class="pipod-maintenance-icon">
            <i class="bi bi-tools"></i>
          </div>
          <h3 class="pipod-maintenance-title">Mantenimiento Simple</h3>
          
          <div class="pipod-specs-container">
            <div class="pipod-spec-row">
              <span class="pipod-spec-label">PRECIO:</span>
              <span class="pipod-spec-value">$60.000</span>
            </div>
            <div class="pipod-spec-row">
              <span class="pipod-spec-label">TIEMPO:</span>
              <span class="pipod-spec-value">2-3 HORAS</span>
            </div>
            <div class="pipod-spec-row">
              <span class="pipod-spec-label">FRECUENCIA:</span>
              <span class="pipod-spec-value">Cada 6 meses</span>
            </div>
          </div>

          <h5 class="pipod-maintenance-subtitle">Incluye:</h5>
          <ul class="pipod-checklist">
            <li><span class="dot-check"></span> Limpieza profunda (polvo/restos)</li>
            <li><span class="dot-check"></span> Pasta térmica básica</li>
            <li><span class="dot-check"></span> Ajuste de ventiladores</li>
            <li><span class="dot-check"></span> Limpieza de conectores</li>
          </ul>

          <p class="pipod-maintenance-note">Para: MacBook, iMac, iPad</p>
        </div>
        <a href="https://wa.me/573124813094?text=Hola%20Pipod%2C%20quiero%20mantenimiento%20simple" class="pipod-btn-bento">Agendar Mantenimiento</a>
      </div>

      <!-- Mantenimiento Termal Pack -->
      <div class="pipod-maintenance-card">
        <div class="pipod-card-content">
          <span class="pipod-badge">PROFESIONALES</span>
          <div class="pipod-maintenance-icon">
            <i class="bi bi-snow"></i>
          </div>
          <h3 class="pipod-maintenance-title">Mantenimiento Termal Pack</h3>
          
          <div class="pipod-specs-container">
            <div class="pipod-spec-row">
              <span class="pipod-spec-label">PRECIO:</span>
              <span class="pipod-spec-value">$120.000</span>
            </div>
            <div class="pipod-spec-row">
              <span class="pipod-spec-label">TIEMPO:</span>
              <span class="pipod-spec-value">3-4 HORAS</span>
            </div>
            <div class="pipod-spec-row">
              <span class="pipod-spec-label">FRECUENCIA:</span>
              <span class="pipod-spec-value">Cada 12 meses</span>
            </div>
          </div>

          <h5 class="pipod-maintenance-subtitle">Incluye TODO de Simple +:</h5>
          <ul class="pipod-checklist">
            <li><span class="dot-check"></span> Pasta térmica Premium (Noctua)</li>
            <li><span class="dot-check"></span> Optimización para alto render</li>
            <li><span class="dot-check"></span> Prueba de estrés de 30min</li>
            <li><span class="dot-check"></span> Reporte de temperaturas</li>
          </ul>

          <p class="pipod-maintenance-note">Para: Profesionales (video, 3D)</p>
        </div>
        <a href="https://wa.me/573124813094?text=Hola%20Pipod%2C%20quiero%20mantenimiento%20termal%20pack%20MacBook" class="pipod-btn-bento">Agendar Termal Pack</a>
      </div>
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');

  .pipod-mantenimiento-section {
    background-color: #FFFFFF;
    padding: 80px 0;
    border-top: 1px solid #E5E5E5;
  }

  .pipod-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .pipod-section-title {
    font-family: 'Inter', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: #000000;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-bottom: 48px;
    text-align: left;
  }

  .pipod-mantenimiento-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.5rem;
    margin-bottom: 60px;
  }

  @media (min-width: 768px) {
    .pipod-mantenimiento-grid {
      grid-template-columns: repeat(2, 1fr);
      margin-bottom: 60px;
    }
  }

  .pipod-maintenance-card {
    background: #FFFFFF;
    border: 0.85px solid #000000;
    border-radius: 24px;
    padding: 35px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    min-height: 520px;
  }

  .pipod-maintenance-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.08);
  }

  .pipod-maintenance-icon {
    font-size: 2.5rem;
    color: #000000;
    margin-bottom: 24px;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .pipod-maintenance-title {
    font-family: 'Inter', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #000000;
    margin-bottom: 12px;
    line-height: 1.2;
    text-align: center;
  }

  .pipod-badge {
    display: block;
    background: #000000;
    color: #FFFFFF;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 50px;
    margin-bottom: 16px;
    text-align: right;
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
    letter-spacing: 0.05em;
  }

  .pipod-specs-container {
    margin-bottom: 24px;
    padding-top: 0;
    border-top: none;
  }

  .pipod-spec-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .pipod-spec-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: #333333;
    letter-spacing: 0.05em;
  }

  .pipod-spec-value {
    font-size: 0.9rem;
    font-weight: 600;
    color: #000000;
  }

  .pipod-maintenance-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    color: #000000;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pipod-checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 20px 0;
  }

  .pipod-checklist li {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: #555;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .dot-check {
    width: 6px;
    height: 6px;
    background-color: #000;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  .pipod-maintenance-note {
    font-size: 0.8rem;
    color: #999;
    font-style: italic;
    margin-bottom: 20px;
  }

  .pipod-btn-bento {
    background: #000000;
    color: #FFFFFF;
    text-align: center;
    padding: 14px 25px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    font-family: 'Inter', sans-serif;
    display: block;
  }

  .pipod-btn-bento:hover {
    background: #333333;
    transform: scale(1.02);
  }

  @media (max-width: 768px) {
    .pipod-container {
      padding: 0 24px;
    }
  }
</style>

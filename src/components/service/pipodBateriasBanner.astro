  <div class="stats-container">
    <div class="stats-grid">
      
      <div class="stat-item">
        <div class="number-wrapper">
          <h2 class="stat-number" data-target="654">0</h2>
          <span class="stat-suffix">BATERÍAS</span>
        </div>
        <p class="stat-text">REEMPLAZADAS</p>
      </div>

      <div class="stat-item">
        <div class="number-wrapper">
          <h2 class="stat-number" data-target="426">0</h2>
          <span class="stat-suffix">BATERÍAS</span>
        </div>
        <p class="stat-text">DE IPHONE</p>
      </div>

      <div class="stat-item">
        <div class="number-wrapper">
          <h2 class="stat-number" data-target="82">0</h2>
          <span class="stat-suffix">BATERIAS</span>
        </div>
        <p class="stat-text">DE MACBOOKS</p>
      </div>

      <div class="stat-item">
        <div class="number-wrapper">
          <h2 class="stat-number" data-target="149">0</h2>
          <span class="stat-suffix">BATERÍAS</span>
        </div>
        <p class="stat-text">DE IPAD</p>
      </div>

    </div>
  </div>
</section>

<script>
  const batteryObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const target = entry.target;
        const targetValue = parseInt(target.getAttribute('data-target') || '0');
        let current = 0;
        const increment = targetValue / 100;
        
        const updateCount = () => {
          if (current < targetValue) {
            current += increment;
            target.innerText = Math.ceil(current).toString();
            setTimeout(updateCount, 15);
          } else {
            target.innerText = targetValue.toString();
          }
        };
        updateCount();
        batteryObserver.unobserve(target);
      }
    });
  }, { threshold: 0.5 });

  document.querySelectorAll('.stat-number').forEach(stat => batteryObserver.observe(stat));
</script>


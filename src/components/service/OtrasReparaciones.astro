<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

  .pipod-servicios-premium {
    background-color: #FFFFFF;
    padding: 100px 0;
    font-family: 'Inter', sans-serif;
  }

  .pipod-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 80px;
  }

  .pipod-main-title {
    font-size: 2.2rem;
    font-weight: 700;
    color: #000;
    text-transform: uppercase;
    text-align: center;
    margin-bottom: 60px;
    letter-spacing: -0.03em;
  }

  .pipod-accordion-group {
    max-width: 850px;
    margin: 0 auto;
  }

  .pipod-item {
    background: #FFFFFF;
    border: 0.85px solid #000000;
    border-radius: 20px;
    margin-bottom: 12px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pipod-item:hover {
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }

  .pipod-header {
    display: flex;
    align-items: center;
    padding: 22px 28px;
    cursor: pointer;
    list-style: none;
    background: #FFF;
  }

  .pipod-header::-webkit-details-marker { display: none; }

  /* Icono Estética Apple (Fondo suave + trazo limpio) */
  .pipod-icon-wrapper {
    width: 38px;
    height: 38px;
    background: #F5F5F7;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    margin-right: 20px;
  }

  .pipod-title {
    flex: 1;
    font-weight: 600;
    font-size: 1.05rem;
    color: #000;
    letter-spacing: -0.01em;
  }

  .pipod-badge {
    background: #F2F2F2;
    color: #86868b;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 700;
    margin-right: 20px;
  }

  .pipod-badge-dark {
    background: #000;
    color: #FFF;
  }

  .pipod-chevron {
    color: #86868b;
    transition: transform 0.4s ease;
  }

  details[open] .pipod-chevron {
    transform: rotate(180deg);
  }

  .pipod-content {
    padding: 0 28px 32px 86px; /* Alineado con el inicio del texto del título */
    border-top: 0.5px solid #F5F5F7;
    padding-top: 24px;
  }

  .pipod-desc {
    color: #424245;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 24px;
  }

  .pipod-specs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 28px;
  }

  .pipod-spec { display: flex; flex-direction: column; }

  .pipod-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: #86868b;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .pipod-val {
    font-weight: 600;
    font-size: 0.9rem;
    color: #000;
  }

  .pipod-list {
    list-style: none;
    padding: 0;
    margin: 24px 0;
  }

  .pipod-list li {
    font-size: 0.85rem;
    color: #1d1d1f;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pipod-dot {
    width: 5px;
    height: 5px;
    background-color: #000;
    border-radius: 50%;
  }

  .pipod-footnote {
    font-size: 0.75rem;
    color: #86868b;
    margin-bottom: 24px;
    font-style: italic;
  }

  .pipod-btn {
    background: #000;
    color: #FFF;
    padding: 12px 24px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    display: inline-block;
    transition: all 0.3s ease;
  }

  .pipod-btn:hover {
    background: #333;
    transform: scale(1.02);
  }

  @media (max-width: 768px) {
    .pipod-container { 
      padding: 0 24px; 
    }

    .pipod-servicios-premium {
      padding: 40px 0;
    }

    .pipod-main-title {
      font-size: 1.8rem;
      margin-bottom: 40px;
    }

    .pipod-header { 
      padding: 16px 18px; 
    }

    .pipod-content { 
      padding: 20px 18px 24px 18px; 
    }

    .pipod-specs { 
      grid-template-columns: 1fr; 
    }

    .pipod-icon-wrapper { 
      width: 32px; 
      height: 32px; 
      margin-right: 12px; 
    }

    .pipod-title { 
      font-size: 0.95rem; 
    }

    .pipod-badge {
      font-size: 0.65rem;
      margin-right: 12px;
    }
  }
</style>
---
// Props con los datos reales de Pipod
const { 
  score = "4.9", 
  totalReviews = "54", 
  link = "https://g.page/r/CRgj2kSrZTO4EBM/review" 
} = Astro.props;
---

<section class="google-reviews-section">
  <div class="google-container">
    <div class="google-header-bar">
      <div class="header-content-left">
        <div class="brand-container">
          <img 
            src="https://upload.wikimedia.org/wikipedia/commons/2/2f/Google_2015_logo.svg" 
            alt="Google" 
            class="google-logo"
          />
          <span class="brand-text">Reviews</span>
        </div>
        
        <div class="rating-container">
          <span class="big-score">{score}</span>
          <div class="stars-group">
            {[...Array(5)].map(() => (
              <i class="bi bi-star-fill"></i>
            ))}
          </div>
          <span class="reviews-count">({totalReviews})</span>
        </div>
      </div>

      <a href={link} target="_blank" rel="noopener noreferrer" class="btn-google-pill">
        Déjanos tu reseña
      </a>
    </div>
  </div>
</section>

<style>
  /* APLICANDO REGLA 1: Altura y Estructura Base */
  .google-reviews-section {
    background-color: #f8f9fa; /* Fondo claro para contrastar con la stats-section negra */
    min-height: 119px; /* Coincide con la altura de tu sección de stats */
    width: 100%;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #eeeeee;
  }

  /* APLICANDO REGLA 2: Márgenes Flexibles (Padding) */
  .google-container {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 5%; /* Margen dinámico */
  }

  @media (min-width: 1440px) {
    .google-container {
      padding: 0 80px; /* Margen fijo de 80px en pantallas grandes como tus stats */
    }
  }

  /* APLICANDO REGLA 3: Alineación de Extremos */
  .google-header-bar {
    display: flex;
    justify-content: space-between; /* Empuja el contenido a los bordes exactos */
    align-items: center;
    width: 100%;
  }

  /* Estilos Internos */
  .header-content-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
  }

  .brand-container {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .google-logo {
    height: 20px;
    width: auto;
  }

  .brand-text {
    font-size: 20px;
    font-weight: 500;
    color: #202124;
    font-family: 'Product Sans', system-ui, sans-serif;
  }

  .rating-container {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .big-score {
    font-size: 1.2rem;
    font-weight: 700;
    color: #202124;
  }

  .stars-group {
    display: flex;
    gap: 2px;
    color: #ffba00;
    font-size: 14px;
  }

  .reviews-count {
    color: #70757a;
    font-size: 0.9rem;
  }

  .btn-google-pill {
    background-color: #1a73e8;
    color: white !important;
    padding: 12px 28px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s ease;
  }

  .btn-google-pill:hover {
    background-color: #1557b0;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(26, 115, 232, 0.2);
  }

  /* Responsivo */
  @media (max-width: 768px) {
    .google-reviews-section {
      height: auto;
      padding: 40px 0;
    }
    .google-header-bar {
      flex-direction: column;
      gap: 24px;
      text-align: center;
    }
    .header-content-left {
      align-items: center;
    }
  }
</style>
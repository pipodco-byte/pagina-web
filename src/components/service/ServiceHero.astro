---
// ServiceHero.astro - Patrón consistente con RetomaHero
---

<section class="pipod-hero-immersive">
  <div class="hero-image-bg">
    <img
      src="/images/servicio-tecnico-apple-pipod.webp"
      alt="Servicio Técnico Apple Pipod - Baterías y Pantallas"
      class="bg-image"
      width="1920"
      height="1080"
      loading="eager"
    />
    <div class="video-overlay-pro"></div>
  </div>

  <div class="pipod-hud-top">
    <div class="glass-tag-impact">
      SERVICIO TÉCNICO APPLE DESDE 2010 • 16 AÑOS
    </div>
    <div class="title-glass-area">
      <h1 class="hero-title-impact">
        Baterías, pantallas y<br/><span>microsoldaduras</span>
      </h1>
    </div>
  </div>

  <div class="pipod-hud-bottom">
    <p class="hero-subtitle">
      Soporte técnico con 16 años de trayectoria. Diagnóstico experto sin costo. <strong>2 horas express para iPhone.</strong>
    </p>
    <div class="hero-actions-grid">
      <a href="https://wa.me/573124813094?text=Hola%20Pipod..." class="btn-pipod-glass-primary">
        Agendar Cita
      </a>
      <a href="#servicios" class="btn-pipod-glass-secondary">
        Ver servicios
      </a>
    </div>
  </div>
</section>

<style>
  .pipod-hero-immersive {
    position: relative;
    width: 100%;
    height: 90vh;
    overflow: hidden;
    background: #000;
    z-index: 1;
  }

  /* --- Image Core --- */
  .hero-image-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .video-overlay-pro {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, transparent 20%),
                linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 40%),
                radial-gradient(circle at 20% 30%, rgba(0,0,0,0.4) 0%, transparent 70%);
    z-index: 2;
  }

  /* --- HUD Superior --- */
  .pipod-hud-top {
    position: absolute;
    top: 60px;
    left: 80px;
    z-index: 10;
  }

  .glass-tag-impact {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 0.85px solid rgba(255, 255, 255, 0.25);
    border-radius: 50px;
    padding: 12px 24px;
    font-size: 0.75rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.8);
    letter-spacing: 3px;
    display: inline-block;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .hero-title-impact {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 900;
    line-height: 0.9;
    color: #FFF;
    margin: 0;
    text-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  .hero-title-impact span { color: #4A90E2; }

  /* --- HUD Inferior --- */
  .pipod-hud-bottom {
    position: absolute;
    bottom: 60px;
    right: 80px;
    z-index: 10;
    max-width: 520px;
    text-align: right;
  }

  .hero-subtitle {
    color: rgba(255,255,255,0.9);
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 32px;
    text-shadow: 0 2px 10px rgba(0,0,0,0.3);
  }

  .hero-subtitle strong { color: #FFF; font-weight: 700; }

  .hero-actions-grid {
    display: flex;
    gap: 16px;
    justify-content: flex-end;
  }

  /* --- Buttons Premium --- */
  .btn-pipod-glass-primary, .btn-pipod-glass-secondary {
    padding: 18px 36px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 12px;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 0.85px solid rgba(255,255,255,0.25);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-pipod-glass-primary {
    background: #4A90E2;
    color: #FFF;
    border: none;
  }

  .btn-pipod-glass-primary:hover {
    background: #357ABD;
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(74, 144, 226, 0.3);
  }

  .btn-pipod-glass-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #FFF;
  }

  .btn-pipod-glass-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-5px);
  }

  /* --- Media Queries --- */
  @media (max-width: 1024px) {
    .pipod-hud-top { top: 40px; left: 40px; }
    .pipod-hud-bottom { bottom: 50px; right: 40px; }
  }

  @media (max-width: 768px) {
    .pipod-hud-top { top: 40px; left: 20px; }
    .pipod-hud-bottom { bottom: 40px; right: 20px; left: 20px; text-align: left; }
    .hero-actions-grid { justify-content: flex-start; flex-direction: column; }
    .hero-title-impact { font-size: 2.8rem; }
  }

  @media (max-width: 480px) {
    .pipod-hud-top { top: 30px; left: 16px; }
    .pipod-hud-bottom { bottom: 30px; right: 16px; left: 16px; }
    .btn-pipod-glass-primary, .btn-pipod-glass-secondary { padding: 16px 28px; font-size: 0.85rem; }
  }
</style>
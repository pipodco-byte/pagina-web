---
// Hero: Enfoque visual limpio y minimalista
---

<section class="pipod-hero-immersive">
  <div class="hero-image-bg">
    <img 
      src="/images/servicio-tecnico-apple-pipod.webp" 
      alt="Servicio Técnico Apple Pipod"
      class="bg-webp"
    />
    <div class="video-overlay-minimal"></div>
  </div>

  <div class="pipod-hud-top">
    <div class="glass-tag-impact">
      SERVICIO TÉCNICO APPLE DESDE 2010
    </div>
    <div class="title-glass-area">
      <h1 class="hero-title-impact">
        Baterías, pantallas y microsoldaduras<br/><span>MacBook M-series</span>
      </h1>
      <p class="hero-subtitle">
        Soporte técnico con 11 años de trayectoria. Diagnóstico experto sin costo. 
        <span class="express">2 horas express para iPhone.</span>
      </p>
    </div>
  </div>
</section>

<style>
  .pipod-hero-immersive {
    position: relative;
    width: 100%;
    height: 85vh; /* Ajustado para un look más editorial */
    min-height: 500px;
    overflow: hidden;
    background: #fff;
    display: flex;
    align-items: center; /* Centra el contenido verticalmente */
  }

  /* --- Fondo --- */
  .hero-image-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .bg-webp {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Capa de contraste reducida para que la imagen NO se vea oscura */
  .video-overlay-minimal {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      70deg, 
      rgba(0,0,0,0.4) 0%, 
      rgba(0,0,0,0.1) 60%, 
      transparent 100%
    );
    z-index: 2;
  }

  /* --- Textos --- */
  .pipod-hud-top {
    position: relative;
    z-index: 10;
    padding-left: 8%;
    max-width: 900px;
  }

  .glass-tag-impact {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50px;
    padding: 8px 20px;
    font-size: 0.7rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 2px;
    display: inline-block;
    margin-bottom: 20px;
  }

  .hero-title-impact {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 900;
    line-height: 1;
    color: #FFF;
    margin: 0;
    text-shadow: 0 4px 20px rgba(0,0,0,0.2); /* Sombra suave para legibilidad */
  }

  .hero-title-impact span { 
    color: #4A90E2; 
  }

  .hero-subtitle {
    color: rgba(255,255,255,0.9);
    font-size: 1.25rem;
    margin-top: 15px;
    max-width: 550px;
    line-height: 1.4;
    font-weight: 400;
  }

  .express { 
    color: #fff; 
    font-weight: 700; 
  }

  /* Responsive Mobile */
  @media (max-width: 768px) {
    .pipod-hero-immersive { height: 70vh; }
    .pipod-hud-top { padding-left: 5%; padding-right: 5%; }
    .hero-title-impact { font-size: 2.8rem; }
    .hero-subtitle { font-size: 1.1rem; }
  }
</style>
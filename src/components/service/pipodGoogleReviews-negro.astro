---
// Props con los datos reales de Pipod
const { 
  score = "4.9", 
  totalReviews = "54", 
  link = "https://g.page/r/CRgj2kSrZTO4EBM/review" 
} = Astro.props;
---

<section class="google-reviews-section">
  <div class="google-container">
    <div class="google-header-bar">
      <div class="header-content-left">
        <div class="brand-container">
          <img 
            src="https://upload.wikimedia.org/wikipedia/commons/2/2f/Google_2015_logo.svg" 
            alt="Google" 
            class="google-logo"
          />
          <span class="brand-text">Reviews</span>
        </div>
        
        <div class="rating-container">
          <span class="big-score">{score}</span>
          <div class="stars-group">
            {[...Array(5)].map(() => (
              <i class="bi bi-star-fill"></i>
            ))}
          </div>
          <span class="reviews-count">({totalReviews} opiniones)</span>
        </div>
      </div>

      <a href={link} target="_blank" rel="noopener noreferrer" class="btn-google-pill">
        Déjanos tu reseña
      </a>
    </div>
  </div>
</section>

<style>
  /* MODO OSCURO UNIFICADO */
  .google-reviews-section {
    background-color: #000; /* Negro para integrarse con Stats */
    min-height: 119px; 
    width: 100%;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #1a1a1a; /* Borde sutil */
  }

  .google-container {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 5%;
  }

  @media (min-width: 1440px) {
    .google-container {
      padding: 0 80px; /* Consistencia de 80px con los otros banners */
    }
  }

  .google-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .header-content-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
  }

  .brand-container {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .google-logo {
    height: 22px;
    width: auto;
    /* Filtro opcional para que el logo resalte un poco más en negro si es necesario */
    filter: drop-shadow(0px 0px 1px rgba(255,255,255,0.1));
  }

  .brand-text {
    font-size: 20px;
    font-weight: 500;
    color: #ffffff; /* Texto Blanco */
    font-family: 'Product Sans', system-ui, sans-serif;
  }

  .rating-container {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .big-score {
    font-size: 1.2rem;
    font-weight: 700;
    color: #ffffff; /* Score Blanco */
  }

  .stars-group {
    display: flex;
    gap: 3px;
    color: #ffba00;
    font-size: 14px;
  }

  .reviews-count {
    color: rgba(255, 255, 255, 0.6); /* Gris claro plateado */
    font-size: 0.9rem;
  }

  .btn-google-pill {
    background-color: #1a73e8;
    color: white !important;
    padding: 12px 28px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s ease;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .btn-google-pill:hover {
    background-color: #1557b0;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(26, 115, 232, 0.3);
  }

  @media (max-width: 768px) {
    .google-reviews-section {
      height: auto;
      padding: 40px 0;
    }
    .google-header-bar {
      flex-direction: column;
      gap: 24px;
      text-align: center;
    }
    .header-content-left {
      align-items: center;
    }
  }
</style>
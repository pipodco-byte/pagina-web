<section class="stats-section">
  <div class="stats-container">
    <div class="stats-grid">
      
      <div class="stat-item">
        <div class="number-wrapper">
          <h2 class="stat-number" data-target="196">0</h2>
          <span class="stat-suffix">+</span>
        </div>
        <p class="stat-text">DISCOS/RAM MEJORADOS</p>
      </div>

      <div class="stat-item">
        <div class="number-wrapper">
          <h2 class="stat-number" data-target="174">0</h2>
          <span class="stat-suffix">+</span>
        </div>
        <p class="stat-text">BOARDS REPARADAS</p>
      </div>

      <div class="stat-item">
        <div class="number-wrapper">
          <h2 class="stat-number" data-target="162">0</h2>
          <span class="stat-suffix">+</span>
        </div>
        <p class="stat-text">MOJADOS RECUPERADOS</p>
      </div>

      <div class="stat-item">
        <div class="number-wrapper">
          <h2 class="stat-number" data-target="12.6">0</h2>
          <span class="stat-number-percent">%</span>
          <span class="stat-suffix">+</span>
        </div>
        <p class="stat-text">EQUIPOS SALVADOS</p>
      </div>

    </div>
  </div>
</section>

<script>
  const hardwareObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const target = entry.target as HTMLElement;
        const rawValue = target.getAttribute('data-target') || '0';
        const targetValue = parseFloat(rawValue);
        const isDecimal = rawValue.includes('.');
        
        let current = 0;
        const steps = 100;
        const increment = targetValue / steps;
        
        const updateCount = () => {
          if (current < targetValue) {
            current += increment;
            if (isDecimal) {
              target.innerText = current.toFixed(1);
            } else {
              target.innerText = Math.ceil(current).toString();
            }
            setTimeout(updateCount, 15);
          } else {
            target.innerText = isDecimal ? targetValue.toFixed(1) : targetValue.toString();
          }
        };
        updateCount();
        hardwareObserver.unobserve(target);
      }
    });
  }, { threshold: 0.5 });

  document.querySelectorAll('.stat-number').forEach(stat => hardwareObserver.observe(stat));
</script>


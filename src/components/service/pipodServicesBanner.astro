<section class="stats-section">
  <div class="stats-container">
    <div class="stats-grid">

      <div class="stat-item">
        <div class="icon-wrapper">
          <i class="bi bi-shield-check incentive-icon"></i>
        </div>
        <p class="stat-text">GARANTÍA EN REPUESTOS</p>
      </div>

      <div class="stat-item">
        <div class="icon-wrapper">
          <i class="bi bi-truck incentive-icon"></i>
        </div>
        <p class="stat-text">SERVICIO DE DOMICILIO</p>
      </div>

      <div class="stat-item">
        <div class="icon-wrapper">
          <i class="bi bi-lightning-charge incentive-icon"></i>
        </div>
        <p class="stat-text">REPARACIÓN EXPRESS</p>
      </div>

    </div>
  </div>
</section>

<script>
  const initIncentivesAnimation = () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          // Activamos la entrada fluida
          entry.target.classList.add('is-visible');
          // Una vez animado, dejamos de observar para ahorrar recursos
          observer.unobserve(entry.target);
        }
      });
    }, { 
      threshold: 0.2 // Se activa igual que el de estadísticas
    });

    document.querySelectorAll('.stat-item').forEach(item => observer.observe(item));
  };

  // Ejecución compatible con Astro y sus transiciones
  initIncentivesAnimation();
  document.addEventListener('astro:after-swap', initIncentivesAnimation);
</script>

<style>
  /* --- BASE UNIFICADA (Idéntica al otro componente) --- */
  .stats-section {
    background-color: #000;
    height: 119px;
    width: 100%;
    display: flex;
    align-items: center;
    border-top: 1px solid #1a1a1a;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }

  .stats-container {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 80px;
  }

  .stats-grid {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 20px;
  }

  /* --- ANIMACIÓN ESPEJO (Coherencia Total) --- */
  .stat-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 15px;
    
    /* Estado inicial idéntico: abajo y transparente */
    opacity: 0;
    transform: translateY(20px);
    transition: 
      opacity 0.8s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: opacity, transform;
  }

  .stat-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Delays Escalonados: Mismo ritmo que los contadores */
  .stat-item:nth-child(1) { transition-delay: 0.1s; }
  .stat-item:nth-child(2) { transition-delay: 0.2s; }
  .stat-item:nth-child(3) { transition-delay: 0.3s; }

  /* --- ESTILOS DE LOS ELEMENTOS --- */
  .incentive-icon {
    font-size: 2.1rem;
    color: #ffffff;
    line-height: 1;
    display: flex;
    align-items: center;
  }

  .stat-text {
    font-size: 0.75rem;
    font-weight: 400;
    color: #ffffff;
    margin: 0;
    letter-spacing: 1.5px; /* Unificado con el de números */
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* --- ALINEACIÓN --- */
  .stat-item:first-child { justify-content: flex-start; }
  .stat-item:last-child  { justify-content: flex-end; }

  /* --- RESPONSIVE UNIFICADO --- */
  @media (max-width: 991px) {
    .stats-section { height: auto; padding: 50px 0; }
    .stats-grid    { flex-direction: column; gap: 40px; }
    .stat-item     {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
    }
    .stat-item:first-child,
    .stat-item:last-child { justify-content: center; }
  }
</style>
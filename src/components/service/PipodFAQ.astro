---
/**
 * PipodFAQ Component
 * 2-column FAQ layout using native HTML accordion (no JS)
 * Visual style from ContactFAQ: white boxes, + icon, border-top answer
 */

interface FAQ {
  q: string;
  a: string;
}

interface Props {
  faqs: FAQ[];
}

const { faqs } = Astro.props;

const midPoint = Math.ceil(faqs.length / 2);
const leftFAQs = faqs.slice(0, midPoint);
const rightFAQs = faqs.slice(midPoint);
---

<section class="faq-section">
  <div class="container">
    
    <header class="faq-header">
      <h2>PREGUNTAS FRECUENTES</h2>
    </header>

    <div class="faq-grid">
      
      <div class="faq-column">
        {leftFAQs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-summary">
              <span class="question-text">{faq.q}</span>
              <span class="faq-icon">+</span>
            </summary>
            <div class="faq-content">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="faq-column">
        {rightFAQs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-summary">
              <span class="question-text">{faq.q}</span>
              <span class="faq-icon">+</span>
            </summary>
            <div class="faq-content">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .faq-section {
    background-color: #FFFFFF;
    padding: 50px 0;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 25px;
  }

  @media (min-width: 1024px) {
    .faq-section {
      padding: 80px 0;
    }

    .container {
      padding: 0 80px;
    }
  }

  .faq-header {
    margin-bottom: 40px;
  }

  .faq-header h2 {
    font-family: 'Inter', sans-serif;
    font-size: 2rem;
    font-weight: 800;
    color: #1d1d1f;
    margin: 0;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 1024px) {
    .faq-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 60px;
    }
  }

  .faq-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-item {
    background: #fff;
    padding: 24px;
    border-radius: 12px;
    border: 1px solid #E5E5E5;
    transition: all 0.3s ease;
  }

  .faq-item:hover {
    border-color: #999;
  }

  .faq-item[open] {
    border-color: #000;
  }

  .faq-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: 1rem;
    font-weight: 700;
    color: #000;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .question-text {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #000;
    line-height: 1.3;
  }

  .faq-icon {
    flex-shrink: 0;
    font-size: 1.2rem;
    font-weight: 300;
    color: #6e6e73;
    transition: transform 0.3s ease;
    line-height: 1;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-content {
    font-family: 'Noto Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.5;
    color: #666;
    padding-top: 16px;
    margin-top: 16px;
    border-top: 1px solid #F5F5F7;
  }

  .faq-content p {
    font-family: 'Noto Sans', sans-serif;
    margin: 0;
  }
</style>
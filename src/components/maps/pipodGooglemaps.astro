---
// LocationSection.astro - Estructura 3 Columnas PIPOD
interface Props {
  title?: string;
  address?: string;
  phone?: string;
  hours?: string;
  image?: string;
  lat?: number;
  lng?: number;
}

const {
  title = "PIPOD - Servicio Técnico Apple",
  address = "Cra. 13a #79-52, Bogotá, Colombia",
  phone = "+57 312 481 3094",
  hours = "Lun-Sab: 10:00 AM - 6:00 PM",
  image = "/images/fachada_pipod_panoramica.webp",
  lat = 4.6658,
  lng = -74.0578
} = Astro.props;

const services = [
  "Recuperación de Logic Board",
  "Micro-soldadura de precisión",
  "Cambio de pantalla Express",
  "Restauración de Apple Watch"
];
---

<section id="ubicacion" class="pipod-location-unified">
  <div class="container-pipod">
    <div class="header-wrapper">
      <h2 style="font-family: 'Inter', sans-serif; font-size: 2.8rem; font-weight: 800; margin: 0 0 40px; text-align: left;">UBICACIÓN PIPOD</h2>
    </div>
    
    <div class="pipod-grid">
      <div class="pipod-col-card">
      <div class="floating-wrapper">
        <div class="map-card-integrated">
          <div class="card-photo" style={`background-image: url(${image});`}>
          </div>

          <div class="card-dark-header">
            <div class="header-main">
              <h3>{title}</h3>
              <a href={`https://www.google.com/maps/search/?api=1&query=$${lat},${lng}`} target="_blank" class="map-link">
                CÓMO LLEGAR
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
              </a>
            </div>
            <div class="action-fab">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
          </div>

          <div class="card-details">
            <div class="detail-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span>{address}</span>
            </div>
            <div class="detail-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <span>{phone}</span>
            </div>
            <div class="detail-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span>{hours}</span>
            </div>
            
            <a href="https://wa.me/573124813094" target="_blank" class="wa-button-apple">
              <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.06 3.973L0 16l4.104-1.076a7.858 7.858 0 0 0 3.858.999h.001c4.367 0 7.926-3.559 7.93-7.93a7.897 7.897 0 0 0-2.322-5.668z"/></svg>
              <span>Contactar por WhatsApp</span>
            </a>
          </div>
          <div class="card-tail"></div>
        </div>
      </div>
    </div>

      <div class="pipod-col-map">
        <div class="map-container">
          <div class="map-bg-overlay"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pipod-location-unified {
    background: #FFFFFF;
    width: 100%;
    display: flex;
    font-family: 'Inter', sans-serif;
    border: none;
    padding: 50px 0;
  }

  .container-pipod {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 25px;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .pipod-location-unified {
      padding: 80px 0;
    }

    .container-pipod {
      padding: 0 80px;
    }
  }

  .header-wrapper {
    text-align: left;
    margin-bottom: 50px;
  }

  .section-heading {
    display: none;
  }

  .pipod-grid {
    display: grid;
    grid-template-columns: 30% 70%;
    gap: 0;
    width: 100%;
    height: auto;
    padding-bottom: 40px;
  }

  @media (max-width: 768px) {
    .pipod-grid {
      grid-template-columns: 1fr;
    }
  }

  /* CARD AREA (COL 2) */
  .pipod-col-card {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    padding: 0;
  }

  .floating-wrapper {
    position: relative;
    z-index: 5;
    filter: drop-shadow(0 20px 40px rgba(0,0,0,0.1));
    width: 100%;
  }

  .map-card-integrated {
    width: 100%;
    height: auto;
    background: #FFFFFF;
    border-radius: 0;
    overflow: hidden;
    position: relative;
    border: none;
  }

  .card-photo {
    height: 250px;
    background-size: cover;
    background-position: center;
    border-radius: 0;
    position: relative;
  }

  .close-x {
    display: none;
  }

  .card-dark-header {
    background: #1A1A1A;
    color: white;
    padding: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }

  .header-main h3 { margin: 0 0 4px 0; font-size: 1rem; font-weight: 700; letter-spacing: -0.2px; color: #FFFFFF !important; }

  .map-link {
    color: #FFFFFF !important;
    font-size: 11px;
    font-weight: 800;
    text-decoration: none;
    letter-spacing: 0.5px;
    display: flex; align-items: center; gap: 5px;
  }

  .action-fab {
    background: #FFFFFF;
    color: #000;
    width: 48px; height: 48px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    position: absolute;
    right: 24px; top: 50%;
    transform: translateY(-50%);
  }

  .card-details { padding: 32px 24px; display: flex; flex-direction: column; gap: 20px; }

  .detail-row {
    display: flex; gap: 14px; font-size: 0.9rem; color: #333; font-weight: 600; align-items: center;
  }

  .wa-button-apple {
    margin-top: 10px;
    background: #000;
    color: #FFF !important;
    padding: 16px;
    border-radius: 18px;
    display: flex; justify-content: center; align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
    transition: transform 0.2s;
  }

  .wa-button-apple:hover { transform: scale(1.02); }

  .card-tail {
    position: absolute;
    bottom: -10px; left: 50%;
    transform: translateX(-50%);
    width: 0; height: 0;
    border-left: 10px solid transparent;
    border-right: 10px solid transparent;
    border-top: 10px solid #000;
  }

  /* MAPA (COL 3) */
  .pipod-col-map {
    position: relative;
    overflow: hidden;
  }

  .map-container {
    width: 100%;
    height: 100%;
    background-image: url('/images/pipod-location.webp');
    background-size: cover;
    background-position: center; /* Recorte centrado automático */
  }

  .map-bg-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, transparent 0%, rgba(0,0,0,0.08) 100%);
  }

  @media (max-width: 1100px) {
    .pipod-col-map { display: none; }
  }

  @media (max-width: 768px) {
    .container-pipod {
      padding: 0 24px;
    }

    .card-tail {
      display: none;
    }
  }
</style>
---
// src/layouts/BlogPostLayout.astro
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import BlogPostingSchema from '../components/SEO/BlogPostingSchema.astro';
import '../styles/_pipod-utilities.css';
import '../styles/_tokens.css';

interface Props {
  title: string;
  description: string;
  author: string;
  publishDate: Date;
  tags: string[];
  category: string;
  canonical?: string;
  ogImage?: string;
  schemaType?: string;
  locale?: string;
}

const {
  title,
  description,
  author,
  publishDate,
  tags,
  category,
  canonical,
  ogImage,
  schemaType = 'BlogPosting',
  locale = 'es-ES',
} = Astro.props;

const siteUrl = 'https://www.pipod.co';
const articleUrl = canonical || `${siteUrl}/blog/${Astro.url.pathname.split('/').pop()}`;

// Format date for display
const formattedDate = new Intl.DateTimeFormat('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishDate);

const isoDate = publishDate.toISOString();
---

<Layout title={title} description={description}>
  <BlogPostingSchema
    title={title}
    description={description}
    author={author}
    datePublished={isoDate}
    url={articleUrl}
    image={ogImage}
  />
  
  <main style="padding-top: 120px;">
    <article class="blog-article">
      <div class="article-container">
        {/* Header del artículo */}
        <header class="article-header">
          <div class="article-meta">
            <span class="article-category">{category}</span>
            <span class="article-date">{formattedDate}</span>
          </div>
          <h1 class="article-title">{title}</h1>
          <p class="article-excerpt">{description}</p>
        </header>

        {/* Contenido del artículo */}
        <div class="article-content">
          <slot />
        </div>

        {/* Footer del artículo */}
        <footer class="article-footer">
          <div class="article-tags">
            {tags.map(tag => (
              <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="tag-link">
                #{tag}
              </a>
            ))}
          </div>
          <div class="article-author">
            <div class="author-info">
              <h4>{author}</h4>
              <p>Servicio técnico especializado en Apple desde 2009.</p>
            </div>
          </div>
        </footer>
      </div>
    </article>
  </main>
</Layout>

<style>
  .blog-article {
    background: var(--pipod-color-white, #FFFFFF);
    padding: 60px 0;
  }

  .article-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .article-header {
    margin-bottom: 60px;
    text-align: center;
  }

  .article-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .article-category {
    font-family: var(--pipod-font-pt-mono, 'PT Mono', monospace);
    font-size: var(--pipod-size-label, 12px);
    color: var(--pipod-color-deep-blue, #3A506B);
    font-weight: var(--pipod-weight-extrabold, 800);
    letter-spacing: var(--pipod-tracking-wider, 0.05em);
    text-transform: uppercase;
    padding: 4px 12px;
    border: 1px solid var(--pipod-color-deep-blue, #3A506B);
    border-radius: var(--pipod-radius-pill, 50px);
  }

  .article-date {
    font-family: var(--pipod-font-inter, 'Inter', sans-serif);
    font-size: 0.9rem;
    color: #666;
  }

  .article-title {
    font-family: var(--pipod-font-inter, 'Inter', sans-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--pipod-color-black, #000000);
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }

  .article-excerpt {
    font-family: var(--pipod-font-inter, 'Inter', sans-serif);
    font-size: 1.2rem;
    color: #555;
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto;
  }

  .article-content {
    font-family: var(--pipod-font-noto-sans, 'Noto Sans', sans-serif);
    line-height: 1.8;
    color: #333;
  }

  .article-content :global(h2) {
    font-family: var(--pipod-font-inter, 'Inter', sans-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: #000;
    margin-bottom: 24px;
    margin-top: 48px;
    letter-spacing: -0.01em;
  }

  .article-content :global(h3) {
    font-family: var(--pipod-font-inter, 'Inter', sans-serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: #000;
    margin-bottom: 16px;
    margin-top: 32px;
  }

  .article-content :global(p) {
    font-size: 1.05rem;
    margin-bottom: 16px;
    color: #444;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 24px 0;
    padding-left: 24px;
  }

  .article-content :global(li) {
    margin-bottom: 12px;
    font-size: 1.05rem;
    color: #444;
  }

  .article-content :global(strong) {
    color: #000;
    font-weight: 600;
  }

  .article-content :global(em) {
    font-style: italic;
    color: #555;
  }

  .article-content :global(blockquote) {
    border-left: 4px solid var(--pipod-color-deep-blue, #3A506B);
    padding-left: 24px;
    margin: 32px 0;
    font-style: italic;
    color: #555;
  }

  .article-content :global(code) {
    font-family: var(--pipod-font-mono, 'PT Mono', monospace);
    font-size: 0.9rem;
    background: #f5f5f5;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .article-content :global(pre) {
    background: #1f1f1f;
    color: #fff;
    padding: 24px;
    border-radius: 12px;
    overflow-x: auto;
    margin: 32px 0;
  }

  .article-content :global(pre code) {
    background: transparent;
    padding: 0;
    color: inherit;
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 32px 0;
  }

  .article-content :global(th),
  .article-content :global(td) {
    padding: 12px 16px;
    border: 1px solid #E5E5E7;
    text-align: left;
  }

  .article-content :global(th) {
    background: #f5f5f5;
    font-weight: 600;
  }

  .article-content :global(hr) {
    border: none;
    border-top: 1px solid #E5E5E7;
    margin: 48px 0;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 24px 0;
  }

  .article-footer {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid #E5E5E7;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 32px;
  }

  .tag-link {
    font-family: var(--pipod-font-pt-mono, 'PT Mono', monospace);
    font-size: var(--pipod-size-small, 0.85rem);
    color: var(--pipod-color-deep-blue, #3A506B);
    text-decoration: none;
    padding: 6px 14px;
    background: rgba(58, 80, 107, 0.08);
    border-radius: 50px;
    transition: all var(--pipod-transition-normal, 300ms ease);
  }

  .tag-link:hover {
    background: var(--pipod-color-deep-blue, #3A506B);
    color: var(--pipod-color-white, #FFFFFF);
  }

  .article-author {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .author-info h4 {
    font-family: var(--pipod-font-inter, 'Inter', sans-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: #000;
    margin: 0 0 8px 0;
  }

  .author-info p {
    font-size: 0.95rem;
    color: #666;
    margin: 0;
  }

  @media (max-width: 768px) {
    .blog-article {
      padding: 40px 0;
    }

    .article-container {
      padding: 0 16px;
    }

    .article-title {
      font-size: 1.8rem;
      margin-bottom: 16px;
    }

    .article-excerpt {
      font-size: 1rem;
    }

    .article-content :global(h2) {
      font-size: 1.5rem;
    }

    .article-content :global(h3) {
      font-size: 1.1rem;
    }

    .article-content :global(p),
    .article-content :global(li) {
      font-size: 0.95rem;
    }
  }
</style>
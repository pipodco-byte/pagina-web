---
// src/layouts/BlogPostLayout.astro
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import BlogPostingSchema from '../components/SEO/BlogPostingSchema.astro';
import Text from '../components/blog/Text.astro';
import SectionDivider from '../components/blog/SectionDivider.astro';
import BlogCardGrid from '../components/blog/BlogCardGrid.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import { getCollection } from 'astro:content';
import '../styles/_pipod-utilities.css';
import '../styles/_tokens.css';

interface Props {
  title: string;
  description: string;
  author: string;
  publishDate: Date;
  tags: string[];
  category: string;
  canonical?: string;
  ogImage?: string;
  schemaType?: string;
  locale?: string;
  readingTime?: string;
  headings?: { depth: number; text: string; slug: string }[];
}

const {
  title,
  description,
  author,
  publishDate,
  tags,
  category,
  canonical,
  ogImage,
  schemaType = 'BlogPosting',
  locale = 'es-ES',
  readingTime = '5 min de lectura',
  headings = [],
} = Astro.props;

const siteUrl = 'https://www.pipod.co';
const articleUrl = canonical || `${siteUrl}/blog/${Astro.url.pathname.split('/').pop()}`;

// Format date for display
const formattedDate = new Intl.DateTimeFormat('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishDate);

const isoDate = publishDate.toISOString();

// Format author name
const formattedAuthor = author
  .replace(/-/g, ' ')
  .split(' ')
  .map(word => word.charAt(0).toUpperCase() + word.slice(1))
  .join(' ');
const authorInitial = formattedAuthor.charAt(0).toUpperCase();
---

<Layout title={title} description={description}>
  <BlogPostingSchema
    title={title}
    description={description}
    author={author}
    datePublished={isoDate}
    url={articleUrl}
    image={ogImage}
  />

  <main class="blog-post-layout">
    <article class="blog-article">
      <div class="article-container">
        {/* Header del artículo - Flow: tags → divider → title → author → image */}
        <header class="article-header">
          {/* 1. Tags */}
          {tags.length > 0 && (
            <div class="article-tags">
              {tags.map(tag => (
                <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="article-tag">
                  {tag}
                </a>
              ))}
            </div>
          )}

          {/* 2. Section Divider */}
          <SectionDivider class="article-divider" />

          {/* 3. Title */}
          <Text variant="display-xl" as="h1" class="article-title">
            {title}
          </Text>

          {/* 4. Author Row */}
          <div class="article-author-row">
            <div class="article-author-avatar">{authorInitial}</div>
            <div class="article-author-info">
              <span class="article-author-name">{formattedAuthor}</span>
              <div class="article-author-meta">
                <time datetime={isoDate}>{formattedDate}</time>
                <span class="article-author-separator">·</span>
                <span class="article-reading-time">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  {readingTime}
                </span>
              </div>
            </div>
          </div>

          {/* 5. Featured Image */}
          {ogImage && (
            <div class="article-image-wrapper">
              <img src={ogImage} alt={title} class="article-image" />
            </div>
          )}
        </header>

        {/* Contenido del artículo */}
        <div class="article-content-wrapper">
          <TableOfContents headings={headings} />
          <div class="article-content">
            <slot />
          </div>
        </div>

        {/* Footer del artículo */}
        <footer class="article-footer">
          <div class="article-footer-tags">
            <Text variant="label" as="span">Etiquetas:</Text>
            <div class="article-footer-tag-list">
              {tags.map(tag => (
                <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="article-footer-tag">
                  #{tag}
                </a>
              ))}
            </div>
          </div>
          <div class="article-author-box">
            <div class="article-author-box-avatar">{authorInitial}</div>
            <div class="article-author-box-info">
              <Text variant="heading-3" as="h4">{formattedAuthor}</Text>
              <p>Servicio técnico especializado en Apple desde 2009. Expertos en reparación, mantenimiento y optimización de equipos Apple.</p>
            </div>
          </div>
        </footer>

        {/* Artículos que te pueden interesar */}
        {(() => {
          // Get all posts and filter by matching tags or category
          const allPosts = Astro.props as any;
          const currentSlug = Astro.url.pathname.split('/').pop();
          
          // Get all blog posts for related section
          return null; // We'll render this in the template below
        })()}
      </div>
    </article>

    {/* Related Posts Section */}
    {(async () => {
      const allPosts = await getCollection('blog');
      const currentSlug = Astro.url.pathname.split('/').pop();
      
      // Filter related posts: same category or shared tags
      const relatedPosts = allPosts
        .filter(post => {
          const postSlug = post.data.slug || post.id;
          if (postSlug === currentSlug) return false;
          
          // Match by tags (prioritize) or category
          const sharedTags = post.data.tags?.filter((tag: string) => tags.includes(tag));
          const sameCategory = post.data.category === category;
          
          return sharedTags?.length > 0 || sameCategory;
        })
        .slice(0, 3);
      
      if (relatedPosts.length === 0) return null;
      
      return (
        <section class="related-posts-section">
          <div class="related-posts-container">
            <Text variant="heading-2" as="h2" class="related-posts-title">
              Artículos que te pueden interesar
            </Text>
            <div class="related-posts-grid">
              {relatedPosts.map(post => (
                <BlogCardGrid post={{
                  id: post.id,
                  slug: post.data.slug,
                  title: post.data.title,
                  description: post.data.description,
                  category: post.data.category,
                  tags: post.data.tags,
                  ogImage: post.data.ogImage,
                  publishDate: post.data.publishDate.toISOString(),
                  author: post.data.author
                }} />
              ))}
            </div>
          </div>
        </section>
      );
    })()}
  </main>
</Layout>

<style>
  .blog-post-layout {
    background: var(--pipod-color-white, #FFFFFF);
    padding-top: 120px;
  }

  .article-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 60px 24px;
  }

  .article-header {
    margin-bottom: 60px;
    text-align: center;
  }

  /* Tags at top */
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .article-tag {
    font-family: var(--pipod-font-pt-mono, 'PT Mono', monospace);
    font-size: 11px;
    font-weight: 500;
    color: var(--pipod-color-deep-blue, #3A506B);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border: 1px solid var(--pipod-color-deep-blue, #3A506B);
    border-radius: 4px;
    transition: all 150ms ease;

    &:hover {
      background: var(--pipod-color-deep-blue, #3A506B);
      color: var(--pipod-color-white, #FFFFFF);
    }
  }

  /* Divider */
  .article-divider {
    margin: 24px 0;
  }

  /* Title */
  :global(.article-title) {
    margin-bottom: 24px !important;
  }

  /* Author Row */
  .article-author-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .article-author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--pipod-color-deep-blue, #3A506B);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--pipod-font-inter, 'Inter', sans-serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--pipod-color-white, #ffffff);
    flex-shrink: 0;
  }

  .article-author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .article-author-name {
    font-family: var(--pipod-font-inter, 'Inter', sans-serif);
    font-size: 15px;
    font-weight: 600;
    color: var(--pipod-color-near-black, #1F1F1F);
  }

  .article-author-meta {
    font-family: var(--pipod-font-pt-mono, 'PT Mono', monospace);
    font-size: 13px;
    color: var(--pipod-color-disabled, rgba(0, 0, 0, 0.24));
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .article-author-separator {
    color: var(--pipod-color-border-gray, #E5E5E7);
  }

  .article-reading-time {
    display: inline-flex;
    align-items: center;
    gap: 4px;

    svg {
      width: 14px;
      height: 14px;
    }
  }

  /* Featured Image */
  .article-image-wrapper {
    border-radius: 16px;
    overflow: hidden;
    margin-top: 32px;
  }

  .article-image {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Article Content */
  .article-content-wrapper {
    display: flow-root;
  }

  .article-content {
    font-family: var(--pipod-font-noto-sans, 'Noto Sans', sans-serif);
    line-height: 1.8;
    color: var(--pipod-color-near-black, #1F1F1F);
    float: right;
    width: calc(100% - 260px);
  }

  @media (max-width: 1200px) {
    .article-content {
      float: none;
      width: 100%;
    }
  }

  .article-content :global(h2) {
    font-family: var(--pipod-font-inter, 'Inter', sans-serif);
    font-size: clamp(1.5rem, 3vw, 1.75rem);
    font-weight: 600;
    color: var(--pipod-color-near-black, #1F1F1F);
    margin-bottom: 24px;
    margin-top: 48px;
    letter-spacing: -0.01em;
  }

  .article-content :global(h3) {
    font-family: var(--pipod-font-inter, 'Inter', sans-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--pipod-color-near-black, #1F1F1F);
    margin-bottom: 16px;
    margin-top: 32px;
  }

  .article-content :global(p) {
    font-size: 1.05rem;
    margin-bottom: 20px;
    color: var(--pipod-color-near-black, #1F1F1F);
    line-height: 1.8;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 24px 0;
    padding-left: 24px;
  }

  .article-content :global(li) {
    margin-bottom: 12px;
    font-size: 1.05rem;
    color: var(--pipod-color-near-black, #1F1F1F);
  }

  .article-content :global(strong) {
    color: var(--pipod-color-black, #000000);
    font-weight: 600;
  }

  .article-content :global(em) {
    font-style: italic;
    color: #555;
  }

  .article-content :global(blockquote) {
    border-left: 4px solid var(--pipod-color-deep-blue, #3A506B);
    padding-left: 24px;
    margin: 32px 0;
    font-style: italic;
    color: #555;
  }

  .article-content :global(code) {
    font-family: var(--pipod-font-pt-mono, 'PT Mono', monospace);
    font-size: 0.9rem;
    background: #f5f5f5;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .article-content :global(pre) {
    background: #1f1f1f;
    color: #fff;
    padding: 24px;
    border-radius: 12px;
    overflow-x: auto;
    margin: 32px 0;
  }

  .article-content :global(pre code) {
    background: transparent;
    padding: 0;
    color: inherit;
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 32px 0;
  }

  .article-content :global(th),
  .article-content :global(td) {
    padding: 12px 16px;
    border: 1px solid #E5E5E7;
    text-align: left;
  }

  .article-content :global(th) {
    background: #f5f5f5;
    font-weight: 600;
  }

  .article-content :global(hr) {
    border: none;
    border-top: 1px solid #E5E5E7;
    margin: 48px 0;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 24px 0;
  }

  /* Footer */
  .article-footer {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid #E5E5E7;
  }

  .article-footer-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .article-footer-tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .article-footer-tag {
    font-family: var(--pipod-font-pt-mono, 'PT Mono', monospace);
    font-size: var(--pipod-size-small, 0.85rem);
    color: var(--pipod-color-deep-blue, #3A506B);
    text-decoration: none;
    padding: 6px 14px;
    background: rgba(58, 80, 107, 0.08);
    border-radius: 50px;
    transition: all var(--pipod-transition-normal, 300ms ease);

    &:hover {
      background: var(--pipod-color-deep-blue, #3A506B);
      color: var(--pipod-color-white, #FFFFFF);
    }
  }

  .article-author-box {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px;
    background: var(--pipod-color-light-surface, #F5F5F7);
    border-radius: var(--pipod-radius-standard, 24px);
  }

  .article-author-box-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--pipod-color-deep-blue, #3A506B);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--pipod-font-inter, 'Inter', sans-serif);
    font-size: 24px;
    font-weight: 600;
    color: var(--pipod-color-white, #ffffff);
    flex-shrink: 0;
  }

  .article-author-box-info {
    h4 {
      margin: 0 0 8px 0;
    }

    p {
      font-family: var(--pipod-font-noto-sans, 'Noto Sans', sans-serif);
      font-size: 0.95rem;
      color: #666;
      margin: 0;
    }
  }

  /* Related Posts Section */
  .related-posts-section {
    background: var(--pipod-color-light-surface, #F5F5F7);
    padding: 60px 0;
    margin-top: 60px;
  }

  .related-posts-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .related-posts-title {
    margin-bottom: 32px;
    text-align: center;
  }

  .related-posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;

    @media (max-width: 1024px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (max-width: 640px) {
      grid-template-columns: 1fr;
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .article-container {
      padding: 40px 16px;
    }

    :global(.article-title) {
      font-size: 1.75rem !important;
    }

    .article-author-row {
      flex-direction: column;
      gap: 12px;
    }

    .article-author-info {
      text-align: center;
    }

    .article-author-box {
      flex-direction: column;
      text-align: center;
    }

    .article-content :global(h2) {
      font-size: 1.5rem;
    }

    .article-content :global(h3) {
      font-size: 1.1rem;
    }

    .article-content :global(p),
    .article-content :global(li) {
      font-size: 0.95rem;
    }

    .related-posts-section {
      padding: 40px 0;
    }

    .related-posts-grid {
      gap: 24px;
    }
  }
</style>

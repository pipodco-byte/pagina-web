{
  "rewrites": [
    {
      "source": "/contabilidad/:path*",
      "destination": "https://contabilidad-457z.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/contabilidad/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
